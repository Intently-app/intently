---
import '../styles/site.css';
import Mark from '../components/Mark.astro';
import { SITE, STUDIO } from '../lib/site';

interface Props {
	title: string;
	description: string;
	/** A title that is already complete: otherwise the page title gets the site name after it. */
	fullTitle?: boolean;
	noindex?: boolean;
	image?: string;
	article?: { published: Date; modified?: Date; tags: string[] };
	schema?: object[];
	/** The page has its own #waitlist form, so the header button stays on the page. */
	hasWaitlist?: boolean;
}

const { title, description, fullTitle = false, noindex = false, image = '/og/default.png', article, schema = [], hasWaitlist = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const shownTitle = fullTitle ? title : `${title} | ${SITE.name}`;
const imageUrl = new URL(image, SITE.url).href;
const year = new Date().getFullYear();

const organization = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	'@id': `${STUDIO.url}/#organization`,
	name: STUDIO.name,
	url: STUDIO.url,
	email: SITE.email,
	brand: { '@type': 'Brand', name: SITE.name },
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{shownTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="alternate" type="application/rss+xml" title="Hisab articles" href="/rss.xml" />
		<link rel="preload" href="/fonts/besley.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/hind-latin-400.woff2" as="font" type="font/woff2" crossorigin />
		<meta name="theme-color" media="(prefers-color-scheme: light)" content="#EAF2E7" />
		<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0E1A2A" />
		<meta property="og:type" content={article ? 'article' : 'website'} />
		<meta property="og:site_name" content={SITE.fullName} />
		<meta property="og:title" content={shownTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		{article && <meta property="article:published_time" content={article.published.toISOString()} />}
		{article && <meta property="article:modified_time" content={(article.modified ?? article.published).toISOString()} />}
		{article?.tags.map((tag) => <meta property="article:tag" content={tag} />)}
		{noindex && <meta name="robots" content="noindex" />}
		<script type="application/ld+json" set:html={JSON.stringify(organization)} />
		{schema.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>
		<header class="top">
			<div class="page top-bar">
				<a href="/" class="brand"><Mark size={30} /><span>Hisab</span></a>
				<nav aria-label="Main">
					<a class="nav-how" href="/#how">How it works</a>
					<a href="/articles/">Articles</a>
					<a class="btn btn-small" href={hasWaitlist ? '#waitlist' : '/#waitlist'}>Join the waitlist</a>
				</nav>
			</div>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer class="foot">
			<div class="page foot-grid">
				<p class="foot-word">
					Hisab means the reckoning of accounts: <span lang="bn">হিসাব</span> in Bangla, <span lang="hi">हिसाब</span> in Hindi, <span lang="ur" dir="rtl">حساب</span> in Urdu and Arabic.
				</p>
				<nav aria-label="Footer">
					<a href="/articles/">Articles</a>
					<a href="/support/">Support</a>
					<a href="/privacy/">Privacy policy</a>
					<a href="/terms/">Terms</a>
					<a href="/rss.xml">RSS</a>
				</nav>
				<p class="foot-small">
					Made by <a href={STUDIO.url}>{STUDIO.name}</a>. Hisab keeps records and isn’t financial advice. <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
				</p>
				<p class="foot-small">&copy; {year} {STUDIO.owner}</p>
			</div>
		</footer>
	</body>
</html>
