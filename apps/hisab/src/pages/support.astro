---
import Site from '../layouts/Site.astro';
import { SITE } from '../lib/site';
---

<Site title="Support" description="Get help with Hisab, or ask to be removed from the waitlist.">
	<div class="plain">
		<h1>Hisab support</h1>
		<p>Questions, bug reports or ideas? Email <a href={`mailto:${SITE.email}`}>{SITE.email}</a>. We usually reply within two days.</p>
		<p>To leave the waitlist, send us an email from that address. To delete your account, follow <a href="/delete-account/">these steps</a>.</p>
		<p>If something isn’t working, tell us your phone model and Android version, or your browser.</p>
		<p>How we handle your data is in the <a href="/privacy/">privacy policy</a>.</p>
	</div>
</Site>
