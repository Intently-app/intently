---
/**
 * The blog reading page.
 *
 * One reading column (about 68 characters of Source Serif), centred. On wide screens a contents
 * rail sits to its left: one line per section that fills as it is read, the minutes left, text
 * size and share. On narrower screens the same tools live in a bottom sheet, opened from a
 * pill that names the current section. The contents are built at build time from the post's
 * headings, so they work without JavaScript; scripts only add progress, the sheet, section
 * links, scrollable tables and the text size.
 */
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import BlogPostSchema from '../components/SEO/BlogPostSchema.astro';
import BreadcrumbSchema from '../components/SEO/BreadcrumbSchema.astro';
import FAQSchema from '../components/SEO/FAQSchema.astro';
import HowToSchema from '../components/SEO/HowToSchema.astro';
import Picture from '../components/ui/Picture.astro';
import QrCode from '../components/ui/QrCode.astro';
import InstallBar from '../components/InstallBar.astro';
import { Image } from 'astro:assets';

interface RelatedPost {
	id: string;
	title: string;
	description: string;
	pubDate: Date;
	heroImage?: string;
	readingTime: number;
	categoryLabel: string;
}

type Props = CollectionEntry<'blog'>['data'] & {
	wordCount?: number;
	readingTime?: number;
	categoryLabel?: string;
	categoryId?: string;
	headings?: MarkdownHeading[];
	relatedPosts?: RelatedPost[];
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	heroImageAlt,
	faq,
	howToSteps,
	answer,
	keyTakeaways,
	tags,
	author,
	wordCount = 0,
	readingTime = 1,
	categoryLabel = 'Insights',
	categoryId,
	headings = [],
	relatedPosts = [],
} = Astro.props;
const postUrl = new URL(Astro.url.pathname, Astro.site).href;

const effectiveTags = tags && tags.length > 0 ? tags : ['digital wellbeing', 'screen time', 'mindful tech'];
const effectiveAuthor = author || 'Respite Team';
const isTeam = effectiveAuthor === 'Respite Team';

// Contents: every h2, with its h3s under it (shown for the section being read). The FAQ is
// rendered by this layout, not the markdown, so it is added by hand.
interface Section {
	slug: string;
	text: string;
	children: { slug: string; text: string }[];
}
const sections: Section[] = [];
for (const h of headings) {
	if (h.depth === 2) sections.push({ slug: h.slug, text: h.text, children: [] });
	else if (h.depth === 3 && sections.length > 0) sections.at(-1)!.children.push({ slug: h.slug, text: h.text });
}
if (faq && faq.length > 0) sections.push({ slug: 'faq', text: 'Frequently asked questions', children: [] });
const hasContents = sections.length >= 2;
const shownDate = updatedDate ?? pubDate;
---

<html lang="en">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={heroImage}
			pubDate={pubDate}
			modifiedDate={updatedDate}
			author={effectiveAuthor}
			section="Digital Wellbeing"
			tags={effectiveTags}
			readingTime={readingTime}
			ogType="article"
		/>
		<BlogPostSchema
			title={title}
			description={description}
			publishedAt={pubDate}
			modifiedAt={updatedDate}
			image={heroImage}
			url={postUrl}
			section="Digital Wellbeing"
			tags={effectiveTags}
			wordCount={wordCount}
		/>
		<BreadcrumbSchema
			items={[
				{ name: 'Home', url: 'https://respite.liveintently.app/' },
				{ name: 'Blog', url: 'https://respite.liveintently.app/blog/' },
				{ name: title, url: postUrl },
			]}
		/>

		{faq && <FAQSchema faqs={faq} />}
		{howToSteps && <HowToSchema name={title} description={description} image={heroImage} steps={howToSteps} />}

		<!-- The reader's text size, applied before first paint so the page doesn't jump. -->
		<script is:inline>
			try {
				var s = localStorage.getItem('respite-read-size');
				if (s === 's' || s === 'l') document.documentElement.dataset.readSize = s;
			} catch (e) {}
		</script>

		<!-- Reading face, blog pages only -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,300..900;1,8..60,300..900&display=swap" rel="stylesheet" />
	</head>

	<body class="reading-page">
		<Header />
		<div class="reading-progress" aria-hidden="true"><div class="reading-progress-bar" id="reading-progress-bar"></div></div>

		<main class="post" data-minutes={readingTime}>
			<header class="post-head">
				<nav class="crumbs" aria-label="Breadcrumb">
					<a href="/blog/">Blog</a>
					<span aria-hidden="true">/</span>
					<a href={categoryId ? `/blog/#${categoryId}` : '/blog/'}>{categoryLabel}</a>
				</nav>
				<h1>{title}</h1>
				<p class="post-dek">{description}</p>
				<div class="post-meta">
					<span>By {isTeam ? 'the Respite team' : effectiveAuthor}</span>
					<span>{updatedDate ? 'Updated ' : ''}<FormattedDate date={shownDate} /></span>
					<span>{readingTime} min read</span>
					<button type="button" class="share-button" data-share>
						<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M10 14a5 5 0 0 0 7.07 0l3-3a5 5 0 0 0-7.07-7.07l-1 1M14 10a5 5 0 0 0-7.07 0l-3 3a5 5 0 0 0 7.07 7.07l1-1"/></svg>
						<span data-share-label>Copy link</span>
					</button>
				</div>
				{heroImage && (
					<div class="post-hero">
						<Image width={1020} height={574} src={heroImage} alt={heroImageAlt || ''} fetchpriority="high" />
					</div>
				)}
			</header>

			{hasContents && (
				<aside class="rail" aria-label="Reading tools">
					<nav class="contents" aria-labelledby="contents-title">
						<h2 class="rail-title" id="contents-title">Contents</h2>
						<ol class="contents-list">
							{sections.map((s) => (
								<li data-section={s.slug}>
									<a href={`#${s.slug}`}><span class="contents-fill" aria-hidden="true"></span>{s.text}</a>
									{s.children.length > 0 && (
										<ol class="contents-sub">
											{s.children.map((c) => <li><a href={`#${c.slug}`}>{c.text}</a></li>)}
										</ol>
									)}
								</li>
							))}
						</ol>
						<p class="time-left" data-time-left aria-live="off">{readingTime} min read</p>
					</nav>
					<div class="rail-tools">
						<div class="size-picker" role="group" aria-label="Text size">
							<span class="tool-label">Text size</span>
							<button type="button" data-size="s" aria-label="Smaller text" aria-pressed="false"><span class="a a-s">A</span></button>
							<button type="button" data-size="m" aria-label="Default text size" aria-pressed="true"><span class="a a-m">A</span></button>
							<button type="button" data-size="l" aria-label="Larger text" aria-pressed="false"><span class="a a-l">A</span></button>
						</div>
						<a href="#top" class="to-top" data-to-top>Back to top</a>
					</div>
					<div class="rail-cta" data-placement="rail_cta">
						<p>A short pause before the apps you pick. Free, no ads.</p>
						<a href="/download/" class="rail-cta-button" data-cta="download">Get Respite free</a>
						<div class="rail-qr">
							<QrCode text="https://respite.liveintently.app/get?c=blog" size={112} label="QR code to get Respite on your phone" />
							<p>Scan to get it on your phone<span>Android or iPhone</span></p>
						</div>
					</div>
				</aside>
			)}

			<article class="post-body">
				{answer && (
					<section class="short-answer" aria-labelledby="short-answer-title">
						<h2 id="short-answer-title">The short answer</h2>
						<p>{answer}</p>
						{keyTakeaways && keyTakeaways.length > 0 && (
							<ul>
								{keyTakeaways.map((t) => <li>{t}</li>)}
							</ul>
						)}
					</section>
				)}

				<div class="article-body">
					<slot />
					<aside class="inline-cta" id="inline-cta" data-placement="inline_cta" aria-label="Try Respite">
						<p class="inline-cta-title">Want the pause without the willpower?</p>
						<p>Respite puts a gentle, few-second pause before the apps you pick, so you open them on purpose. Free on iPhone, Android and Chrome.</p>
						<p class="inline-cta-actions">
							<a href="/download/" class="inline-cta-button" data-cta="article_cta">Get Respite free</a>
							<a href="/quiz/" class="inline-cta-link" data-cta="quiz">Or take the 2-minute phone habit quiz</a>
						</p>
					</aside>
				</div>

				{faq && faq.length > 0 && (
					<section class="post-faq" aria-labelledby="faq">
						<h2 id="faq">Frequently asked questions</h2>
						{faq.map((item) => (
							<details>
								<summary><h3>{item.question}</h3></summary>
								<p>{item.answer}</p>
							</details>
						))}
					</section>
				)}

				<footer class="byline">
					<img src="/logo.svg" alt="" width="40" height="40" loading="lazy" />
					<p>
						{isTeam ? (
							<>Written by the Respite team. We make Respite, a free app that puts a short pause before the apps you pick, so you open them on purpose. <a href="/about/">About Respite</a></>
						) : (
							<>Written by {effectiveAuthor} for the Respite blog. <a href="/about/">About Respite</a></>
						)}
					</p>
				</footer>
			</article>

			{relatedPosts.length > 0 && (
				<section class="keep-reading" aria-labelledby="keep-reading-title">
					<h2 id="keep-reading-title">Keep reading</h2>
					<ul>
						{relatedPosts.map((related) => (
							<li>
								<a href={`/blog/${related.id}/`}>
									<Picture src={related.heroImage || '/images/blog/what-is-digital-wellbeing.jpg'} alt="" width={640} height={360} loading="lazy" />
									<span class="kr-meta">{related.categoryLabel}, {related.readingTime} min read</span>
									<span class="kr-title">{related.title}</span>
									<span class="kr-desc">{related.description}</span>
								</a>
							</li>
						))}
					</ul>
				</section>
			)}
		</main>

		{hasContents && (
			<>
				<button type="button" class="section-pill" id="section-pill" aria-haspopup="dialog" aria-controls="contents-sheet" hidden>
					<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M4 6h16M4 12h10M4 18h13"/></svg>
					<span class="pill-section" data-pill-section>Contents</span>
					<span class="pill-time" data-time-left>{readingTime} min</span>
				</button>
				<dialog class="sheet" id="contents-sheet" aria-labelledby="sheet-title">
					<div class="sheet-head">
						<h2 id="sheet-title">Contents</h2>
						<button type="button" class="sheet-close" data-close-sheet>Close</button>
					</div>
					<ol class="sheet-list">
						{sections.map((s) => (
							<li data-section={s.slug}><a href={`#${s.slug}`}>{s.text}</a></li>
						))}
					</ol>
					<div class="sheet-tools">
						<div class="size-picker" role="group" aria-label="Text size">
							<span class="tool-label">Text size</span>
							<button type="button" data-size="s" aria-label="Smaller text" aria-pressed="false"><span class="a a-s">A</span></button>
							<button type="button" data-size="m" aria-label="Default text size" aria-pressed="true"><span class="a a-m">A</span></button>
							<button type="button" data-size="l" aria-label="Larger text" aria-pressed="false"><span class="a a-l">A</span></button>
						</div>
						<button type="button" class="share-button" data-share>
							<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M10 14a5 5 0 0 0 7.07 0l3-3a5 5 0 0 0-7.07-7.07l-1 1M14 10a5 5 0 0 0-7.07 0l-3 3a5 5 0 0 0 7.07 7.07l1-1"/></svg>
							<span data-share-label>Copy link</span>
						</button>
					</div>
				</dialog>
			</>
		)}
		<p class="visually-hidden" id="share-status" role="status" aria-live="polite"></p>

		<InstallBar />

		<Footer />

		<script>
			import { page, shareParams, track } from '../lib/analytics';

			const body = document.querySelector<HTMLElement>('.article-body');
			const post = document.querySelector<HTMLElement>('.post');
			const minutes = Number(post?.dataset.minutes) || 1;
			const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			// The call to action renders after the post; move it before the third section, where readers
			// getting value from the post still are (before the last one in short posts).
			{
				const cta = document.getElementById('inline-cta');
				const h2s = [...document.querySelectorAll('.article-body > h2')];
				const anchor = h2s.length >= 4 ? h2s[2] : h2s.length >= 2 ? h2s.at(-1) : null;
				if (cta && anchor) anchor.before(cta);
			}

			// Wide tables scroll sideways inside their own box, which is focusable for keyboard scrolling.
			body?.querySelectorAll('table').forEach((table) => {
				const wrap = document.createElement('div');
				wrap.className = 'table-scroll';
				wrap.tabIndex = 0;
				wrap.setAttribute('role', 'region');
				wrap.setAttribute('aria-label', 'Table');
				table.before(wrap);
				wrap.append(table);
				const mark = () => wrap.classList.toggle('is-scrollable', wrap.scrollWidth > wrap.clientWidth + 2);
				mark();
				// The box and the table resize separately (web fonts load late, the viewport turns).
				const ro = new ResizeObserver(mark);
				ro.observe(wrap);
				ro.observe(table);
			});

			// A link on every section heading, so a reader can share the exact part they mean.
			const status = document.getElementById('share-status');
			async function copy(url: string) {
				try {
					await navigator.clipboard.writeText(url);
					return true;
				} catch {
					return false;
				}
			}
			body?.querySelectorAll<HTMLElement>('h2[id], h3[id]').forEach((h) => {
				const a = document.createElement('a');
				a.className = 'heading-link';
				a.href = `#${h.id}`;
				a.setAttribute('aria-label', `Copy link to “${h.textContent?.trim()}”`);
				a.textContent = '#';
				a.addEventListener('click', async (e) => {
					e.preventDefault();
					const url = `${location.origin}${location.pathname}#${h.id}`;
					history.replaceState(null, '', `#${h.id}`);
					if (await copy(url) && status) status.textContent = 'Link to this section copied';
					a.classList.add('copied');
					setTimeout(() => a.classList.remove('copied'), 1600);
				});
				h.append(a);
			});

			// Share: the system share sheet where there is one (phones), otherwise copy the link.
			document.querySelectorAll<HTMLButtonElement>('[data-share]').forEach((button) => {
				const label = button.querySelector('[data-share-label]');
				const canShare = typeof navigator.share === 'function' && window.matchMedia('(pointer: coarse)').matches;
				if (canShare && label) label.textContent = 'Share';
				button.addEventListener('click', async () => {
					const url = location.href.split('#')[0];
					if (canShare) {
						try {
							await navigator.share({ title: document.title, url });
							track('share', shareParams('native_share', 'article', page()));
						} catch { /* dismissed */ }
						return;
					}
					if (await copy(url) && label) {
						track('share', shareParams('copy_link', 'article', page()));
						label.textContent = 'Link copied';
						if (status) status.textContent = 'Link copied';
						setTimeout(() => (label.textContent = 'Copy link'), 1800);
					}
				});
			});

			// Text size, remembered on this device.
			const sizeButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-size]')];
			function applySize(size: string) {
				if (size === 'm') delete document.documentElement.dataset.readSize;
				else document.documentElement.dataset.readSize = size;
				sizeButtons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.size === size)));
			}
			applySize(document.documentElement.dataset.readSize ?? 'm');
			sizeButtons.forEach((b) =>
				b.addEventListener('click', () => {
					const size = b.dataset.size ?? 'm';
					// Keep the line being read in place while the text reflows.
					const anchor = activeHeading();
					const before = anchor?.getBoundingClientRect().top ?? 0;
					applySize(size);
					try {
						if (size === 'm') localStorage.removeItem('respite-read-size');
						else localStorage.setItem('respite-read-size', size);
					} catch { /* private mode */ }
					if (anchor) window.scrollBy(0, anchor.getBoundingClientRect().top - before);
				}),
			);

			// Back to top.
			document.querySelectorAll('[data-to-top]').forEach((a) =>
				a.addEventListener('click', (e) => {
					e.preventDefault();
					window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
					history.replaceState(null, '', location.pathname);
				}),
			);

			// Sections: progress per section, minutes left, the current one in the rail and the pill.
			const sectionIds = [...document.querySelectorAll<HTMLElement>('.contents-list > li')].map((li) => li.dataset.section ?? '');
			const sectionHeads = sectionIds.map((id) => document.getElementById(id)).filter((h): h is HTMLElement => !!h);
			const railItems = new Map([...document.querySelectorAll<HTMLElement>('.contents-list > li')].map((li) => [li.dataset.section, li]));
			const sheetItems = new Map([...document.querySelectorAll<HTMLElement>('.sheet-list > li')].map((li) => [li.dataset.section, li]));
			const timeLeft = [...document.querySelectorAll<HTMLElement>('[data-time-left]')];
			const pill = document.getElementById('section-pill');
			const pillSection = document.querySelector<HTMLElement>('[data-pill-section]');
			const progressBar = document.getElementById('reading-progress-bar');
			const end = document.querySelector<HTMLElement>('.byline');
			const LINE = () => window.innerHeight * 0.3;

			function activeHeading() {
				let current: HTMLElement | undefined;
				for (const h of sectionHeads) if (h.getBoundingClientRect().top - LINE() <= 0) current = h;
				return current;
			}

			// Long contents lists scroll on their own; keep the current section in view without moving the page.
			const railList = document.querySelector<HTMLElement>('.contents-list');
			function keepInView(li: HTMLElement) {
				if (!railList || railList.scrollHeight <= railList.clientHeight) return;
				requestAnimationFrame(() => {
					const top = li.offsetTop - railList.offsetTop;
					const target = top - railList.clientHeight / 3;
					railList.scrollTo({ top: Math.max(0, target), behavior: reduceMotion ? 'auto' : 'smooth' });
				});
			}

			// How far this reader got, kept on this device only, so /blog/ can offer "Continue reading"
			// and mark finished posts. Furthest point wins; at most 200 posts are kept.
			const READ_KEY = 'respite-reading';
			const slug = location.pathname.replace(/^\/blog\/|\/$/g, '');
			let lastSaved = -1;
			let saveTimer: number | undefined;
			function remember(done: number) {
				if (done < 0.03 || Math.abs(done - lastSaved) < 0.02) return;
				clearTimeout(saveTimer);
				saveTimer = window.setTimeout(() => {
					try {
						const all = JSON.parse(localStorage.getItem(READ_KEY) || '{}');
						const prev = all[slug]?.p ?? 0;
						all[slug] = { p: Math.max(prev, Math.round(done * 100) / 100), at: Date.now() };
						const keep = Object.entries(all).sort((a: any, b: any) => b[1].at - a[1].at).slice(0, 200);
						localStorage.setItem(READ_KEY, JSON.stringify(Object.fromEntries(keep)));
						lastSaved = done;
					} catch { /* storage blocked */ }
				}, 800);
			}

			function update() {
				const line = LINE();
				const startY = (body?.getBoundingClientRect().top ?? 0) + scrollY;
				const endY = (end?.getBoundingClientRect().top ?? document.body.scrollHeight) + scrollY;
				const done = Math.min(1, Math.max(0, (scrollY + line - startY) / Math.max(1, endY - startY)));
				if (progressBar) progressBar.style.transform = `scaleX(${done})`;
				remember(done);

				const left = Math.ceil(minutes * (1 - done));
				const text = done <= 0.02 ? `${minutes} min read` : left <= 0 ? 'Finished' : left === 1 ? 'About 1 min left' : `${left} min left`;
				timeLeft.forEach((el) => (el.textContent = el.classList.contains('pill-time') ? text.replace(' read', '').replace('About ', '') : text));

				const current = activeHeading();
				sectionHeads.forEach((h, i) => {
					const top = h.getBoundingClientRect().top + scrollY;
					const next = sectionHeads[i + 1];
					const bottom = next ? next.getBoundingClientRect().top + scrollY : endY;
					const p = Math.min(1, Math.max(0, (scrollY + line - top) / Math.max(1, bottom - top)));
					const li = railItems.get(h.id);
					li?.style.setProperty('--p', p.toFixed(3));
					const isCurrent = h === current;
					if (isCurrent && li && !li.classList.contains('is-current')) keepInView(li);
					li?.classList.toggle('is-current', isCurrent);
					li?.querySelector(':scope > a')?.toggleAttribute('aria-current', isCurrent);
					const si = sheetItems.get(h.id);
					si?.classList.toggle('is-current', isCurrent);
					si?.classList.toggle('is-read', p >= 1);
				});

				if (pill && pillSection) {
					pillSection.textContent = current?.textContent?.replace(/#$/, '').trim() || 'Contents';
					const endTop = end?.getBoundingClientRect().top ?? Infinity;
					const show = !!current && endTop > window.innerHeight * 0.6;
					pill.hidden = false;
					pill.classList.toggle('is-shown', show);
					pill.inert = !show;
				}
			}

			let ticking = false;
			const onScroll = () => {
				if (ticking) return;
				ticking = true;
				requestAnimationFrame(() => {
					update();
					ticking = false;
				});
			};
			addEventListener('scroll', onScroll, { passive: true });
			addEventListener('resize', onScroll);

			// /blog/<slug>/#continue (from "Continue reading" on /blog/) returns to the furthest point read.
			if (location.hash === '#continue') {
				try {
					const p = JSON.parse(localStorage.getItem(READ_KEY) || '{}')[slug]?.p ?? 0;
					const startY = (body?.getBoundingClientRect().top ?? 0) + scrollY;
					const endY = (end?.getBoundingClientRect().top ?? 0) + scrollY;
					if (p > 0 && endY > startY) window.scrollTo(0, startY + p * (endY - startY) - LINE());
				} catch { /* storage blocked */ }
				history.replaceState(null, '', location.pathname);
			}
			update();

			// The contents sheet (phones and tablets).
			const sheet = document.getElementById('contents-sheet') as HTMLDialogElement | null;
			pill?.addEventListener('click', () => {
				sheet?.showModal();
				sheet?.querySelector<HTMLElement>('.is-current a, .sheet-list a')?.focus();
			});
			sheet?.querySelector('[data-close-sheet]')?.addEventListener('click', () => sheet.close());
			sheet?.addEventListener('click', (e) => {
				if (e.target === sheet) sheet.close(); // the backdrop
			});
			sheet?.querySelectorAll<HTMLAnchorElement>('.sheet-list a').forEach((a) =>
				a.addEventListener('click', (e) => {
					e.preventDefault();
					sheet.close();
					const id = a.hash.slice(1);
					document.getElementById(id)?.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
					history.replaceState(null, '', `#${id}`);
				}),
			);
		</script>
	</body>
</html>

<style>
	/* ------------------------------------------------------------ page and grid */
	/* The site sets overflow-x: hidden on html and body, which makes body a scroll container and
	   stops the rail from sticking. clip hides sideways overflow the same way without that. */
	:global(html:has(> body.reading-page)),
	.reading-page {
		overflow-x: clip;
	}

	.reading-page {
		background: var(--ds-bg-primary);
		--read-size: 1.125rem;
		--measure: 40rem;
		--rail: 14rem;
		--gap: 3.5rem;
		--breakout: 0px;
