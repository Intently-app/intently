		--measure: 44rem;
	}

	@media (prefers-color-scheme: dark) {
		.reading-page {
			/* Slightly softer than the UI white: long text in pure white on dark glares. */
			--ink: color-mix(in srgb, var(--ds-text-primary) 90%, var(--ds-bg-primary));
		}
	}

	.post,
	.post :global(*),
	.section-pill,
	.sheet {
		box-sizing: border-box;
	}

	.post {
		display: grid;
		grid-template-columns: minmax(0, var(--measure));
		justify-content: center;
		padding: 8.5rem 1.25rem 5rem;
		row-gap: 2.5rem;
	}

	/* Posts without contents (one section or none) keep the single centred column. */
	@media (min-width: 1000px) {
		.post:has(> .rail) {
			grid-template-columns: var(--rail) minmax(0, var(--measure));
			column-gap: var(--gap);
		}
		.post:has(> .rail) > :is(.post-head, .post-body, .keep-reading) {
			grid-column: 2;
		}
		.rail {
			grid-column: 1;
			grid-row: 2 / span 2;
		}
	}

	@media (min-width: 1280px) {
		.post:has(> .rail) {
			/* An empty right column of the rail's width keeps the text centred and gives tables room. */
			grid-template-columns: var(--rail) minmax(0, var(--measure)) var(--rail);
