---
/**
 * Site footer, in the Mist look: a soft ground, no rules or outlines, sentence-case headings.
 * Brand and the three stores first, then four short link groups, then the legal links grouped by
 * kind. It carries its own colour roles because it also sits on pages without .m-page.
 * Blog topic links use the hashes /blog/ reads (src/data/blogMeta.ts).
 */
import { SUPPORT_EMAIL } from '../consts';
import { app } from '@intently/registry';
import Icon from './ui/Icon.astro';

const r = app('respite');
const year = new Date().getFullYear();

const stores = [
	{ label: 'iPhone', href: r.stores.appStore!, path: 'M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z' },
	{ label: 'Android', href: r.stores.play!, path: 'M3,20.5V3.5C3,2.91 3.34,2.39 3.84,2.15L13.69,12L3.84,21.85C3.34,21.6 3,21.09 3,20.5M16.81,15.12L6.05,21.34L14.54,12.85L16.81,15.12M20.16,10.81C20.5,11.08 20.75,11.5 20.75,12C20.75,12.5 20.53,12.92 20.16,13.19L17.89,14.5L15.39,12L17.89,9.5L20.16,10.81M6.05,2.66L16.81,8.88L14.54,11.15L6.05,2.66Z' },
	{ label: 'Chrome', href: r.stores.chrome!, path: '' },
];

const groups = [
	{
		title: 'Product',
		links: [
			{ href: '/features/', label: 'Features' },
			{ href: '/ai/', label: 'Bring your own AI' },
			{ href: '/download/', label: 'Download' },
			{ href: '/whats-new/', label: "What's new" },
		],
	},
	{
		title: 'Free tools',
		links: [
			{ href: '/quiz/', label: 'Phone addiction quiz' },
			{ href: '/screen-time-calculator/', label: 'Screen time calculator' },
			{ href: '/app-addiction-score/', label: 'App addiction score' },
			{ href: '/compare/', label: 'Compare apps' },
		],
	},
	{
		title: 'Learn',
		links: [
			{ href: '/blog/', label: 'Blog' },
			{ href: '/blog/#getting-started', label: 'Getting started' },
			{ href: '/blog/#respite', label: 'Using Respite' },
			{ href: '/blog/#comparisons', label: 'App comparisons' },
		],
	},
	{
		title: 'Help',
		links: [
			{ href: '/support/', label: 'Support' },
			{ href: '/contact/', label: 'Contact' },
			{ href: `mailto:${SUPPORT_EMAIL}`, label: 'Email us' },
			{ href: '/about/', label: 'About' },
			{ href: '/delete-account/', label: 'Delete your account' },
		],
	},
];
---

<footer class="sf">
	<div class="sf-inner">
		<div class="sf-top">
			<div class="sf-brand">
				<a href="/" class="sf-logo">
					<img src="/logo.svg" alt="" width="40" height="40" />
					<span>Respite</span>
				</a>
				<p>A gentle pause before the apps you pick. Free, no ads, no account needed.</p>
				<ul class="sf-stores" aria-label="Get Respite for" data-placement="footer">
					{stores.map((s) => (
						<li>
							<a href={s.href} target="_blank" rel="noopener noreferrer">
								{s.path ? (
									<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d={s.path} /></svg>
								) : (
									<span class="sf-icon" aria-hidden="true"><Icon name="Chromium" size={18} /></span>
								)}
								{s.label}
							</a>
						</li>
					))}
				</ul>
			</div>

			<nav class="sf-groups" aria-label="Footer">
				{groups.map((g) => (
					<div class="sf-group">
						<h2>{g.title}</h2>
						<ul>
							{g.links.map((l) => (
								<li><a href={l.href}>{l.label}</a></li>
							))}
						</ul>
					</div>
				))}
			</nav>
		</div>

		<div class="sf-legal">
			<div class="sf-legal-links">
				<p><span>Privacy</span> <a href="/privacy/">iPhone</a> <a href="/privacy/android/">Android</a> <a href="/privacy/chrome/">Chrome</a> <a href="/privacy/website/">This website</a></p>
				<p><span>Terms</span> <a href="/terms/">iPhone</a> <a href="/terms/android/">Android</a></p>
			</div>
			<p class="sf-copy">&copy; {year} <a href="https://liveintently.app">Intently</a>, the studio behind Respite. <a href="https://liveintently.app">More apps</a></p>
		</div>
	</div>
</footer>

<style>
	.sf {
		--sf-ground: #e8eff4;
		--sf-paper: #ffffff;
		--sf-ink: var(--ds-text-primary);
		--sf-ink-soft: var(--ds-text-secondary);
		--sf-accent: var(--ds-primary);
		--sf-accent-soft: #dbe9f0;
		--sf-shadow: 0 1px 2px rgba(19, 34, 45, 0.06), 0 6px 18px rgba(19, 34, 45, 0.06);
		padding: 4rem 1.25rem 2rem;
		background: var(--sf-ground);
		color: var(--sf-ink);
	}

	@media (prefers-color-scheme: dark) {
		.sf {
			--sf-ground: #0b151c;
			--sf-paper: #172a35;
			--sf-accent: #8cc3db;
			--sf-accent-soft: #1d3a4a;
			--sf-shadow: 0 1px 2px rgba(0, 0, 0, 0.35);
		}
	}

	.sf *,
	.sf *::before,
	.sf *::after {
		box-sizing: border-box;
	}

	.sf-inner {
		display: grid;
		gap: 3rem;
		max-width: 68rem;
		margin: 0 auto;
	}

	.sf-top {
		display: grid;
		gap: 2.5rem;
	}

	@media (min-width: 960px) {
		.sf-top {
			grid-template-columns: minmax(21rem, 1fr) auto;
			gap: 3rem;
		}
	}

	/* ------------------------------------------------------------ brand */
	.sf-brand {
		display: grid;
		align-content: start;
		gap: 1rem;
	}

	.sf-logo {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		justify-self: start;
		color: var(--sf-ink);
		font-family: var(--font-heading);
		font-size: 1.4rem;
		font-weight: 800;
		text-decoration: none;
	}

	.sf-logo img {
		display: block;
		width: 40px;
		height: 40px;
		border-radius: 12px;
	}

	.sf-brand > p {
		margin: 0;
		max-width: 22rem;
		color: var(--sf-ink-soft);
		line-height: 1.55;
	}

	.sf-stores {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 0.25rem 0 0;
		padding: 0;
		list-style: none;
	}

	.sf-stores a {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		min-height: 40px;
		padding: 0 0.85rem;
		border-radius: 999px;
		background: var(--sf-paper);
		box-shadow: var(--sf-shadow);
		color: var(--sf-ink);
		font-family: var(--font-heading);
		font-size: 0.92rem;
		font-weight: 800;
		text-decoration: none;
		transition: background-color 0.15s ease;
	}

	.sf-icon {
		display: inline-grid;
	}

	.sf-stores a:hover {
		background: var(--sf-accent-soft);
	}

	/* ------------------------------------------------------------ link groups */
	.sf-groups {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 2rem 1.5rem;
	}

	@media (min-width: 720px) {
		.sf-groups {
			grid-template-columns: repeat(4, auto);
			justify-content: space-between;
			column-gap: 1.75rem;
		}
	}

	.sf-group h2 {
		margin: 0 0 0.75rem;
		font-family: var(--font-heading);
		font-size: 1rem;
		font-weight: 800;
		color: var(--sf-ink);
	}

	.sf-group ul {
		display: grid;
		gap: 0.15rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.sf-group a,
	.sf-legal a {
		color: var(--sf-ink-soft);
		text-decoration: none;
		transition: color 0.15s ease;
	}

	@media (min-width: 720px) {
		.sf-group a {
			white-space: nowrap;
		}
	}

	.sf-group a {
		display: inline-block;
		padding: 0.3rem 0;
		line-height: 1.4;
	}

	.sf-group a:hover,
	.sf-legal a:hover {
		color: var(--sf-accent);
		text-decoration: underline;
		text-underline-offset: 0.18em;
	}

	/* ------------------------------------------------------------ legal */
	.sf-legal {
		display: grid;
		gap: 1rem;
		padding: 1.25rem 1.5rem;
		border-radius: 20px;
		background: var(--sf-paper);
		box-shadow: var(--sf-shadow);
		font-size: 0.92rem;
	}

	@media (min-width: 960px) {
		.sf-legal {
			grid-template-columns: 1fr auto;
			align-items: center;
		}
	}

	.sf-legal-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.75rem;
	}

	.sf-legal p {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.2rem 0.85rem;
		margin: 0;
	}

	.sf-legal-links span {
		font-weight: 800;
		color: var(--sf-ink);
	}

	.sf-legal .sf-copy {
		display: block;
		color: var(--sf-ink-soft);
	}

	.sf-copy a:first-of-type {
		font-weight: 700;
	}

	.sf :is(a):focus-visible {
		outline: 3px solid var(--sf-accent);
		outline-offset: 2px;
		border-radius: 8px;
	}

	@media (max-width: 600px) {
		.sf {
			padding-top: 3rem;
		}
	}
</style>
