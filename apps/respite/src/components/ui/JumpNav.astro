---
/**
 * "On this page" bar for the long product pages (styles in src/styles/info-pages.css).
 * It sticks to the top, moves below the site header while the header is showing (the header hides
 * on scroll down and returns on scroll up), and marks the section being read.
 */
interface Props {
	links: { href: string; label: string }[];
}
const { links } = Astro.props;
---

<nav class="ip-jump" aria-label="On this page" data-jump>
	{links.map((l) => <a href={l.href}>{l.label}</a>)}
</nav>

<script>
	const nav = document.querySelector<HTMLElement>('[data-jump]');
	const header = document.querySelector<HTMLElement>('body > header');
	if (nav) {
		// Follow the header: while it is on screen, sit just below its bar.
		// Layout values, not getBoundingClientRect: the header animates its transform, and a mid-animation
		// reading would put the bar under it.
		const place = () => {
			const bar = header?.querySelector<HTMLElement>('nav');
			const bottom = bar ? bar.offsetTop + bar.offsetHeight : 0;
			const shown = !!header && !/translateY\(-100%\)/.test(header.style.transform);
			nav.style.top = shown && bottom > 0 ? `${bottom + 8}px` : '0.75rem';
		};
		if (header) new MutationObserver(place).observe(header, { attributes: true, attributeFilter: ['style'] });
		addEventListener('resize', place);
		place();

		// Mark the section being read.
		const links = new Map([...nav.querySelectorAll<HTMLAnchorElement>('a')].map((a) => [a.hash.slice(1), a]));
		const observer = new IntersectionObserver(
			(entries) => {
				for (const e of entries) {
					if (!e.isIntersecting) continue;
					links.forEach((a) => a.removeAttribute('aria-current'));
					const a = links.get(e.target.id);
					if (a) {
						a.setAttribute('aria-current', 'true');
						nav.scrollTo({ left: a.offsetLeft - nav.clientWidth / 3, behavior: 'smooth' });
					}
				}
			},
			{ rootMargin: '-20% 0px -70% 0px' },
		);
		links.forEach((_, id) => {
			const el = document.getElementById(id);
			if (el) observer.observe(el);
		});
	}
</script>
