---
/**
 * Free and Respite Plus as two cards, for /download/ and /features/ (Mist styles from
 * src/styles/info-pages.css). Every line comes from /blog/respite-plus-whats-included/,
 * /blog/schedule-app-blocking-iphone-android/, /blog/focus-session-app-iphone/,
 * /blog/sync-respite-android-iphone-chrome/ and /ai/: change them together. Prices are
 * "at the time of writing"; the stores set them per country.
 */
import Icon from './Icon.astro';

const free = [
	'The pause before the apps and sites you pick',
	'Usage tracking and daily limits',
	'1 schedule',
	'Focus sessions up to 25 minutes',
	'Acorns, quests and leagues (iPhone and Android)',
	'Sync for one device',
];
const plus = [
	'Sync on every device',
	'Unlimited schedules, up to 8 at once',
	'Focus sessions up to 90 minutes',
	'Richer insights',
	'Bring your own AI',
	'Live Activity and Control Center (iPhone)',
];
---

<div class="pc">
	<section class="pc-card" aria-labelledby="pc-free">
		<h3 id="pc-free" class="pc-name">Free</h3>
		<p class="pc-price">$0 <span>always</span></p>
		<ul class="pc-list">
			{free.map((f) => (
				<li><span class="pc-check" aria-hidden="true"><Icon name="Check" size={16} /></span>{f}</li>
			))}
		</ul>
	</section>
	<section class="pc-card is-plus" aria-labelledby="pc-plus">
		<h3 id="pc-plus" class="pc-name">Respite Plus <span class="m-badge is-plus">Optional</span></h3>
		<p class="pc-price">$4.99 <span>a month</span></p>
		<p class="pc-alt">or $29.99 a year with a free week, or $59.99 once</p>
		<p class="pc-lead">Everything in Free, plus:</p>
		<ul class="pc-list">
			{plus.map((f) => (
				<li><span class="pc-check" aria-hidden="true"><Icon name="Plus" size={16} /></span>{f}</li>
			))}
		</ul>
	</section>
</div>
<p class="m-caption pc-note">Prices at the time of writing; the stores set them by country. Buy Plus in the iPhone or Android app, no account needed. <a href="/blog/respite-plus-whats-included/">Everything Plus includes</a></p>

<style>
	.pc {
		display: grid;
		gap: 1rem;
	}

	@media (min-width: 760px) {
		.pc {
			grid-template-columns: 1fr 1fr;
			gap: 1.25rem;
		}
	}

	.pc-card {
		display: grid;
		align-content: start;
		gap: 0.5rem;
		padding: 1.75rem;
		border-radius: 20px;
		background: var(--m-paper);
		box-shadow: var(--m-shadow-sm);
	}

	.pc-card.is-plus {
		box-shadow: var(--m-shadow-md);
	}

	.pc-name {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin: 0;
		font-size: 1.25rem;
		font-weight: 800;
	}

	.pc-price {
		margin: 0;
		font-family: var(--font-heading);
		font-size: 2.6rem;
		font-weight: 800;
		line-height: 1.1;
		letter-spacing: -0.02em;
		font-variant-numeric: tabular-nums;
	}

	.pc-price span {
		font-size: 1rem;
		font-weight: 700;
		letter-spacing: 0;
		color: var(--m-ink-soft);
	}

	.pc-alt {
		margin: -0.25rem 0 0;
		font-size: 0.95rem;
		color: var(--m-ink-soft);
	}

	.pc-lead {
		margin: 0.75rem 0 0;
		font-weight: 700;
	}

	.pc-list {
		display: grid;
		gap: 0.7rem;
		margin: 0.75rem 0 0;
		padding: 0;
		list-style: none;
	}

	.pc-list li {
		display: flex;
		align-items: flex-start;
		gap: 0.7rem;
		line-height: 1.4;
	}

	.pc-check {
		display: grid;
		place-items: center;
		flex: none;
		width: 26px;
		height: 26px;
		border-radius: 50%;
		background: var(--m-success-soft);
		color: var(--m-success-ink);
	}

	.is-plus .pc-check {
		background: var(--m-reward-soft);
		color: var(--m-reward-ink);
	}

	.pc-note {
		margin-top: 0.25rem;
	}
</style>
