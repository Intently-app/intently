---
/**
 * The Home hero's 3D phone. It tells Respite's story in one take: the home screen, Facebook opens,
 * Respite's pause rises, "I'll do something else", and back home with a small reward.
 *
 * Scroll drives it. Every step is a paused CSS animation 1s long whose delay is -var(--p) seconds, so
 * one number from 0 to 1 scrubs the whole story, forward and back, in every browser. The page sets the
 * scroll track (index.astro: [data-story-track], [data-story-sticky], [data-story-spacer]).
 * Without JavaScript, or with reduced motion, --p stays at 0.45: the pause over the feed.
 * The pause uses the Android app's own words (ThinkFast-Android strings). Biscuit there is a vector still
 * (the canvas's "thinking" pose): a Lottie player sized while the app layer is scaled down renders blurry.
 */
import AppIcon from '../ui/AppIcon.astro';
import Icon from '../ui/Icon.astro';

const grid = [
	{ app: 'facebook', name: 'Facebook' },
	{ app: 'instagram', name: 'Instagram' },
	{ app: 'youtube', name: 'YouTube' },
	{ app: 'whatsapp', name: 'WhatsApp' },
	{ app: 'googlechrome', name: 'Chrome' },
	{ app: 'spotify', name: 'Spotify' },
	{ app: 'netflix', name: 'Netflix' },
	{ app: 'respite', name: 'Respite' },
];
const dock = ['Phone', 'MessageCircle', 'Camera', 'Image'];
---

<div
	class="hp"
	role="img"
	aria-label="A phone, slightly turned. On the home screen, Facebook is tapped. As it opens, Respite's pause rises over the feed: What were you hoping to find when you opened this? I'll do something else is tapped, Facebook closes, and the home screen shows Walked away, plus 10 acorns."
>
	<div class="hp-scene" aria-hidden="true">
		<div class="hp-shadow hp-a"></div>
		<div class="hp-phone hp-a">
			<span class="hp-side"><i class="hp-key is-power"></i><i class="hp-key is-volume"></i></span>
			<span class="hp-bottom"></span>

			<div class="hp-front">
				<div class="hp-screen">
					<!-- 1. Pixel home screen -->
					<div class="hp-home hp-a">
						<div class="hp-status"><span>9:41</span><span class="hp-status-icons"><Icon name="Wifi" size={11} /><Icon name="BatteryFull" size={13} /></span></div>
						<div class="hp-glance">
							<p class="hp-glance-day">Thursday, Nov 12</p>
							<p class="hp-glance-weather"><Icon name="Sun" size={11} /> 18°</p>
						</div>
						<div class="hp-grid">
							{grid.map((g) => (
								<span class={`hp-app ${g.app === 'facebook' ? 'is-target' : ''}`}>
									<AppIcon app={g.app} size={42} />
									<span class="hp-app-name">{g.name}</span>
									{g.app === 'facebook' && <span class="hp-tap hp-tap-1 hp-a"></span>}
								</span>
							))}
						</div>
						<div class="hp-dock">
							{dock.map((d) => (
								<span class="hp-dock-icon"><Icon name={d} size={18} /></span>
							))}
						</div>
						<div class="hp-search"><Icon name="Search" size={13} /><span></span><Icon name="Mic" size={13} /></div>

						<!-- 4. The reward, back home -->
						<div class="hp-toast hp-a">
							<AppIcon app="respite" size={30} />
							<span class="hp-toast-copy">
								<strong>Walked away</strong>
								<span><Icon name="Flame" size={11} /> 8 days · +10 acorns</span>
							</span>
						</div>
					</div>

					<!-- 2. Facebook, opening from its icon -->
					<div class="hp-fb hp-a">
						<div class="hp-fb-bar"><AppIcon app="facebook" size={24} /><span class="hp-fb-dots"><i></i><i></i></span></div>
						<div class="hp-feed hp-a">
							<div class="hp-stories"><i></i><i></i><i></i><i></i></div>
							{[0, 1].map(() => (
								<div class="hp-post">
									<div class="hp-post-head"><i class="hp-avatar"></i><span><i class="hp-line is-w60"></i><i class="hp-line is-w30"></i></span></div>
									<i class="hp-line is-w90"></i>
									<i class="hp-photo"></i>
								</div>
							))}
						</div>

						<!-- 3. Respite's pause, rising over the feed -->
						<div class="hp-pause hp-a">
							<p class="hp-pause-app">Facebook</p>
							<div class="hp-pause-fox"><img src="/images/app/biscuit-thinking.svg" alt="" width="92" height="92" decoding="async" /></div>
							<p class="hp-pause-q">What were you hoping to find when you opened this?</p>
							<p class="hp-pause-sub">Take a moment to honestly answer</p>
							<div class="hp-pause-actions">
								<span class="hp-btn is-leave hp-a"><Icon name="House" size={12} /> I'll do something else<span class="hp-tap hp-tap-2 hp-a"></span></span>
								<span class="hp-btn">Continue to Facebook</span>
								<span class="hp-snooze"><Icon name="Hourglass" size={11} /> Snooze for 10 minutes</span>
							</div>
							<p class="hp-pause-foot">You can always continue. It is your choice.</p>
						</div>
					</div>
				</div>
				<span class="hp-camera"></span>
				<span class="hp-glare"></span>
			</div>
		</div>
	</div>

	<ol class="hp-steps" aria-hidden="true">
		<li class="hp-step hp-step-1 hp-a">Open an app</li>
		<li class="hp-step hp-step-2 hp-a">A short pause</li>
		<li class="hp-step hp-step-3 hp-a">Walk away</li>
	</ol>
	<p class="hp-hint hp-a" aria-hidden="true"><Icon name="ChevronsDown" size={16} /> Scroll to play</p>
</div>

<script>
	// Map the scroll track to --p (0 to 1). The page marks the track, the element that sticks
	// ([data-story-sticky], or this phone on small screens) and the spacer that follows it.
	const still = matchMedia('(prefers-reduced-motion: reduce)');
	document.querySelectorAll<HTMLElement>('.hp').forEach((hp) => {
		const track = hp.closest<HTMLElement>('[data-story-track]');
		const spacer = track?.querySelector<HTMLElement>('[data-story-spacer]');
		const block = track?.querySelector<HTMLElement>('[data-story-sticky]');
		if (!track || !spacer) return;

		let queued = false;
		function update() {
			queued = false;
			if (still.matches) {
				hp.style.removeProperty('--p');
				return;
			}
			const sticky = block && getComputedStyle(block).position === 'sticky' ? block : hp;
			const h = spacer!.offsetHeight;
			if (!h) return;
			const p = (sticky.getBoundingClientRect().bottom - spacer!.getBoundingClientRect().top) / h;
			hp.style.setProperty('--p', Math.min(1, Math.max(0, p)).toFixed(4));
		}
		const queue = () => {
			if (!queued) {
				queued = true;
				requestAnimationFrame(update);
			}
		};
		track.classList.add('is-playing');
		addEventListener('scroll', queue, { passive: true });
		new ResizeObserver(queue).observe(track);
		still.addEventListener('change', queue);
		update();
	});
</script>

<style>
	/* ------------------------------------------------------------ scrubbing */
	.hp {
		--p: 0.45;
		--pw: clamp(220px, calc((100svh - 330px) / 2.12), 280px); /* phone width, fits the screen height */
		--ph: calc(var(--pw) * 2.12);
		--depth: 16px;
		position: relative;
		display: grid;
		justify-items: center;
		gap: 1.1rem;
		padding: 1.5rem 0 0.5rem;
	}

	.hp-a {
		animation-duration: 1s;
		animation-timing-function: linear;
		animation-fill-mode: both;
		animation-play-state: paused;
		animation-delay: calc(var(--p) * -1s);
	}

	@media (max-width: 760px) {
		.hp {
			--pw: clamp(200px, calc((100svh - 260px) / 2.12), 236px);
		}
	}

	/* ------------------------------------------------------------ the phone in 3D */
	.hp-scene {
		position: relative;
		width: calc(var(--pw) + 80px);
		height: calc(var(--ph) + 60px);
		perspective: 1600px;
		perspective-origin: 50% 40%;
		display: grid;
		place-items: center;
	}

	.hp-phone {
		position: relative;
		width: var(--pw);
		height: var(--ph);
		transform-style: preserve-3d;
		animation-name: hp-turn;
	}

	@keyframes hp-turn {
		0% {
			transform: rotateY(-26deg) rotateX(10deg) rotateZ(1.5deg);
		}
		30%,
		58% {
			transform: rotateY(-9deg) rotateX(4deg) rotateZ(0.5deg);
		}
		100% {
			transform: rotateY(-26deg) rotateX(10deg) rotateZ(1.5deg);
		}
	}

	.hp-front {
		position: absolute;
		inset: 0;
		padding: 9px;
		border-radius: calc(var(--pw) * 0.15);
		background: linear-gradient(145deg, #2a3640, #0c1217 55%);
		box-shadow: inset 0 0 0 1.5px #3c4b56, inset 0 0 0 3px #0b1014;
		transform: translateZ(calc(var(--depth) / 2));
	}

	.hp-screen {
		position: relative;
		height: 100%;
		border-radius: calc(var(--pw) * 0.12);
		overflow: hidden;
		background: #000;
		font-family: 'Nunito Sans', var(--font-body, system-ui), sans-serif;
		font-size: calc(var(--pw) / 24);
		line-height: 1.3;
	}

	/* Thickness: the right edge and the bottom edge, turned out of the screen's plane. */
	.hp-side {
		position: absolute;
		top: calc(var(--pw) * 0.08);
		right: calc(var(--depth) / -2);
		width: var(--depth);
		height: calc(100% - var(--pw) * 0.16);
		border-radius: 6px;
		background: linear-gradient(90deg, #26333d, #5b6c78 45%, #2d3a44 70%, #161e24);
		transform: rotateY(90deg);
	}

	.hp-key {
		position: absolute;
		right: 2px;
		left: 2px;
		border-radius: 3px;
		background: #4a5a66;
		transform: translateZ(1.5px);
	}

	.hp-key.is-power {
		top: 16%;
		height: 9%;
	}

	.hp-key.is-volume {
		top: 30%;
		height: 15%;
	}

	.hp-bottom {
		position: absolute;
		bottom: calc(var(--depth) / -2);
		left: calc(var(--pw) * 0.1);
		width: calc(100% - var(--pw) * 0.2);
		height: var(--depth);
		border-radius: 6px;
		background: linear-gradient(180deg, #4a5a66, #1a232a);
		transform: rotateX(-90deg);
	}

	.hp-camera {
		position: absolute;
		top: 17px;
		left: 50%;
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: #05080a;
		box-shadow: inset 0 0 0 2px #1b252c;
		transform: translateX(-50%);
	}

	.hp-glare {
		position: absolute;
		inset: 9px;
		border-radius: calc(var(--pw) * 0.12);
		background: linear-gradient(118deg, rgba(255, 255, 255, 0.16) 0%, rgba(255, 255, 255, 0) 32%);
		pointer-events: none;
	}

	.hp-shadow {
		position: absolute;
		bottom: 4px;
		left: 50%;
		width: calc(var(--pw) * 0.95);
		height: 34px;
		border-radius: 50%;
		background: radial-gradient(closest-side, rgba(19, 34, 45, 0.32), transparent);
		filter: blur(6px);
		transform: translateX(-46%);
		animation-name: hp-shadow;
	}

	@keyframes hp-shadow {
		0%,
		100% {
			transform: translateX(-40%) scaleX(1.05);
		}
		30%,
		58% {
			transform: translateX(-48%) scaleX(0.96);
		}
	}

	/* ------------------------------------------------------------ 1. home screen */
	.hp-home {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		padding: 0.7em 1.1em 1em;
		background: linear-gradient(170deg, #cfe2ec 0%, #e8f0f5 45%, #d5e3d9 100%);
		color: #13222d;
		animation-name: hp-home;
	}

	@keyframes hp-home {
		0%,
		18% {
			transform: scale(1);
			filter: none;
		}
		26%,
		64% {
			transform: scale(1.06);
			filter: brightness(0.85);
		}
		74%,
		100% {
			transform: scale(1);
			filter: none;
		}
	}

	.hp-status {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0 0.3em;
		font-size: 0.85em;
		font-weight: 700;
	}

	.hp-status-icons {
		display: flex;
		gap: 0.3em;
	}

	.hp-glance {
		margin: 2.2em 0 0;
		padding: 0 0.3em;
	}

	.hp-glance p {
		margin: 0;
	}

	.hp-glance-day {
		font-family: var(--font-heading, 'Nunito'), sans-serif;
		font-size: 1.55em;
		font-weight: 700;
		line-height: 1.1;
	}

	.hp-glance-weather {
		display: flex;
		align-items: center;
		gap: 0.3em;
		margin-top: 0.3em !important;
		font-weight: 700;
	}

	.hp-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		row-gap: 1em;
		margin-top: auto;
	}

	.hp-app {
		position: relative;
		display: grid;
		justify-items: center;
		gap: 0.3em;
	}

	.hp-app :global(.m-appicon) {
		border-radius: 50%;
		box-shadow: 0 2px 6px rgba(19, 34, 45, 0.18);
	}

	.hp-app-name {
		font-size: 0.72em;
		font-weight: 600;
	}

	.hp-dock {
		display: flex;
		justify-content: space-around;
		margin-top: 1.6em;
	}

	.hp-dock-icon {
		display: grid;
		place-items: center;
		width: 3.3em;
		height: 3.3em;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.75);
		color: #2f6079;
	}

	.hp-search {
		display: flex;
		align-items: center;
		gap: 0.6em;
		margin-top: 1em;
		padding: 0.75em 1em;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.85);
		color: #5b6b76;
	}

	.hp-search span {
		flex: 1;
	}

	/* The tap: a soft ring that blooms where the finger lands. */
	.hp-tap {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 3.4em;
		height: 3.4em;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.45);
		box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.9);
		opacity: 0;
		pointer-events: none;
	}

	.hp-tap-1 {
		top: 1.6em;
		animation-name: hp-tap-1;
	}

	@keyframes hp-tap-1 {
		0%,
		9% {
			opacity: 0;
			transform: translate(-50%, -50%) scale(0.5);
		}
		12% {
			opacity: 1;
			transform: translate(-50%, -50%) scale(0.8);
		}
		18%,
		100% {
			opacity: 0;
			transform: translate(-50%, -50%) scale(1.5);
		}
	}

	.hp-tap-2 {
		animation-name: hp-tap-2;
	}

	@keyframes hp-tap-2 {
		0%,
		54% {
			opacity: 0;
			transform: translate(-50%, -50%) scale(0.5);
		}
		57% {
			opacity: 1;
			transform: translate(-50%, -50%) scale(0.8);
		}
		63%,
		100% {
			opacity: 0;
			transform: translate(-50%, -50%) scale(1.6);
		}
	}

	/* ------------------------------------------------------------ 2. Facebook */
	.hp-fb {
		position: absolute;
		inset: 0;
		overflow: hidden;
		background: #f0f2f5;
		transform-origin: 16% 66%; /* the Facebook icon on the home screen */
		animation-name: hp-fb;
	}

	@keyframes hp-fb {
		0%,
		16% {
			opacity: 0;
			transform: scale(0.12);
			border-radius: 50%;
		}
		18% {
			opacity: 1;
		}
		27%,
		63% {
			opacity: 1;
			transform: scale(1);
			border-radius: 0;
		}
		72% {
			opacity: 0.6;
			transform: scale(0.12);
			border-radius: 50%;
		}
		74%,
		100% {
			opacity: 0;
			transform: scale(0.12);
		}
	}

	.hp-fb-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 2.6em 1em 0.7em;
		background: #fff;
	}

	.hp-fb-dots {
		display: flex;
		gap: 0.4em;
	}

	.hp-fb-dots i {
		width: 2.1em;
		height: 2.1em;
		border-radius: 50%;
		background: #e4e6eb;
	}

	.hp-feed {
		display: grid;
		gap: 0.6em;
		padding-top: 0.6em;
		filter: blur(0.6px);
		animation-name: hp-feed;
	}

	@keyframes hp-feed {
		0%,
		24% {
			transform: translateY(0);
		}
		36%,
		100% {
			transform: translateY(-2.5em);
		}
	}

	.hp-stories {
		display: flex;
		gap: 0.5em;
		padding: 0.7em 1em;
		background: #fff;
	}

	.hp-stories i {
		flex: 1;
		height: 6.5em;
		border-radius: 0.8em;
		background: linear-gradient(160deg, #c9d6e3, #a7b8c9);
	}

	.hp-post {
		display: grid;
		gap: 0.6em;
		padding: 0.9em 1em;
		background: #fff;
	}

	.hp-post-head {
		display: flex;
		align-items: center;
		gap: 0.6em;
	}

	.hp-post-head span {
		display: grid;
		flex: 1;
		gap: 0.35em;
	}

	.hp-avatar {
		width: 2.6em;
		height: 2.6em;
		border-radius: 50%;
		background: #cfd8e0;
	}

	.hp-line {
		display: block;
		height: 0.65em;
		border-radius: 999px;
		background: #dde2e7;
	}

	.hp-line.is-w90 {
		width: 90%;
	}
	.hp-line.is-w60 {
		width: 60%;
	}
	.hp-line.is-w30 {
		width: 30%;
	}

	.hp-photo {
		height: 9.5em;
		border-radius: 0.5em;
		background: linear-gradient(135deg, #d9c9b8, #b9c7d6 60%, #a9bfb1);
	}

	/* ------------------------------------------------------------ 3. Respite's pause */
	.hp-pause {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 2.6em 1.3em 1.4em;
		background: #1c2733;
		color: #f3f6f9;
		text-align: center;
		animation-name: hp-pause;
	}

	@keyframes hp-pause {
		0%,
		30% {
			transform: translateY(100%);
		}
		40%,
		100% {
			transform: translateY(0);
		}
	}

	.hp-pause p {
		margin: 0;
	}

	.hp-pause-app {
		font-size: 0.85em;
		opacity: 0.75;
	}

	.hp-pause-fox img {
		width: 80%;
		height: auto;
	}

	.hp-pause-fox {
		display: grid;
		place-items: center;
		width: 7.6em;
		height: 7.6em;
		margin: 2.4em 0 1.4em;
		border-radius: 50%;
		background: #2a3846;
	}

	.hp-pause-q {
		font-family: var(--font-heading, 'Nunito'), sans-serif;
		font-size: 1.45em;
		font-weight: 800;
		line-height: 1.2;
	}

	.hp-pause-sub {
		margin-top: 0.7em !important;
		font-size: 0.85em;
		opacity: 0.75;
	}

	.hp-pause-actions {
		display: grid;
		gap: 0.6em;
		width: 100%;
		margin-top: auto;
	}

	.hp-btn {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.4em;
		padding: 0.95em;
		border-radius: 999px;
		background: #2b3a48;
		font-weight: 700;
	}

	.hp-btn.is-leave {
		background: #3f74c9;
		color: #fff;
		box-shadow: 0 6px 16px -6px rgba(63, 116, 201, 0.8);
		animation-name: hp-press;
	}

	@keyframes hp-press {
		0%,
		56% {
			transform: scale(1);
		}
		58% {
			transform: scale(0.95);
			filter: brightness(1.15);
		}
		61%,
		100% {
			transform: scale(1);
		}
	}

	.hp-snooze {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.4em;
		padding: 0.4em;
		font-size: 0.85em;
		font-weight: 700;
	}

	.hp-pause-foot {
		margin-top: 0.8em !important;
		font-size: 0.7em;
		opacity: 0.6;
	}

	/* ------------------------------------------------------------ 4. reward toast */
	.hp-toast {
		position: absolute;
		top: 2.6em;
		right: 0.8em;
		left: 0.8em;
		display: flex;
		align-items: center;
		gap: 0.7em;
		padding: 0.75em 0.9em;
		border-radius: 1.2em;
		background: rgba(255, 255, 255, 0.96);
		box-shadow: 0 10px 24px -10px rgba(19, 34, 45, 0.45);
		animation-name: hp-toast;
	}

	@keyframes hp-toast {
		0%,
		74% {
			opacity: 0;
			transform: translateY(-140%);
		}
		81%,
		100% {
			opacity: 1;
			transform: translateY(0);
