---
interface Props {
  name: string;
  description: string;
  platform: 'android' | 'ios' | 'chrome';
  downloadUrl: string;
  ratingValue?: number;
  ratingCount?: number;
  reviews?: Array<{
    author: string;
    rating: number;
    date: string;
    text: string;
  }>;
}

const {
  name,
  description,
  platform,
  downloadUrl,
  ratingValue,
  ratingCount,
  reviews = []
} = Astro.props;

const platformNames = {
  android: "Android App",
  ios: "iOS App",
  chrome: "Chrome Extension"
};

const commonFeatures = [
  "Mindful pause before distracting apps",
  "Daily limits and streak tracking",
  "Account optional (sign in only for sync)",
  "No ads"
];

// Only claim what each platform's app does.
const platformFeatures = {
  android: ["Usage analytics and insights", "Optional Reels and Shorts blocking", "Home screen widgets"],
  ios: ["Built on Apple's Screen Time", "App lock that refreshes at midnight", "App names stay on the iPhone by default"],
  chrome: ["Website time tracking", "Focus mode", "Usage insights"]
};

const productSchema = {
  "@context": "https://schema.org",
  "@type": platform === 'chrome' ? "SoftwareApplication" : "MobileApplication",
  "name": `Respite: Screen Time Control - ${platformNames[platform]}`,
  "alternateName": "Respite",
  "description": description,
  "applicationCategory": "HealthApplication",
  "url": downloadUrl,
  "offers": [
    { "@type": "Offer", "name": "Respite (free)", "price": "0", "priceCurrency": "USD" },
    { "@type": "Offer", "name": "Respite Plus, monthly", "price": "4.99", "priceCurrency": "USD", "description": "Sync across devices and bring your own AI. Store prices vary by country." },
    { "@type": "Offer", "name": "Respite Plus, yearly", "price": "29.99", "priceCurrency": "USD", "description": "One-week free trial. Store prices vary by country." },
    { "@type": "Offer", "name": "Respite Plus, lifetime", "price": "59.99", "priceCurrency": "USD", "description": "One-time purchase. Store prices vary by country." }
  ],
  ...(ratingValue && ratingCount ? {
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": ratingValue,
      "ratingCount": ratingCount,
      "bestRating": "5",
      "worstRating": "1"
    }
  } : {}),
  "author": {
    "@type": "Organization",
    "@id": "https://liveintently.app/#organization",
    "name": "Intently",
    "url": "https://liveintently.app"
  },
  "operatingSystem": { android: "Android", ios: "iOS", chrome: "Windows, macOS, Linux" }[platform],
  "softwareVersion": "1.0",
  "datePublished": "2024-01-01",
  "featureList": [...commonFeatures, ...platformFeatures[platform]]
};

// Include individual reviews if provided
const reviewsSchema = reviews.length > 0 ? reviews.map(review => ({
  "@type": "Review",
  "author": {
    "@type": "Person",
    "name": review.author
  },
  "reviewRating": {
    "@type": "Rating",
    "ratingValue": review.rating,
    "bestRating": "5"
  },
  "datePublished": review.date,
  "reviewBody": review.text
})) : [];
---

<script type="application/ld+json" set:html={JSON.stringify(productSchema)} />

{reviews.length > 0 && reviewsSchema.map(review => (
  <script type="application/ld+json" set:html={JSON.stringify(review)} />
))}
