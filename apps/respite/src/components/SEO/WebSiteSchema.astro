---
/**
 * WebSite schema for the home page: the site, its publisher (Intently) and what it is about (the
 * Respite entity from RespiteAppSchema.astro).
 */
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://respite.liveintently.app/#website",
  "name": "Respite",
  "alternateName": "Respite: Screen Time Control",
  "url": "https://respite.liveintently.app/",
  "description": "Respite: Screen Time Control is a free screen time app for Android, iPhone and Chrome by Intently. It puts a short pause before the apps and sites you pick, with limits, streaks and a free game layer. Respite Plus adds sync and lets you connect your own AI (Claude, ChatGPT, Cursor) over MCP.",
  "inLanguage": "en-US",
  // The maker is Intently (OrganizationSchema.astro, in every page's head); the site is about the app.
  "publisher": { "@id": "https://liveintently.app/#organization" },
  "about": { "@id": "https://respite.liveintently.app/#software" }
  // No SearchAction: the site has no search page, and Google retired the sitelinks search box in 2024.
};
---

<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
