---
/**
 * /blog/: find something worth reading.
 *
 * Search sits at the top (titles, summaries and tags; `/` focuses it; ?q= is shareable). Topics,
 * sort and "hide what I've read" live in a sticky rail on wide screens and above the list on
 * narrow ones. Before the full list: "Continue reading" (from this device's reading progress,
 * saved by the post page), "Start here" and the newest posts. Every article is in the list as
 * plain links, so the page works and is crawlable without JavaScript.
 */
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
import { getPublishedPosts } from '../../lib/posts';
import FormattedDate from '../../components/FormattedDate.astro';
import BreadcrumbSchema from '../../components/SEO/BreadcrumbSchema.astro';
import CollectionPageSchema from '../../components/SEO/CollectionPageSchema.astro';
import Picture from '../../components/ui/Picture.astro';
import { BLOG_CATEGORIES, getBlogCategoryId, getBlogCategoryMeta, getNormalizedHeroImage } from '../../data/blogMeta';

const posts = (await getPublishedPosts()).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function getWordCount(markdownBody = ''): number {
	const plainText = markdownBody
		.replace(/```[\s\S]*?```/g, ' ')
		.replace(/`[^`]*`/g, ' ')
		.replace(/\[(.*?)\]\(.*?\)/g, '$1')
		.replace(/https?:\/\/\S+/g, ' ')
		.replace(/[#*_>~|!-]/g, ' ')
		.replace(/\s+/g, ' ')
		.trim();
	return plainText ? plainText.split(' ').length : 0;
}

const items = posts.map((post) => {
	const category = getBlogCategoryMeta(post.id);
	const readingTime = Math.max(1, Math.ceil(getWordCount(post.body || '') / 200));
	const updated = post.data.updatedDate ?? post.data.pubDate;
	return {
		id: post.id,
		title: post.data.title,
		description: post.data.description,
		pubDate: post.data.pubDate,
		updated,
		categoryId: getBlogCategoryId(post.id),
		category,
		heroImage: getNormalizedHeroImage(post.data.heroImage),
		readingTime,
		search: [post.data.title, post.data.description, category.label, ...(post.data.tags ?? [])].join(' ').toLowerCase(),
	};
});

const topics = BLOG_CATEGORIES.map((c) => ({ ...c, count: items.filter((i) => i.categoryId === c.id).length })).filter((c) => c.count > 0);

// For a first visit: the basics, in the order they build on each other.
const START_HERE = ['how-much-screen-time-is-too-much', 'why-willpower-fails-phone-addiction', 'how-to-stop-doomscrolling', 'how-to-reduce-screen-time'];
const startHere = START_HERE.map((id) => items.find((i) => i.id === id)).filter((i): i is (typeof items)[number] => !!i);
const latest = items.slice(0, 3);

const collectionItems = items.map((i) => ({
	name: i.title,
	url: `https://respite.liveintently.app/blog/${i.id}/`,
	description: i.description,
	image: i.heroImage,
	datePublished: i.pubDate.toISOString(),
}));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Blog - ${SITE_TITLE}`}
			description="Guides to using your phone on purpose: habits, routines, app-by-app advice and honest comparisons of screen time apps."
		/>
		<BreadcrumbSchema
			items={[
				{ name: 'Home', url: 'https://respite.liveintently.app' },
				{ name: 'Blog', url: 'https://respite.liveintently.app/blog/' },
			]}
		/>
		<CollectionPageSchema
			name="Respite Blog"
			description="Articles, guides, and research on digital wellbeing, screen time management, and building healthier relationships with technology."
			url="/blog"
			items={collectionItems}
		/>
	</head>
	<body class="blog-index">
		<Header />
		<main class="index">
			<header class="index-head">
				<h1>Blog</h1>
				<p class="index-dek">Guides to using your phone on purpose: habits, routines, app-by-app advice and honest comparisons.</p>
				<form class="search" role="search" action="/blog/" method="get" onsubmit="return false">
					<label for="blog-search" class="visually-hidden">Search articles</label>
					<svg class="search-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
					<input id="blog-search" name="q" type="search" placeholder={`Search ${items.length} articles`} autocomplete="off" enterkeyhint="search" aria-describedby="search-hint" />
					<kbd class="search-key" id="search-hint" aria-label="Press slash to search">/</kbd>
					<button type="button" class="search-clear" id="search-clear" hidden>Clear</button>
				</form>
				<p class="index-links">
					<span>{items.length} articles</span>
					<a href="/rss.xml">RSS feed</a>
				</p>
			</header>

			<aside class="controls" aria-label="Filter articles">
				<h2 class="controls-title" id="topics-title">Topics</h2>
				<div class="topics" role="group" aria-labelledby="topics-title">
					<button type="button" class="topic" data-topic="all" aria-pressed="true">
						<span>All articles</span><span class="topic-count">{items.length}</span>
					</button>
					{topics.map((t) => (
						<button type="button" class="topic" data-topic={t.id} data-description={t.description} aria-pressed="false" style={`--topic: ${t.accentColor}`}>
							<span>{t.label}</span><span class="topic-count">{t.count}</span>
						</button>
					))}
				</div>
				<div class="list-options">
					<label class="sort">
						<span>Sort</span>
						<select id="sort">
							<option value="new">Newest</option>
							<option value="updated">Recently updated</option>
							<option value="short">Shortest first</option>
						</select>
					</label>
					<label class="hide-read" id="hide-read-wrap" hidden>
						<input type="checkbox" id="hide-read" />
						<span>Hide what I've read</span>
					</label>
				</div>
			</aside>

			<div class="index-main">
				<section class="continue" id="continue" aria-labelledby="continue-title" hidden>
					<h2 id="continue-title">Continue reading</h2>
					<ul class="continue-list" id="continue-list"></ul>
				</section>

				<div class="intro" id="intro">
					{startHere.length > 0 && (
						<section class="start" aria-labelledby="start-title">
							<h2 id="start-title">New here? Start with these</h2>
							<ol class="start-list">
								{startHere.map((i) => (
									<li>
										<a href={`/blog/${i.id}/`}>
											<span class="start-title">{i.title}</span>
											<span class="start-meta">{i.readingTime} min read</span>
										</a>
									</li>
								))}
							</ol>
						</section>
					)}

					<section class="latest" aria-labelledby="latest-title">
						<h2 id="latest-title">Newest</h2>
						<ul class="latest-list">
							{latest.map((i, n) => (
								<li>
									<a href={`/blog/${i.id}/`}>
										<Picture src={i.heroImage} alt="" width={720} height={405} loading={n === 0 ? 'eager' : 'lazy'} fetchpriority={n === 0 ? 'high' : undefined} />
										<span class="item-topic" style={`--topic: ${i.category.accentColor}`}>{i.category.label}</span>
										<span class="latest-title">{i.title}</span>
										<span class="item-meta"><FormattedDate date={i.pubDate} />, {i.readingTime} min read</span>
									</a>
								</li>
							))}
						</ul>
					</section>
				</div>

				<section class="all" aria-labelledby="all-title">
					<div class="all-head">
						<h2 id="all-title">All articles</h2>
						<p class="results" id="results" aria-live="polite">{items.length} articles</p>
					</div>
					<p class="topic-description" id="topic-description" hidden></p>
					<ol class="list" id="list">
						{items.map((i) => (
							<li
								class="row"
								data-slug={i.id}
								data-topic={i.categoryId}
								data-search={i.search}
								data-new={i.pubDate.valueOf()}
								data-updated={i.updated.valueOf()}
								data-minutes={i.readingTime}
								data-img={i.heroImage}>
								<a href={`/blog/${i.id}/`}>
									<span class="row-thumb">
										<Picture src={i.heroImage} alt="" width={320} height={180} loading="lazy" />
										<span class="row-progress" aria-hidden="true"></span>
									</span>
									<span class="row-text">
										<span class="item-topic" style={`--topic: ${i.category.accentColor}`}>{i.category.label}</span>
										<span class="row-title" data-title>{i.title}</span>
										<span class="row-desc">{i.description}</span>
										<span class="item-meta">
											<span data-date-new><FormattedDate date={i.pubDate} /></span>
											<span data-date-updated hidden>Updated <FormattedDate date={i.updated} /></span>
											<span>, {i.readingTime} min read</span>
											<span class="row-state" data-state></span>
										</span>
									</span>
								</a>
							</li>
						))}
					</ol>

					<div class="empty" id="empty" hidden>
						<p class="empty-title" id="empty-title">No articles match.</p>
						<p>Try one of these, or clear the search.</p>
						<p class="suggestions">
							{['doomscrolling', 'sleep', 'Instagram', 'ADHD', 'alternatives', 'ChatGPT'].map((s) => (
								<button type="button" class="suggestion" data-suggest={s}>{s}</button>
							))}
							<button type="button" class="suggestion clear" data-clear-all>Clear search and topic</button>
						</p>
					</div>
				</section>

				<section class="index-cta" aria-labelledby="cta-title" data-placement="index_cta">
					<h2 id="cta-title">Not sure where to start?</h2>
					<p>The 2-minute phone habit quiz points you to the articles and settings that fit your biggest scrolling trigger.</p>
					<p class="cta-actions">
						<a href="/quiz/" class="cta-button" data-cta="quiz">Take the quiz</a>
						<a href="/compare/" data-cta="compare">Compare screen time apps</a>
					</p>
				</section>
			</div>
		</main>
		<Footer />

		<script>
			const search = document.getElementById('blog-search') as HTMLInputElement;
			const clearButton = document.getElementById('search-clear') as HTMLButtonElement;
			const topicButtons = [...document.querySelectorAll<HTMLButtonElement>('.topic')];
			const sortSelect = document.getElementById('sort') as HTMLSelectElement;
			const hideRead = document.getElementById('hide-read') as HTMLInputElement;
			const hideReadWrap = document.getElementById('hide-read-wrap') as HTMLElement;
			const list = document.getElementById('list') as HTMLOListElement;
			const rows = [...list.querySelectorAll<HTMLLIElement>('.row')];
			const results = document.getElementById('results') as HTMLElement;
			const empty = document.getElementById('empty') as HTMLElement;
			const emptyTitle = document.getElementById('empty-title') as HTMLElement;
			const intro = document.getElementById('intro') as HTMLElement;
			const topicDescription = document.getElementById('topic-description') as HTMLElement;
			const continueSection = document.getElementById('continue') as HTMLElement;
			const continueList = document.getElementById('continue-list') as HTMLUListElement;

			// Titles are kept as text so highlighting can be redone from scratch on every search.
			const titles = new Map(rows.map((r) => [r, r.querySelector<HTMLElement>('[data-title]')!]));
			const titleText = new Map(rows.map((r) => [r, titles.get(r)!.textContent ?? '']));
			const order = new Map(rows.map((r, i) => [r, i]));

			// ------------------------------------------------------------ reading progress (from the post page)
			type Progress = Record<string, { p: number; at: number }>;
			let progress: Progress = {};
			try {
				progress = JSON.parse(localStorage.getItem('respite-reading') || '{}');
			} catch { /* storage blocked */ }
			const isRead = (slug: string) => (progress[slug]?.p ?? 0) >= 0.9;
			let readCount = 0;
			rows.forEach((r) => {
				const slug = r.dataset.slug ?? '';
				const p = progress[slug]?.p ?? 0;
				const state = r.querySelector<HTMLElement>('[data-state]');
				if (p >= 0.9) {
					readCount++;
					r.classList.add('is-read');
					if (state) state.textContent = 'Read';
				} else if (p >= 0.05) {
					r.classList.add('is-started');
					r.style.setProperty('--p', String(p));
					if (state) state.textContent = `${Math.round(p * 100)}% read`;
				}
			});
			if (readCount > 0) hideReadWrap.hidden = false;

			// Up to three posts started in the last 30 days and not finished, most recent first.
			const MONTH = 30 * 24 * 3600 * 1000;
			const started = Object.entries(progress)
				.filter(([slug, v]) => v.p >= 0.05 && v.p < 0.9 && Date.now() - v.at < MONTH && rows.some((r) => r.dataset.slug === slug))
				.sort((a, b) => b[1].at - a[1].at)
				.slice(0, 3);
			if (started.length > 0) {
				for (const [slug, v] of started) {
					const row = rows.find((r) => r.dataset.slug === slug)!;
					const minutes = Number(row.dataset.minutes) || 1;
					const left = Math.max(1, Math.ceil(minutes * (1 - v.p)));
					const li = document.createElement('li');
					const a = document.createElement('a');
					a.href = `/blog/${slug}/#continue`;
					const title = document.createElement('span');
					title.className = 'continue-title';
					title.textContent = titleText.get(row) ?? '';
					const meta = document.createElement('span');
					meta.className = 'continue-meta';
					meta.textContent = `${left} min left`;
					const bar = document.createElement('span');
					bar.className = 'continue-bar';
					bar.style.setProperty('--p', String(v.p));
					bar.setAttribute('aria-hidden', 'true');
					a.append(title, meta, bar);
					li.append(a);
					continueList.append(li);
				}
				continueSection.hidden = false;
			}

			// ------------------------------------------------------------ state <-> URL
			const validTopics = new Set(topicButtons.map((b) => b.dataset.topic));
			const params = new URLSearchParams(location.search);
			let topic = validTopics.has(location.hash.slice(1)) ? location.hash.slice(1) : 'all';
			search.value = params.get('q') ?? '';
			if (['new', 'updated', 'short'].includes(params.get('sort') ?? '')) sortSelect.value = params.get('sort')!;

			function writeUrl() {
				const p = new URLSearchParams();
				if (search.value.trim()) p.set('q', search.value.trim());
				if (sortSelect.value !== 'new') p.set('sort', sortSelect.value);
				const qs = p.toString();
				history.replaceState(null, '', `/blog/${qs ? `?${qs}` : ''}${topic !== 'all' ? `#${topic}` : ''}`);
			}

			// ------------------------------------------------------------ filter, rank, sort, highlight
			const escapeRe = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

			function highlight(row: HTMLLIElement, terms: string[]) {
				const el = titles.get(row)!;
				const text = titleText.get(row)!;
				if (terms.length === 0) {
					el.textContent = text;
					return;
				}
				const re = new RegExp(`(${terms.map(escapeRe).join('|')})`, 'gi');
				el.textContent = '';
				for (const part of text.split(re)) {
					if (!part) continue;
					if (re.test(part)) {
						const mark = document.createElement('mark');
						mark.textContent = part;
						el.append(mark);
					} else el.append(part);
					re.lastIndex = 0;
				}
			}

			function apply() {
				const query = search.value.trim().toLowerCase();
				const terms = query.split(/\s+/).filter(Boolean);
				const filtering = terms.length > 0 || topic !== 'all';
				const scored: { row: HTMLLIElement; score: number }[] = [];

				for (const row of rows) {
					const hay = row.dataset.search ?? '';
					const inTopic = topic === 'all' || row.dataset.topic === topic;
					const matches = terms.every((t) => hay.includes(t));
					const hidden = !inTopic || !matches || (hideRead.checked && isRead(row.dataset.slug ?? ''));
					row.hidden = hidden;
					highlight(row, hidden ? [] : terms);
					if (!hidden) {
						const title = (titleText.get(row) ?? '').toLowerCase();
						scored.push({ row, score: terms.reduce((s, t) => s + (title.includes(t) ? 2 : 1), 0) });
					}
				}

				// A search ranks title matches first; otherwise the chosen sort.
				const key = sortSelect.value;
				const byKey = (r: HTMLLIElement) => (key === 'short' ? Number(r.dataset.minutes) : -Number(key === 'updated' ? r.dataset.updated : r.dataset.new));
				scored.sort((a, b) => (terms.length ? b.score - a.score : 0) || byKey(a.row) - byKey(b.row) || order.get(a.row)! - order.get(b.row)!);
				const frag = document.createDocumentFragment();
				scored.forEach(({ row }) => frag.append(row));
				rows.filter((r) => r.hidden).forEach((r) => frag.append(r));
				list.append(frag);

				rows.forEach((r) => {
					r.querySelector<HTMLElement>('[data-date-new]')!.hidden = key === 'updated';
					r.querySelector<HTMLElement>('[data-date-updated]')!.hidden = key !== 'updated';
				});

				const n = scored.length;
				const label = topicButtons.find((b) => b.dataset.topic === topic)?.querySelector('span')?.textContent ?? '';
				const noun = n === 1 ? 'article' : 'articles';
				results.textContent = query
					? `${n} ${noun} for “${search.value.trim()}”${topic !== 'all' ? ` in ${label}` : ''}`
					: topic !== 'all'
						? `${n} ${noun} in ${label}`
						: `${n} ${noun}`;
				empty.hidden = n > 0;
				if (n === 0) emptyTitle.textContent = query ? `No articles match “${search.value.trim()}”${topic !== 'all' ? ` in ${label}` : ''}.` : 'No articles here yet.';
				intro.hidden = filtering;
				continueSection.hidden = filtering || continueList.children.length === 0;
				clearButton.hidden = !query;

				const description = topicButtons.find((b) => b.dataset.topic === topic)?.dataset.description;
				topicDescription.hidden = !description;
				topicDescription.textContent = description ?? '';

				topicButtons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.topic === topic)));
			}

			// ------------------------------------------------------------ events
			let typing: number | undefined;
			search.addEventListener('input', () => {
				apply();
				clearTimeout(typing);
				typing = window.setTimeout(writeUrl, 400);
			});
			search.addEventListener('keydown', (e) => {
				if (e.key === 'Escape' && search.value) {
					e.preventDefault();
					search.value = '';
					apply();
					writeUrl();
				}
				if (e.key === 'Enter') {
					// Enter opens the best match, the way site search usually behaves.
					const first = rows.find((r) => !r.hidden);
					if (search.value.trim() && first) location.href = first.querySelector('a')!.href;
				}
			});
			clearButton.addEventListener('click', () => {
				search.value = '';
				apply();
				writeUrl();
				search.focus();
			});
			topicButtons.forEach((b) =>
				b.addEventListener('click', () => {
					topic = b.dataset.topic ?? 'all';
					apply();
					writeUrl();
					// On phones the list is below the controls: bring its top into view.
					if (window.matchMedia('(max-width: 999px)').matches) {
						document.getElementById('all-title')?.scrollIntoView({ block: 'start', behavior: 'smooth' });
					}
				}),
			);
			sortSelect.addEventListener('change', () => {
				apply();
				writeUrl();
			});
			hideRead.addEventListener('change', apply);
			document.querySelectorAll<HTMLButtonElement>('[data-suggest]').forEach((b) =>
				b.addEventListener('click', () => {
					search.value = b.dataset.suggest ?? '';
					topic = 'all';
					apply();
					writeUrl();
				}),
			);
			document.querySelector('[data-clear-all]')?.addEventListener('click', () => {
				search.value = '';
				topic = 'all';
				apply();
				writeUrl();
				search.focus();
			});
			addEventListener('hashchange', () => {
				const t = location.hash.slice(1);
				topic = validTopics.has(t) ? t : 'all';
				apply();
			});
			// "/" focuses search from anywhere on the page, unless the reader is typing somewhere.
			addEventListener('keydown', (e) => {
				const t = e.target as HTMLElement;
				if (e.key === '/' && !e.metaKey && !e.ctrlKey && !t.closest('input, textarea, select, [contenteditable]')) {
					e.preventDefault();
					search.focus();
					search.select();
				}
			});

			apply();
		</script>
	</body>
</html>

<style>
	/* ------------------------------------------------------------ page and grid (matches the post page) */
	:global(html:has(> body.blog-index)),
	.blog-index {
		overflow-x: clip;
	}

	.blog-index {
		background: var(--ds-bg-primary);
		--rail: 14rem;
		--gap: 3.5rem;
		--main: 48rem;
		--rule: color-mix(in srgb, var(--ds-text-hint) 22%, transparent);
	}

	.index,
	.index :global(*) {
		box-sizing: border-box;
	}

	.index {
		display: grid;
		grid-template-columns: minmax(0, var(--main));
		justify-content: center;
		padding: 8.5rem 1.25rem 5rem;
		row-gap: 1.75rem;
	}

	@media (min-width: 1000px) {
		.index {
			grid-template-columns: var(--rail) minmax(0, var(--main));
			column-gap: var(--gap);
			row-gap: 2.5rem;
		}
		.index-head,
		.index-main {
			grid-column: 2;
		}
		.controls {
			grid-column: 1;
			grid-row: 2;
		}
		.index-main {
			grid-row: 2;
		}
	}

	@media (min-width: 1280px) {
		.index {
			/* An empty right column of the rail's width keeps the list centred, as on the post page. */
			grid-template-columns: var(--rail) minmax(0, var(--main)) var(--rail);
		}
	}

	/* Sections here set display, which would otherwise beat the hidden attribute. */
	.blog-index [hidden] {
		display: none !important;
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}

	/* ------------------------------------------------------------ head and search */
	.index-head {
		display: grid;
		gap: 0.9rem;
	}

	.index-head h1 {
		margin: 0;
		font-size: clamp(2.2rem, 1.6rem + 2.4vw, 3.2rem);
		line-height: 1.05;
		letter-spacing: -0.02em;
	}

	.index-dek {
		margin: 0;
		max-width: 40rem;
		font-family: 'Source Serif 4', Georgia, serif;
		font-size: clamp(1.05rem, 1rem + 0.3vw, 1.2rem);
		line-height: 1.55;
		color: var(--ds-text-secondary);
	}

	.search {
		position: relative;
		display: flex;
		align-items: center;
