---
/**
 * /features/: what Respite does, and on which device.
 *
 * Every feature row says which platforms have it, and a filter (?on=ios|android|chrome) shows only
 * one device's features. Platform facts come from src/content.ts, the privacy policies and the
 * feature posts on the blog; keep a row to what that platform's app actually does.
 */
import '../styles/info-pages.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PlanCompare from '../components/ui/PlanCompare.astro';
import JumpNav from '../components/ui/JumpNav.astro';
import FAQSchema from '../components/SEO/FAQSchema.astro';
import BreadcrumbSchema from '../components/SEO/BreadcrumbSchema.astro';

type P = 'ios' | 'android' | 'chrome';
const ALL: P[] = ['ios', 'android', 'chrome'];
const NAMES: Record<P, string> = { ios: 'iPhone', android: 'Android', chrome: 'Chrome' };

interface Feature {
	title: string;
	body: string;
	on: P[];
	plus?: 'only' | 'more';
	link?: { href: string; label: string };
}

const groups: { id: string; title: string; lead: string; features: Feature[] }[] = [
	{
		id: 'pause',
		title: 'The pause',
		lead: 'The heart of Respite: a moment between the reflex and the app.',
		features: [
			{ title: 'A pause before the apps and sites you pick', body: "A short check-in covers the app or site as it opens. Leave, or continue after a moment. On iPhone it is Apple's Screen Time shield.", on: ALL },
			{ title: 'Three ways to pause', body: 'Every time, Smart timing that spaces check-ins out, or a time budget you choose as you open the app.', on: ['ios', 'android'] },
			{ title: 'Something to think about', body: 'The pause rotates reflection questions, a short guided breathing exercise, your own usage stats, quotes and activity suggestions.', on: ['android', 'chrome'] },
		],
	},
	{
		id: 'limits',
		title: 'Limits and schedules',
		lead: 'Boundaries you set once and can keep.',
		features: [
			{ title: 'Daily limits per app or site', body: 'Choose how much time feels right; Respite gives a gentle heads-up as you get close.', on: ALL },
			{ title: "Lock it once today's time is used", body: 'An app or site stays covered for the rest of the day and opens again at midnight.', on: ALL },
			{ title: 'Schedules', body: 'Block apps during the hours you choose, with Bedtime, Work hours and Morning ready-made. A pass or snooze does not lift a running schedule.', on: ['ios', 'android'], plus: 'more', link: { href: '/blog/schedule-app-blocking-iphone-android/', label: 'How schedules work' } },
			{ title: 'Reels and Shorts blocking', body: 'Optional. On Android it uses the Accessibility service, only if you turn it on; in Chrome it blocks Shorts and Reels on the page.', on: ['android', 'chrome'] },
		],
	},
	{
		id: 'focus',
		title: 'Focus',
		lead: 'When you need an hour, not a nudge.',
		features: [
			{ title: 'Focus sessions', body: 'Block your tracked apps, or just some of them, for 15 to 90 minutes. Free sessions run up to 25 minutes. In Chrome this is focus mode.', on: ALL, plus: 'more', link: { href: '/blog/focus-session-app-iphone/', label: 'Focus sessions on iPhone' } },
			{ title: 'Live Activity and Control Center', body: 'See a running session on the Lock Screen, and start or end one from Control Center.', on: ['ios'], plus: 'only' },
		],
	},
	{
		id: 'insights',
		title: 'Insights',
		lead: 'See the pattern, not just the moment.',
		features: [
			{ title: 'Where your time goes', body: 'Per-app daily totals with weekly and monthly trends. Plus adds richer insights.', on: ALL, plus: 'more' },
			{ title: 'Home screen widgets', body: "Your streak and today's progress at a glance, plus a quick settings toggle.", on: ['android'] },
			{ title: 'Quick settings', body: "Open Respite's quick settings from the browser toolbar.", on: ['chrome'] },
		],
	},
	{
		id: 'game',
		title: 'Streaks and the game',
		lead: 'Rewards for days you keep, never for more screen time.',
		features: [
			{ title: 'Streaks', body: 'Every day you choose presence over scrolling, your streak grows, with milestone celebrations and gentle reminders. No lectures.', on: ALL },
			{ title: 'Acorns, quests and a shop', body: 'Earn acorns for kept days and for walking away at the pause, finish three daily quests, and spend acorns on your garden and Biscuit. Needs a free sign-in.', on: ['ios', 'android'], link: { href: '/blog/introducing-acorns-quests-and-leagues/', label: 'How the game works' } },
			{ title: 'Weekly leagues and friends', body: 'Optional. Others see only your display name and progress, never your apps, and you can hide from leagues at any time.', on: ['ios', 'android'], link: { href: '/blog/respite-leagues-and-friends/', label: 'What friends can see' } },
		],
	},
	{
		id: 'sync',
		title: 'Sync and AI',
		lead: 'One account across your phone and computer, if you want it.',
		features: [
			{ title: 'Sync across devices', body: 'Sign in with the same Google or Apple account on each device. A free account syncs one device; Plus syncs them all, and one limit can cover your total time.', on: ALL, plus: 'more', link: { href: '/blog/sync-respite-android-iphone-chrome/', label: 'How to sync' } },
			{ title: 'Bring your own AI', body: 'Connect Claude, ChatGPT or Cursor and ask about your real usage. It reads by default and can make limits stricter only if you opt in. Respite runs no AI of its own.', on: ALL, plus: 'only', link: { href: '/ai/', label: 'How it works' } },
		],
	},
	{
		id: 'privacy',
		title: 'Privacy',
		lead: 'Your data stays yours.',
		features: [
			{ title: 'No account needed', body: 'Everything except sync and the game works without signing in, and your history stays on your device.', on: ALL },
			{ title: 'No ads, never sold', body: 'Respite shows no ads and never sells your data. Each privacy policy lists exactly what that version collects.', on: ALL },
			{ title: 'App names stay on your iPhone', body: "Apple's Screen Time keeps the apps you pick private, even from Respite, unless you match an app for sync.", on: ['ios'] },
		],
	},
];

const counts = Object.fromEntries(ALL.map((p) => [p, groups.reduce((n, g) => n + g.features.filter((f) => f.on.includes(p)).length, 0)])) as Record<P, number>;
const total = groups.reduce((n, g) => n + g.features.length, 0);

const featureFAQs = [
	{ question: 'Is Respite free?', answer: 'Yes. Respite is free on iPhone, Android and Chrome, with no ads. The pause, usage tracking, daily limits and streaks all work without paying. An optional upgrade, Respite Plus, adds sync across your devices and extras such as more schedules, longer focus sessions and richer insights.' },
	{ question: 'Does Respite need an account?', answer: 'No. You can use Respite\'s core features without signing in. An account (Google or Apple sign-in) is only needed if you want to sync across devices with Respite Plus. Without one, your usage history stays on your device.' },
	{ question: 'Does Respite work on iPhone?', answer: "Yes. Respite is available for iPhone, Android and Chrome. The iPhone app is built on Apple's Screen Time, so the pause appears as Apple's Screen Time shield before the apps you pick. It also offers daily limits and an app lock that covers an app once today's time is used, refreshing at midnight." },
	{ question: 'How is Respite different from app blockers?', answer: 'Blockers shut an app down. Respite puts a short, gentle pause in front of the apps you pick, so you open them on purpose rather than by reflex. You can leave or continue after a moment. It also tracks your usage, keeps streaks and lets you set daily limits, so you see the pattern as well as interrupt it.' },
	{ question: 'Does Respite collect my data?', answer: "Your usage history stays on your device unless you turn on sync. Respite shows no ads and never sells your data. On iPhone, Apple's Screen Time keeps the apps you pick private, even from Respite. Each version's privacy policy lists exactly what it collects, including any anonymous analytics or crash reports." },
	{ question: 'Can I use Respite on multiple devices?', answer: 'Yes. Respite runs on iPhone, Android and Chrome, and each device works on its own with its own history and settings. If you want your progress synced across devices, the optional Respite Plus upgrade adds sync, which requires signing in with Google or Apple.' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="How Respite Works | Mindful Screen Time Features" description="Every Respite feature on iPhone, Android and Chrome: the pause, limits, schedules, focus, insights, streaks, sync and bring your own AI, and what's free." />
		<BreadcrumbSchema
			items={[
				{ name: 'Home', url: 'https://respite.liveintently.app' },
				{ name: 'Features', url: 'https://respite.liveintently.app/features/' },
			]}
		/>
		<FAQSchema faqs={featureFAQs} />
	</head>
	<body class="ip-page">
		<Header />

		<main class="ip">
			<header class="ip-head">
				<h1>What Respite does</h1>
				<p class="ip-dek">Respite puts a short, gentle pause before the apps and sites you pick, so you open them on purpose. Around it: limits you can keep, focus when you need it, and streaks instead of guilt.</p>
				<ol class="ft-how" aria-label="How it works">
					<li><strong>Notice.</strong> See which apps pull you in, within a day.</li>
					<li><strong>Pause.</strong> A moment to ask: is this what I want right now?</li>
					<li><strong>Choose.</strong> Leave or continue. Each kept day builds your streak.</li>
				</ol>
			</header>

			<JumpNav links={[...groups.map((g) => ({ href: `#${g.id}`, label: g.title })), { href: '#plans', label: 'Free or Plus' }, { href: '#faq', label: 'Questions' }]} />

			<section class="ft-filter" aria-labelledby="filter-title">
				<h2 id="filter-title" class="ft-filter-title">Show features for</h2>
				<div class="ft-seg" role="group" aria-labelledby="filter-title">
					<button type="button" data-on="all" aria-pressed="true">Every device <span>{total}</span></button>
					{ALL.map((p) => (
						<button type="button" data-on={p} aria-pressed="false">{NAMES[p]} <span>{counts[p]}</span></button>
					))}
				</div>
				<p class="ft-filter-note" id="filter-note" aria-live="polite"></p>
			</section>

			{groups.map((g) => (
				<section class="ip-section ft-group" id={g.id} aria-labelledby={`${g.id}-title`}>
					<h2 id={`${g.id}-title`}>{g.title}</h2>
					<p class="ip-lead">{g.lead}</p>
					<ul class="ft-list">
						{g.features.map((f) => (
							<li class="ft-row" data-on={f.on.join(' ')}>
								<div class="ft-text">
									<h3>
										{f.title}
										{f.plus === 'only' && <span class="ip-badge ip-badge-plus">Plus</span>}
										{f.plus === 'more' && <span class="ip-badge ip-badge-plus">More with Plus</span>}
									</h3>
									<p>{f.body}{f.link && <> <a href={f.link.href}>{f.link.label}</a></>}</p>
								</div>
								<ul class="ft-platforms" aria-label="Available on">
									{ALL.map((p) => (
										<li class={f.on.includes(p) ? 'has' : 'not'}>
											<span class="ip-visually-hidden">{f.on.includes(p) ? '' : 'Not on '}</span>{NAMES[p]}
										</li>
									))}
								</ul>
							</li>
						))}
					</ul>
				</section>
			))}

			<section class="ip-section" id="plans" aria-labelledby="plans-title">
				<h2 id="plans-title">Free or Plus?</h2>
				<p class="ip-lead">Everything above is free unless it is marked Plus. Plus raises a few limits and adds sync for every device.</p>
				<PlanCompare />
			</section>

			<section class="ip-section ip-faq" id="faq" aria-labelledby="faq-title">
				<h2 id="faq-title">Questions</h2>
				{featureFAQs.map((faq) => (
					<details>
						<summary>{faq.question}</summary>
						<p>{faq.answer}</p>
					</details>
				))}
			</section>

			<section class="ip-end" aria-labelledby="end-title" data-placement="final_cta">
				<h2 id="end-title">Try it on one app first</h2>
				<p>Pick the app you open most without meaning to, and give it a pause for a week. Free, no ads, no account needed.</p>
				<div class="ip-actions">
					<a href="/download/" class="ip-button">Download Respite</a>
					<a href="/support/" class="ip-button ip-button-quiet">Get help</a>
				</div>
			</section>
		</main>

		<Footer />

		<script>
			// Platform filter: shows one device's features, kept in ?on= so a link can point at it.
			const NAMES: Record<string, string> = { ios: 'iPhone', android: 'Android', chrome: 'Chrome' };
			const buttons = [...document.querySelectorAll<HTMLButtonElement>('.ft-seg button')];
			const rows = [...document.querySelectorAll<HTMLElement>('.ft-row')];
			const groups = [...document.querySelectorAll<HTMLElement>('.ft-group')];
			const note = document.getElementById('filter-note')!;

			function show(on: string, write: boolean) {
				buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.on === on)));
				rows.forEach((r) => (r.hidden = on !== 'all' && !(r.dataset.on ?? '').split(' ').includes(on)));
				groups.forEach((g) => (g.hidden = !g.querySelector('.ft-row:not([hidden])')));
				document.body.dataset.on = on;
				const n = rows.filter((r) => !r.hidden).length;
				note.textContent = on === 'all' ? '' : `${n} features on ${NAMES[on]}. Rows show where else each one works.`;
				if (write) {
					const url = new URL(location.href);
					if (on === 'all') url.searchParams.delete('on');
					else url.searchParams.set('on', on);
					history.replaceState(null, '', url);
				}
			}

			buttons.forEach((b) => b.addEventListener('click', () => show(b.dataset.on ?? 'all', true)));
			const initial = new URL(location.href).searchParams.get('on');
			show(initial && NAMES[initial] ? initial : 'all', false);
		</script>
	</body>
</html>

<style>
	.ft-how {
		display: grid;
		gap: 0.5rem;
		margin: 0.5rem 0 0;
		padding: 0;
		list-style: none;
		counter-reset: how;
	}

	.ft-how li {
		counter-increment: how;
		display: flex;
		gap: 0.75rem;
		align-items: baseline;
		line-height: 1.5;
		color: var(--ds-text-secondary);
	}

	.ft-how li::before {
		content: counter(how);
		flex: none;
		display: grid;
		place-items: center;
		width: 1.6rem;
		height: 1.6rem;
		border-radius: 50%;
		background: var(--ds-bg-info);
		color: var(--ds-primary);
		font-weight: 800;
		font-size: 0.85rem;
	}

	.ft-how strong {
		color: var(--ds-text-primary);
	}

	@media (min-width: 760px) {
		.ft-how {
			grid-template-columns: repeat(3, 1fr);
			gap: 1.25rem;
		}
	}

	/* Platform filter */
	.ft-filter {
		display: grid;
		gap: 0.75rem;
	}

	.ft-filter-title {
		margin: 0;
		font-size: 1rem;
		font-weight: 800;
	}

	.ft-seg {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.ft-seg button {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		min-height: 44px;
		padding: 0 1rem;
		border: 1px solid var(--ip-rule);
		border-radius: var(--ds-radius-full);
		background: transparent;
		color: var(--ds-text-secondary);
		font: inherit;
		font-weight: 700;
		cursor: pointer;
	}

	.ft-seg button span {
		font-size: 0.8rem;
		opacity: 0.75;
		font-variant-numeric: tabular-nums;
	}

	.ft-seg button:hover {
		border-color: var(--ds-primary);
		color: var(--ds-text-primary);
	}

	.ft-seg button[aria-pressed='true'] {
		background: var(--ds-primary);
		border-color: var(--ds-primary);
		color: var(--ds-on-primary);
	}

	.ft-filter-note {
		margin: 0;
		font-size: 0.9rem;
		color: var(--ds-text-secondary);
	}

	.ft-filter-note:empty {
		display: none;
	}

	/* Feature rows */
	.ft-list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--ip-rule);
	}

	.ft-row {
		display: grid;
		gap: 0.6rem;
		padding: 1.1rem 0;
		border-bottom: 1px solid var(--ip-rule);
	}

	@media (min-width: 760px) {
		.ft-row {
			grid-template-columns: 1fr auto;
			gap: 2rem;
			align-items: start;
		}
	}

	.ft-text h3 {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.25rem 0.6rem;
		margin: 0 0 0.3rem;
		font-size: 1.08rem;
	}

	.ft-text p {
		margin: 0;
		max-width: 38rem;
		line-height: 1.55;
		color: var(--ds-text-secondary);
	}

	.ft-platforms {
		display: flex;
		gap: 0.35rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.ft-platforms li {
		padding: 0.2rem 0.6rem;
		border-radius: var(--ds-radius-full);
		font-size: 0.8rem;
		font-weight: 700;
		white-space: nowrap;
	}

	.ft-platforms .has {
		background: var(--ds-bg-info);
		color: var(--ds-text-primary);
	}

	.ft-platforms .not {
		color: var(--ds-text-hint);
		text-decoration: line-through;
		text-decoration-color: color-mix(in srgb, var(--ds-text-hint) 60%, transparent);
		opacity: 0.7;
	}

	/* With a platform chosen, its chip stands out in every row. */
	:global(body[data-on='ios']) .ft-platforms li:nth-child(1).has,
	:global(body[data-on='android']) .ft-platforms li:nth-child(2).has,
	:global(body[data-on='chrome']) .ft-platforms li:nth-child(3).has {
		background: var(--ds-primary);
		color: var(--ds-on-primary);
	}
</style>
