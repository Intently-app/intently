---
/**
 * /features/: what Respite does, shown more than told. Mist styles (src/styles/info-pages.css).
 *
 * A staggered (masonry) set of cards, each at its natural height: a drawn preview of the real UI
 * or one of the site's own illustrations (decorative), a title, one line, and chips for the
 * features in that area. A device switcher (?on=ios|android|chrome)
 * hides the chips a device doesn't have, and any card left empty. Platform facts come from
 * src/content.ts, the privacy policies and the feature posts on the blog.
 */
import '../styles/info-pages.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Biscuit from '../components/ui/Biscuit.astro';
import Picture from '../components/ui/Picture.astro';
import AppShot from '../components/ui/AppShot.astro';
import PlanCompare from '../components/ui/PlanCompare.astro';
import FAQSchema from '../components/SEO/FAQSchema.astro';
import BreadcrumbSchema from '../components/SEO/BreadcrumbSchema.astro';
import { ctaForHref } from '../lib/analytics-core';

type P = 'ios' | 'android' | 'chrome';
const ALL: P[] = ['ios', 'android', 'chrome'];
const NAMES: Record<P, string> = { ios: 'iPhone', android: 'Android', chrome: 'Chrome' };

interface Chip {
	label: string;
	on: P[];
	plus?: boolean;
}

// shots: real app screens (public/images/app/, scripts/render-app-screens.mjs). `all` also stands in for a device without its own.
type Shots = { all: string } & Partial<Record<P, string>>;
const cards: { id: string; title: string; line: string; shots: Shots; chips: Chip[]; link?: { href: string; label: string } }[] = [
	{
		id: 'pause',
		title: 'A pause before the scroll',
		line: 'A moment to choose before the app opens.',
		shots: { all: 'pause-android', ios: 'pause-ios', chrome: 'pause-chrome' },
		chips: [
			{ label: 'Pause before apps and sites', on: ALL },
			{ label: 'Three ways to pause', on: ['ios', 'android'] },
			{ label: 'Breathing and questions', on: ['android', 'chrome'] },
		],
	},
	{
		id: 'focus',
		title: 'Focus when you need it',
		line: '15 to 90 minutes with your apps blocked.',
		shots: { all: 'focus' },
		chips: [
			{ label: 'Focus sessions', on: ALL, plus: true },
			{ label: 'Live Activity', on: ['ios'], plus: true },
		],
		link: { href: '/blog/focus-session-app-iphone/', label: 'About focus sessions' },
	},
	{
		id: 'limits',
		title: 'Limits you can keep',
		line: 'A heads-up as you get close.',
		shots: { all: 'limits-android', ios: 'limits-ios', chrome: 'limits-chrome' },
		chips: [
			{ label: 'Daily limits', on: ALL },
			{ label: 'Done for today lock', on: ALL },
			{ label: 'Schedules', on: ['ios', 'android'], plus: true },
			{ label: 'Reels and Shorts block', on: ['android', 'chrome'] },
		],
		link: { href: '/blog/schedule-app-blocking-iphone-android/', label: 'About schedules' },
	},
	{
		id: 'game',
		title: 'Streaks, not guilt',
		line: 'Kept days add up. Acorns reward walking away.',
		shots: { all: 'game' },
		chips: [
			{ label: 'Streaks', on: ALL },
			{ label: 'Acorns and quests', on: ['ios', 'android'] },
			{ label: 'Leagues and friends', on: ['ios', 'android'] },
		],
		link: { href: '/blog/introducing-acorns-quests-and-leagues/', label: 'How the game works' },
	},
	{
		id: 'insights',
		title: 'See where your time goes',
		line: 'Daily totals per app, with weekly and monthly trends.',
		shots: { all: 'insights-android', ios: 'insights-ios', chrome: 'insights-chrome' },
		chips: [
			{ label: 'Usage by app and day', on: ALL },
			{ label: 'Richer insights', on: ALL, plus: true },
			{ label: 'Home screen widgets', on: ['android'] },
			{ label: 'Toolbar quick settings', on: ['chrome'] },
		],
	},
	{
		id: 'sync',
		title: 'Your devices, together',
		line: 'One account on your phone and computer.',
		shots: { all: 'sync' },
		chips: [
			{ label: 'Sync one device free', on: ALL },
			{ label: 'Sync every device', on: ALL, plus: true },
		],
		link: { href: '/blog/sync-respite-android-iphone-chrome/', label: 'How to sync' },
	},
	{
		id: 'ai',
		title: 'Bring your own AI',
		line: 'Ask Claude or ChatGPT about your real usage.',
		shots: { all: 'ai' },
		chips: [{ label: 'Claude, ChatGPT, Cursor', on: ALL, plus: true }],
		link: { href: '/ai/', label: 'How it works' },
	},
	{
		id: 'privacy',
		title: 'Private by design',
		line: 'No account needed. History stays on your device.',
		shots: { all: 'privacy-android', ios: 'privacy-ios' },
		chips: [
			{ label: 'No account needed', on: ALL },
			{ label: 'No ads, never sold', on: ALL },
			{ label: 'App names stay private', on: ['ios'] },
		],
	},
];

const counts = Object.fromEntries(ALL.map((p) => [p, cards.reduce((n, c) => n + c.chips.filter((x) => x.on.includes(p)).length, 0)])) as Record<P, number>;
const total = cards.reduce((n, c) => n + c.chips.length, 0);

const featureFAQs = [
	{ question: 'Is Respite free?', answer: 'Yes. Respite is free on iPhone, Android and Chrome, with no ads. The pause, usage tracking, daily limits and streaks all work without paying. An optional upgrade, Respite Plus, adds sync across your devices and extras such as more schedules, longer focus sessions and richer insights.' },
	{ question: 'Does Respite need an account?', answer: "No. You can use Respite's core features without signing in. An account (Google or Apple sign-in) is only needed if you want to sync across devices with Respite Plus. Without one, your usage history stays on your device." },
	{ question: 'Does Respite work on iPhone?', answer: "Yes. Respite is available for iPhone, Android and Chrome. The iPhone app is built on Apple's Screen Time, so the pause appears as Apple's Screen Time shield before the apps you pick. It also offers daily limits and an app lock that covers an app once today's time is used, refreshing at midnight." },
	{ question: 'How is Respite different from app blockers?', answer: 'Blockers shut an app down. Respite puts a short, gentle pause in front of the apps you pick, so you open them on purpose rather than by reflex. You can leave or continue after a moment. It also tracks your usage, keeps streaks and lets you set daily limits, so you see the pattern as well as interrupt it.' },
	{ question: 'Does Respite collect my data?', answer: "Your usage history stays on your device unless you turn on sync. Respite shows no ads and never sells your data. On iPhone, Apple's Screen Time keeps the apps you pick private, even from Respite. Each version's privacy policy lists exactly what it collects, including any anonymous analytics or crash reports." },
	{ question: 'Can I use Respite on multiple devices?', answer: 'Yes. Respite runs on iPhone, Android and Chrome, and each device works on its own with its own history and settings. If you want your progress synced across devices, the optional Respite Plus upgrade adds sync, which requires signing in with Google or Apple.' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="How Respite Works | Mindful Screen Time Features" description="Every Respite feature on iPhone, Android and Chrome: the pause, limits, schedules, focus, insights, streaks, sync and bring your own AI, and what's free." />
		<BreadcrumbSchema
			items={[
				{ name: 'Home', url: 'https://respite.liveintently.app' },
				{ name: 'Features', url: 'https://respite.liveintently.app/features/' },
			]}
		/>
		<FAQSchema faqs={featureFAQs} />
	</head>
	<body class="m-page">
		<Header />

		<main class="m">
			<section class="ft-hero" aria-labelledby="ft-title">
				<div class="ft-biscuit" aria-hidden="true"><Biscuit mood="wave" size={120} label="Biscuit waving" /></div>
				<h1 id="ft-title">What Respite does</h1>
				<p class="m-dek">A gentle pause, limits you can keep, and streaks instead of guilt.</p>
				<div class="m-seg ft-seg" role="group" aria-label="Show features for">
					<button type="button" data-on="all" aria-pressed="true">All <span class="m-count">{total}</span></button>
					{ALL.map((p) => (
						<button type="button" data-on={p} aria-pressed="false">{NAMES[p]} <span class="m-count">{counts[p]}</span></button>
					))}
				</div>
			</section>

			<div class="ft-masonry">
				{cards.map((c) => (
					<section class="ft-card" id={c.id} aria-labelledby={`${c.id}-title`}>
						<div class="ft-shots">
							{(['all', ...ALL] as const).filter((p) => p === 'all' || c.shots[p]).map((p) => (
								<AppShot slug={c.shots[p]!} data-for={p} hidden={p !== 'all' || undefined} />
							))}
						</div>
						<div class="ft-copy">
							<h2 id={`${c.id}-title`}>{c.title}</h2>
							<p>{c.line}</p>
							<ul class="ft-chips" aria-label="Includes">
								{c.chips.map((x) => (
									<li data-on={x.on.join(' ')}>
										{x.label}
										{x.plus && <span class="ft-plus">Plus</span>}
										{x.on.length < 3 && <span class="ft-devs">{x.on.map((p) => NAMES[p]).join(', ')}</span>}
									</li>
								))}
							</ul>
							{c.link && <a class="ft-more" href={c.link.href} data-cta={ctaForHref(c.link.href)}>{c.link.label}</a>}
						</div>
					</section>
				))}
				<section class="ft-card ft-cta" aria-labelledby="cta-title" data-placement="final_cta">
					<div class="ft-art" style="aspect-ratio: 4 / 3" aria-hidden="true">
						<Picture src="/images/blog/what-is-digital-wellbeing.jpg" alt="" width={720} height={405} loading="lazy" />
					</div>
					<div class="ft-copy">
						<h2 id="cta-title">Try it on one app first</h2>
						<p>Free on iPhone, Android and Chrome. No ads, no account needed.</p>
						<a href="/download/" class="m-btn" data-cta="download">Download Respite</a>
					</div>
				</section>
			</div>
			<p class="m-caption ft-note" id="ft-note">Features without a device name work everywhere.</p>

			<section class="m-section" id="plans" aria-labelledby="plans-title">
				<div class="m-section-head">
					<h2 id="plans-title">Free, or Plus</h2>
					<p class="m-caption">Everything is free unless it says Plus</p>
				</div>
				<PlanCompare />
			</section>

			<section class="m-section" id="faq" aria-labelledby="faq-title">
				<h2 id="faq-title" class="m-h2">Questions</h2>
				<div class="m-group m-faq">
					{featureFAQs.map((faq) => (
						<details>
							<summary>{faq.question}</summary>
							<p>{faq.answer}</p>
						</details>
					))}
				</div>
			</section>

		</main>

		<Footer />

		<script>
			// Device switcher: hides the chips a device doesn't have, kept in ?on= so a link can point at it.
			const NAMES: Record<string, string> = { ios: 'iPhone', android: 'Android', chrome: 'Chrome' };
			const buttons = [...document.querySelectorAll<HTMLButtonElement>('.ft-seg button')];
			const chips = [...document.querySelectorAll<HTMLElement>('.ft-chips li')];
			const cards = [...document.querySelectorAll<HTMLElement>('.ft-card:not(.ft-cta)')];
			const note = document.getElementById('ft-note')!;

			function show(on: string, write: boolean) {
				buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.on === on)));
				chips.forEach((c) => (c.hidden = on !== 'all' && !(c.dataset.on ?? '').split(' ').includes(on)));
				cards.forEach((c) => {
					c.hidden = !c.querySelector('.ft-chips li:not([hidden])');
					// The device's own screen where there is one, otherwise the shared one.
					const shots = [...c.querySelectorAll<HTMLElement>('.ft-shots [data-for]')];
					const pick = shots.find((x) => x.dataset.for === on) ?? shots.find((x) => x.dataset.for === 'all');
					shots.forEach((x) => (x.hidden = x !== pick));
				});
				document.body.dataset.on = on;
				note.textContent = on === 'all' ? 'Features without a device name work everywhere.' : `Showing what Respite does on ${NAMES[on]}.`;
				if (write) {
					const url = new URL(location.href);
					if (on === 'all') url.searchParams.delete('on');
					else url.searchParams.set('on', on);
					history.replaceState(null, '', url);
				}
			}
			buttons.forEach((b) => b.addEventListener('click', () => show(b.dataset.on ?? 'all', true)));
			const initial = new URL(location.href).searchParams.get('on');
			show(initial && NAMES[initial] ? initial : 'all', false);
		</script>
	</body>
</html>

<style>
	/* ------------------------------------------------------------ hero: centred */
	.ft-hero {
		display: grid;
		justify-items: center;
		gap: 1rem;
		text-align: center;
	}

	.ft-biscuit {
		display: grid;
		place-items: center;
		width: 150px;
		height: 150px;
		border-radius: 50%;
		background: var(--m-accent-soft);
	}

	.ft-hero h1 {
		margin: 0.5rem 0 0;
		font-size: clamp(2.3rem, 1.6rem + 2.8vw, 3.6rem);
		font-weight: 800;
		line-height: 1.05;
		letter-spacing: -0.02em;
	}

	.ft-hero .m-dek {
		margin-bottom: 0.75rem;
	}

	.ft-seg {
		justify-content: center;
	}

	/* ------------------------------------------------------------ staggered cards */
	.ft-masonry {
		margin-top: -1.5rem;
		columns: 1;
		column-gap: 1.25rem;
	}

	@media (min-width: 680px) {
		.ft-masonry {
			columns: 2;
		}
	}

	@media (min-width: 1040px) {
		.ft-masonry {
			columns: 3;
		}
	}

	.ft-card {
		display: flex;
		flex-direction: column;
		margin: 0 0 1.25rem;
		break-inside: avoid;
		border-radius: 28px;
		background: var(--m-paper);
		box-shadow: var(--m-shadow-sm);
		overflow: hidden;
		scroll-margin-top: 6rem;
	}

	.ft-shots {
		margin: 0.6rem 0.6rem 0;
	}

	.ft-art {
		margin: 0.6rem 0.6rem 0;
		border-radius: 22px;
		overflow: hidden;
		background: var(--m-ground);
	}

	.ft-art :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.ft-copy {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.6rem;
		padding: 1.25rem 1.5rem 1.5rem;
	}

	.ft-cta .m-btn {
		margin-top: 0.4rem;
	}

	.ft-copy h2 {
		margin: 0;
		font-size: 1.45rem;
		font-weight: 800;
		line-height: 1.2;
	}

	.ft-copy > p {
		margin: 0;
		line-height: 1.5;
		color: var(--m-ink-soft);
	}

	.ft-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 0.4rem 0 0;
		padding: 0;
		list-style: none;
	}

	.ft-chips li {
		white-space: nowrap;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.35rem 0.75rem;
		border-radius: 999px;
		background: var(--m-fog);
		font-size: 0.88rem;
		font-weight: 700;
		line-height: 1.3;
	}

	.ft-devs {
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--m-ink-soft);
	}

	:global(body[data-on]:not([data-on='all'])) .ft-devs {
		display: none;
	}

	.ft-plus {
		padding: 0.05rem 0.45rem;
		border-radius: 999px;
		background: var(--m-reward-soft);
		color: var(--m-reward-ink);
		font-size: 0.75rem;
		font-weight: 800;
	}

	.ft-more {
		padding-top: 0.2rem;
		color: var(--m-accent);
		font-family: var(--font-heading);
		font-weight: 800;
		text-decoration: none;
	}

	.ft-more:hover {
		text-decoration: underline;
		text-underline-offset: 0.18em;
	}

	.ft-note {
		margin-top: -4rem;
		text-align: center;
	}
</style>
