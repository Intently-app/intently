---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/info-pages.css';
import Biscuit from '../components/ui/Biscuit.astro';
import AppIcon from '../components/ui/AppIcon.astro';
import ToolCard from '../components/ui/ToolCard.astro';
import FAQSchema from '../components/SEO/FAQSchema.astro';
import BreadcrumbSchema from '../components/SEO/BreadcrumbSchema.astro';
import HowToSchema from '../components/SEO/HowToSchema.astro';
import Icon from '../components/ui/Icon.astro';

const faqs = [
	{
		question: "How much screen time does the average person have?",
		answer: "The average adult spends about 7 hours per day on screens (including work). For personal/leisure use, studies show 3-4 hours daily on smartphones alone. Over a lifetime, that can add up to over 13 years of screen time."
	},
	{
		question: "What is the opportunity cost of screen time?",
		answer: "Opportunity cost is what you could have done with the time spent on screens. For example, 3 hours/day of social media scrolling equals 1,095 hours/year — enough to learn a new language, read 130+ books, or train for multiple marathons."
	},
	{
		question: "How accurate is this screen time calculator?",
		answer: "This calculator uses your reported daily screen time and age to estimate lifetime and future screen hours. While individual usage varies by day, the averages provide a realistic picture of cumulative impact over time."
	},
	{
		question: "How can I reduce my screen time effectively?",
		answer: "Start small: reduce by 1 hour per day using tools like Respite that create mindful pauses before opening apps. Set daily limits, create phone-free zones, replace scrolling with offline activities, and track your progress over time."
	}
];

const howToSteps = [
	{ name: "Enter your daily screen time", text: "Use the slider to set your average daily non-work screen time in hours." },
	{ name: "Enter your age details", text: "Input your current age and the age you got your first smartphone." },
	{ name: "Select your most-used apps", text: "Choose 1-5 apps that consume most of your screen time." },
	{ name: "View your lifetime screen report", text: "See your total lifetime hours on screens, app breakdown, opportunity costs, and how reducing by just 1 hour/day compounds over time." }
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Screen Time Calculator: How Much of Your Life Is on Screens?"
			description="Calculate your lifetime screen time and what it costs you. See what you could do with the hours back. Free, interactive, and nothing is stored."
		/>
		<FAQSchema faqs={faqs} />
		<BreadcrumbSchema
			items={[
				{ name: "Home", url: "https://respite.liveintently.app" },
				{ name: "Screen Time Calculator", url: "https://respite.liveintently.app/screen-time-calculator/" }
			]}
		/>
		<HowToSchema
			name="Calculate Your Lifetime Screen Time"
			description="Use this free calculator to find out how much of your life you've spent on screens and what you could do with that time instead."
			totalTime="PT2M"
			steps={howToSteps}
		/>
	</head>
	<body class="m-page">
		<Header />

		<main class="m">
			<section class="m-tool-hero" aria-labelledby="calc-title">
				<div class="m-biscuit-disc" aria-hidden="true"><Biscuit mood="read_chart" size={140} label="Biscuit reading a chart" /></div>
				<h1 id="calc-title">Screen time calculator</h1>
				<p class="m-dek">Your daily scroll, added up over a lifetime, and what an hour back is worth.</p>
				<ul class="m-pills" aria-label="Good to know">
					<li><Icon name="Clock" size={18} />30 seconds</li>
					<li><Icon name="Lock" size={18} />Nothing is stored</li>
				</ul>
			</section>

			<!-- Calculator -->
			<section class="m-tool-card calc" aria-label="Calculator">
						<div>
							<!-- Progress Bar -->
							<div class="m-tool-progress" aria-hidden="true"><span id="calc-progress"></span></div>

							<!-- Step 1: Daily Screen Time -->
							<div id="step-1" class="calc-step">
								<div class="m-tool-step">Step 1 of 3</div>
								<h2 class="m-tool-q">How many hours do you spend on your phone each day?</h2>
								<p class="step-hint">Non-work personal screen time (social media, videos, browsing, games)</p>

								<div class="slider-container">
									<div class="slider-value-display">
										<span id="hours-display" class="slider-big-number">4</span>
										<span class="slider-unit">hours/day</span>
									</div>
									<div id="weekly-display" class="slider-weekly">28 hours/week</div>
									<input
										type="range"
										id="hours-slider"
										min="1"
										max="14"
										value="4"
										step="0.5"
										class="glass-slider"
										aria-label="Daily screen time in hours"
									/>
									<div class="slider-labels">
										<span>1h</span>
										<span>7h</span>
										<span>14h</span>
									</div>
								</div>

								<button id="step1-next" class="m-btn">Continue</button>
							</div>

							<!-- Step 2: Age -->
							<div id="step-2" class="calc-step" style="display:none;">
								<div class="m-tool-step">Step 2 of 3</div>
								<h2 class="m-tool-q">Tell us about yourself</h2>

								<div class="age-inputs">
									<div class="age-field">
										<label for="current-age">Your current age</label>
										<div class="number-input-wrap">
											<button class="num-btn" data-target="current-age" data-dir="-1" aria-label="Decrease age">-</button>
											<input type="number" id="current-age" value="28" min="10" max="90" aria-label="Current age" />
											<button class="num-btn" data-target="current-age" data-dir="1" aria-label="Increase age">+</button>
										</div>
									</div>
									<div class="age-field">
										<label for="first-phone-age">Age you got your first smartphone</label>
										<div class="number-input-wrap">
											<button class="num-btn" data-target="first-phone-age" data-dir="-1" aria-label="Decrease age">-</button>
											<input type="number" id="first-phone-age" value="14" min="5" max="60" aria-label="Age of first smartphone" />
											<button class="num-btn" data-target="first-phone-age" data-dir="1" aria-label="Increase age">+</button>
										</div>
									</div>
								</div>

								<div class="step-nav">
									<button id="step2-back" class="m-btn is-soft">Back</button>
									<button id="step2-next" class="m-btn">Continue</button>
								</div>
							</div>

							<!-- Step 3: App Selection -->
							<div id="step-3" class="calc-step" style="display:none;">
								<div class="m-tool-step">Step 3 of 3</div>
								<h2 class="m-tool-q">Which apps eat most of your time?</h2>
								<p class="step-hint">Select 1-5 apps</p>

								<div class="app-grid" role="group" aria-label="Select your most-used apps">
									<button class="app-card" data-app="instagram" aria-pressed="false">
										<AppIcon app="instagram" size={40} />
										<span class="app-name">Instagram</span>
									</button>
									<button class="app-card" data-app="tiktok" aria-pressed="false">
										<AppIcon app="tiktok" size={40} />
										<span class="app-name">TikTok</span>
									</button>
									<button class="app-card" data-app="youtube" aria-pressed="false">
										<AppIcon app="youtube" size={40} />
										<span class="app-name">YouTube</span>
									</button>
									<button class="app-card" data-app="x" aria-pressed="false">
										<AppIcon app="x" size={40} />
										<span class="app-name">X / Twitter</span>
									</button>
									<button class="app-card" data-app="reddit" aria-pressed="false">
										<AppIcon app="reddit" size={40} />
										<span class="app-name">Reddit</span>
									</button>
									<button class="app-card" data-app="facebook" aria-pressed="false">
										<AppIcon app="facebook" size={40} />
										<span class="app-name">Facebook</span>
									</button>
									<button class="app-card" data-app="snapchat" aria-pressed="false">
										<AppIcon app="snapchat" size={40} />
										<span class="app-name">Snapchat</span>
									</button>
									<button class="app-card" data-app="whatsapp" aria-pressed="false">
										<AppIcon app="whatsapp" size={40} />
										<span class="app-name">WhatsApp</span>
									</button>
									<button class="app-card" data-app="netflix" aria-pressed="false">
										<AppIcon app="netflix" size={40} />
										<span class="app-name">Netflix</span>
									</button>
									<button class="app-card" data-app="spotify" aria-pressed="false">
										<AppIcon app="spotify" size={40} />
										<span class="app-name">Spotify</span>
									</button>
									<button class="app-card" data-app="games" aria-pressed="false">
										<span class="m-tile app-generic" aria-hidden="true"><Icon name="Gamepad2" size={20} /></span>
										<span class="app-name">Games</span>
									</button>
									<button class="app-card" data-app="other" aria-pressed="false">
										<span class="m-tile app-generic" aria-hidden="true"><Icon name="Smartphone" size={20} /></span>
										<span class="app-name">Other</span>
									</button>
								</div>

								<div class="step-nav">
									<button id="step3-back" class="m-btn is-soft">Back</button>
									<button id="step3-calculate" class="m-btn" disabled>See My Results</button>
								</div>
							</div>

							<!-- Results: 4 reveal cards -->
							<div id="results-container" style="display:none;">

								<!-- Card 1: Lifetime -->
								<div class="reveal-card" id="card-lifetime">
									<div class="reveal-overline">Your Lifetime on Screens</div>
									<div class="big-stat">
										<span id="lifetime-hours" class="count-up" data-value="0">0</span>
										<span class="big-stat-unit">hours</span>
									</div>
									<div class="stat-row">
										<div class="stat-pill">
											<span class="stat-pill-value" id="lifetime-days">0</span>
											<span class="stat-pill-label">days</span>
										</div>
										<div class="stat-pill">
											<span class="stat-pill-value" id="lifetime-years">0</span>
											<span class="stat-pill-label">years</span>
										</div>
									</div>
									<div class="comparison-text" id="comparison-text"></div>
									<button class="m-btn reveal-next-btn" data-next="card-breakdown">Next</button>
								</div>

								<!-- Card 2: App Breakdown -->
								<div class="reveal-card" id="card-breakdown" style="display:none;">
									<div class="reveal-overline">Your App Breakdown</div>
									<div id="breakdown-bars" class="breakdown-bars"></div>
									<div id="breakdown-pills" class="breakdown-pills"></div>
									<button class="m-btn reveal-next-btn" data-next="card-opportunity">Next</button>
								</div>

								<!-- Card 3: Opportunity Cost -->
								<div class="reveal-card" id="card-opportunity" style="display:none;">
									<div class="reveal-overline">The Compound Effect</div>
									<p class="opportunity-intro">Instead of <strong id="opp-hours">0</strong> hours on your phone, you could have...</p>
									<div id="opportunity-list" class="opportunity-list"></div>
									<button class="m-btn reveal-next-btn" data-next="card-pledge">Next</button>
								</div>

								<!-- Card 4: 1-Hour Pledge CTA -->
								<div class="reveal-card" id="card-pledge" style="display:none;">
									<div class="reveal-overline">The 1-Hour Pledge</div>
									<p class="pledge-intro">What if you reduced screen time by just <strong>1 hour per day</strong>?</p>
									<div class="pledge-grid">
										<div class="pledge-item">
											<span class="pledge-period">1 Year</span>
											<span class="pledge-value" id="pledge-1y">0</span>
											<span class="pledge-unit">hours saved</span>
										</div>
										<div class="pledge-item">
											<span class="pledge-period">5 Years</span>
											<span class="pledge-value" id="pledge-5y">0</span>
											<span class="pledge-unit">hours saved</span>
										</div>
										<div class="pledge-item">
											<span class="pledge-period">10 Years</span>
											<span class="pledge-value" id="pledge-10y">0</span>
											<span class="pledge-unit">hours saved</span>
										</div>
									</div>

									<button class="m-btn reveal-next-btn" data-next="card-report">See my report card</button>
								</div>

								<!-- Card 5: the report card to share (src/lib/report-card.ts) -->
								<div class="reveal-card" id="card-report" style="display:none;">
									<div class="reveal-overline">Your report card</div>
									<figure id="report-card" class="m-reportcard" role="img" aria-label="Your screen time report card"></figure>

									<div class="share-section" data-placement="result">
										<button id="share-native" class="m-btn share-main" hidden><Icon name="Share2" size={20} />Share my card</button>
										<div class="share-row">
											<button id="share-download" class="m-btn is-soft share-btn"><Icon name="Download" size={22} />Save image</button>
											<button id="share-copy" class="m-btn is-soft share-btn"><Icon name="Link" size={22} /><span>Copy link</span></button>
											<button id="share-twitter" class="m-btn is-soft share-btn" aria-label="Share on X / Twitter"><span class="share-x" aria-hidden="true">𝕏</span>Post</button>
										</div>
									</div>

									<div class="m-actions calc-cta" data-placement="result">
										<a href="/download/" class="m-btn" data-cta="download">Try Respite on one app</a>
										<a href="/app-addiction-score/" class="m-btn is-soft" data-cta="addiction_score">Score your apps</a>
									</div>

									<button id="retake-calc" class="m-tool-retake">Start Over</button>
								</div>
							</div>
						</div>
			</section>

			<section class="m-section" aria-labelledby="more-title">
				<h2 id="more-title" class="m-h2">More free tools</h2>
				<div class="m-tool-more">
					<ToolCard id="quiz" />
					<ToolCard id="score" />
				</div>
			</section>

			<section class="m-section" aria-labelledby="faq-title">
				<h2 id="faq-title" class="m-h2">Questions</h2>
				<div class="m-group m-faq">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.question}</summary>
							<p>{faq.answer}</p>
						</details>
					))}
				</div>
				<p class="m-caption">Everything is worked out in your browser; nothing is sent or stored. Learn more about <a href="/blog/what-is-digital-wellbeing/">digital wellbeing</a>, explore the <a href="/blog/psychology-of-app-addiction/">psychology of app addiction</a>, or <a href="/download/">download Respite free</a> to take control of your screen time.</p>
			</section>
		</main>

		<Footer />

		<script>
			import { calculatorBand, toolCompleteParams, toolShareParams, track } from '../lib/analytics';
			import { cardQuery, cardSentence, cardStats, cardSvg, normalize, SIZES, type CardInput, type Theme } from '../lib/report-card';
			import { ART } from '../lib/report-card-art';

			// ===== STATE =====
			let dailyHours = 4;
			let currentAge = 28;
			let firstPhoneAge = 14;
			const selectedApps: string[] = [];

			const appWeights: Record<string, number> = {
				instagram: 18, tiktok: 22, youtube: 20, x: 10, reddit: 12,
				facebook: 14, snapchat: 8, whatsapp: 6, netflix: 16, spotify: 4,
				games: 15, other: 10
			};

			const appLabels: Record<string, string> = {
				instagram: 'Instagram', tiktok: 'TikTok', youtube: 'YouTube',
				x: 'X / Twitter', reddit: 'Reddit', facebook: 'Facebook',
				snapchat: 'Snapchat', whatsapp: 'WhatsApp', netflix: 'Netflix',
				spotify: 'Spotify', games: 'Games', other: 'Other'
			};

			const appColors: Record<string, string> = {
				instagram: '#E1306C', tiktok: '#00f2ea', youtube: '#FF0000',
				x: '#1DA1F2', reddit: '#FF4500', facebook: '#1877F2',
				snapchat: '#FFFC00', whatsapp: '#25D366', netflix: '#E50914',
				spotify: '#1DB954', games: 'var(--ds-purple)', other: '#757575'
			};

			const opportunityCosts = [
				{ label: 'Learn a new language', hours: 600, emoji: '🌍' },
				{ label: 'Read books', hours: 8, emoji: '📚', perUnit: true, unitLabel: 'books' },
				{ label: 'Run marathons (training)', hours: 200, emoji: '🏃', perUnit: true, unitLabel: 'marathons' },
				{ label: 'Learn to play guitar', hours: 300, emoji: '🎸' },
				{ label: 'Get a pilot\'s license', hours: 80, emoji: '✈️' },
				{ label: 'Write novels', hours: 500, emoji: '✍️', perUnit: true, unitLabel: 'novels' },
				{ label: 'Complete online degrees', hours: 1200, emoji: '🎓', perUnit: true, unitLabel: 'degrees' },
				{ label: 'Cook every recipe in a cookbook', hours: 150, emoji: '👨‍🍳' },
			];

			const comparisons = [
				{ threshold: 50000, text: (h: number) => `That's ${Math.round(h / 24 / 365 * 10) / 10} years — longer than some people's careers` },
				{ threshold: 30000, text: (h: number) => `That's ${Math.round(h / 5.5)} round trips from New York to Tokyo` },
				{ threshold: 15000, text: (h: number) => `That's ${Math.round(h / 2)} feature-length movies` },
				{ threshold: 5000, text: (h: number) => `That's ${Math.round(h / 24)} full days without sleep` },
				{ threshold: 0, text: (h: number) => `That's ${Math.round(h / 24)} full days of your life` },
			];

			// ===== SLIDER =====
			const slider = document.getElementById('hours-slider') as HTMLInputElement;
			const hoursDisplay = document.getElementById('hours-display')!;
			const weeklyDisplay = document.getElementById('weekly-display')!;

			function updateSliderColor() {
				const val = parseFloat(slider.value);
				const pct = ((val - 1) / 13) * 100;
				let color: string;
				if (val <= 3) color = 'var(--ds-green)';
				else if (val <= 6) color = 'var(--ds-orange)';
				else color = 'var(--ds-red)';
				slider.style.setProperty('--slider-pct', `${pct}%`);
				slider.style.setProperty('--slider-color', color);
			}

			slider.addEventListener('input', () => {
				dailyHours = parseFloat(slider.value);
				hoursDisplay.textContent = dailyHours % 1 === 0 ? dailyHours.toString() : dailyHours.toFixed(1);
				weeklyDisplay.textContent = `${Math.round(dailyHours * 7)} hours/week`;
				updateSliderColor();
			});
			updateSliderColor();

			// ===== NUMBER INPUTS =====
			document.querySelectorAll('.num-btn').forEach(btn => {
				btn.addEventListener('click', () => {
					const target = document.getElementById((btn as HTMLElement).dataset.target!) as HTMLInputElement;
					const dir = parseInt((btn as HTMLElement).dataset.dir!);
					const newVal = Math.min(Math.max(parseInt(target.value) + dir, parseInt(target.min)), parseInt(target.max));
					target.value = newVal.toString();
					if (target.id === 'current-age') currentAge = newVal;
					else firstPhoneAge = newVal;
				});
			});

			document.getElementById('current-age')!.addEventListener('change', (e) => {
				currentAge = parseInt((e.target as HTMLInputElement).value);
			});
			document.getElementById('first-phone-age')!.addEventListener('change', (e) => {
				firstPhoneAge = parseInt((e.target as HTMLInputElement).value);
			});

			// ===== APP SELECTION =====
			document.querySelectorAll('.app-card').forEach(card => {
				card.addEventListener('click', () => {
					const app = (card as HTMLElement).dataset.app!;
					const idx = selectedApps.indexOf(app);
					if (idx > -1) {
						selectedApps.splice(idx, 1);
						card.classList.remove('selected');
						card.setAttribute('aria-pressed', 'false');
					} else if (selectedApps.length < 5) {
						selectedApps.push(app);
						card.classList.add('selected');
						card.setAttribute('aria-pressed', 'true');
					}
					const calcBtn = document.getElementById('step3-calculate') as HTMLButtonElement;
					calcBtn.disabled = selectedApps.length === 0;
				});
			});

			// ===== NAVIGATION =====
			function showStep(n: number) {
				[1, 2, 3].forEach(i => {
					const el = document.getElementById(`step-${i}`);
					if (el) el.style.display = i === n ? '' : 'none';
				});
				const progress = document.getElementById('calc-progress')!;
				progress.style.width = `${(n / 3) * 100}%`;
			}

			document.getElementById('step1-next')!.addEventListener('click', () => showStep(2));
			document.getElementById('step2-back')!.addEventListener('click', () => showStep(1));
			document.getElementById('step2-next')!.addEventListener('click', () => showStep(3));
			document.getElementById('step3-back')!.addEventListener('click', () => showStep(2));
			document.getElementById('step3-calculate')!.addEventListener('click', () => calculate());

			// ===== CALCULATE =====
			// restored: the result comes back from a link (#…), so it isn't a new tool_complete.
			function calculate(restored = false) {
				// The inputs as the controls allow them (an emptied or out-of-range age field included).
				const input = normalize({ h: dailyHours, age: currentAge, first: firstPhoneAge });
				const { lifetimeHours } = cardStats(input);
				const lifetimeDays = Math.round(lifetimeHours / 24);
				const lifetimeYears = (lifetimeHours / 8760).toFixed(1);

				// Hide steps, show results
				[1, 2, 3].forEach(i => {
					const el = document.getElementById(`step-${i}`);
					if (el) el.style.display = 'none';
				});
				document.getElementById('calc-progress')!.style.width = '100%';
				document.getElementById('results-container')!.style.display = '';
				document.querySelectorAll<HTMLElement>('.reveal-card').forEach((card, i) => { card.style.display = i === 0 ? '' : 'none'; });
				// Only a wide band of daily hours, never the hours or ages entered.
				if (!restored) track('tool_complete', toolCompleteParams('calculator', calculatorBand(input.h)));

				// Card 1: Lifetime
				animateCountUp('lifetime-hours', lifetimeHours);
				document.getElementById('lifetime-days')!.textContent = lifetimeDays.toLocaleString();
				document.getElementById('lifetime-years')!.textContent = lifetimeYears;

				const comp = comparisons.find(c => lifetimeHours >= c.threshold) || comparisons[comparisons.length - 1];
				document.getElementById('comparison-text')!.textContent = comp.text(lifetimeHours);

				// Card 2: Breakdown
				const totalWeight = selectedApps.reduce((s, a) => s + (appWeights[a] || 10), 0);
				const breakdownBars = document.getElementById('breakdown-bars')!;
				const breakdownPills = document.getElementById('breakdown-pills')!;
				breakdownBars.innerHTML = '';
				breakdownPills.innerHTML = '';

				const barContainer = document.createElement('div');
				barContainer.className = 'stacked-bar';
				selectedApps.forEach(app => {
					const pct = ((appWeights[app] || 10) / totalWeight) * 100;
					const seg = document.createElement('div');
					seg.className = 'bar-segment';
					seg.style.width = `${pct}%`;
					seg.style.background = appColors[app] || '#757575';
					seg.title = `${appLabels[app]}: ${Math.round(pct)}%`;
					barContainer.appendChild(seg);
				});
				breakdownBars.appendChild(barContainer);

				selectedApps.forEach((app, i) => {
					const pct = ((appWeights[app] || 10) / totalWeight) * 100;
					const hrs = Math.round(lifetimeHours * pct / 100);
					const pill = document.createElement('div');
					pill.className = 'breakdown-pill';
					pill.style.animationDelay = `${i * 0.15}s`;
					pill.innerHTML = `
						<span class="bp-dot" style="background:${appColors[app]}"></span>
						<span class="bp-name">${appLabels[app]}</span>
						<span class="bp-stat">${hrs.toLocaleString()} hrs (${Math.round(pct)}%)</span>
					`;
					breakdownPills.appendChild(pill);
				});

				// Card 3: Opportunity
				document.getElementById('opp-hours')!.textContent = lifetimeHours.toLocaleString();
				const oppList = document.getElementById('opportunity-list')!;
				oppList.innerHTML = '';
				opportunityCosts.forEach((item, i) => {
					const count = Math.floor(lifetimeHours / item.hours);
					if (count < 1) return;
					const el = document.createElement('div');
					el.className = 'opp-item';
					el.style.animationDelay = `${i * 0.12}s`;
					if (item.perUnit) {
						el.innerHTML = `<span class="opp-emoji">${item.emoji}</span><span class="opp-text">${item.label.replace(/s$/, '')} <strong>${count}</strong> ${item.unitLabel}</span>`;
					} else {
						el.innerHTML = `<span class="opp-emoji">${item.emoji}</span><span class="opp-text">${item.label} <strong>${count}x</strong></span>`;
					}
					oppList.appendChild(el);
				});

				// Card 4: Pledge
				document.getElementById('pledge-1y')!.textContent = (365).toLocaleString();
				document.getElementById('pledge-5y')!.textContent = (365 * 5).toLocaleString();
				document.getElementById('pledge-10y')!.textContent = (365 * 10).toLocaleString();

				// URL hash, so a reload keeps the result (d, age, first: the inputs, for the report card)
				const appCodes = selectedApps.join(',');
				const hash = `#h=${lifetimeHours}&y=${lifetimeYears}&apps=${appCodes}&d=${input.h}&age=${input.age}&first=${input.first}`;
				history.replaceState(null, '', hash);

				// Card 5: the report card
				showReport(input);
			}

			// ===== COUNT-UP ANIMATION =====
			function animateCountUp(id: string, target: number) {
				const el = document.getElementById(id)!;
				const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				if (prefersReducedMotion) {
					el.textContent = target.toLocaleString();
					return;
				}
				const duration = 2000;
				const start = performance.now();
				function tick(now: number) {
					const progress = Math.min((now - start) / duration, 1);
					const eased = 1 - Math.pow(1 - progress, 3);
					el.textContent = Math.floor(target * eased).toLocaleString();
					if (progress < 1) requestAnimationFrame(tick);
				}
				requestAnimationFrame(tick);
			}

			// ===== REVEAL CARD NAVIGATION =====
			document.querySelectorAll('.reveal-next-btn').forEach(btn => {
				btn.addEventListener('click', () => {
					const nextId = (btn as HTMLElement).dataset.next!;
					(btn.closest('.reveal-card') as HTMLElement).style.display = 'none';
					document.getElementById(nextId)!.style.display = '';
				});
			});

			// ===== REPORT CARD =====
			// Drawn from the inputs (src/lib/report-card.ts), shown in both themes, and turned into a PNG in
			// the browser for the share sheet and "Save image". Nothing leaves the device unless shared.
			const reportFig = document.getElementById('report-card')!;
			const nativeBtn = document.getElementById('share-native') as HTMLButtonElement;
			const downloadBtn = document.getElementById('share-download') as HTMLButtonElement;
			const darkQuery = window.matchMedia('(prefers-color-scheme: dark)');
			const FILE_NAME = 'my-screen-time-report.png';
			let cardInput: CardInput | null = null;
			let cardPng: Promise<File> | null = null;
			let cardFile: File | null = null;

			function showReport(input: CardInput | null) {
				cardInput = input;
				cardPng = null;
				cardFile = null;
				// A result restored from an older link has no inputs: no card, the link still shares.
				reportFig.hidden = !input;
				downloadBtn.hidden = !input;
				nativeBtn.hidden = typeof navigator.share !== 'function';
				if (!input) return;
				reportFig.setAttribute('aria-label', cardSentence(input));
				reportFig.innerHTML =
					`<div class="is-light">${cardSvg(input, { format: 'post', theme: 'light', art: ART, idPrefix: 'cl-' })}</div>` +
					`<div class="is-dark">${cardSvg(input, { format: 'post', theme: 'dark', art: ART, idPrefix: 'cd-' })}</div>`;
				// Ready before the tap: a share sheet must open straight from the tap, with no wait in between.
				preparePng();
			}

			function preparePng() {
				if (!cardInput) return;
				const input = cardInput;
				const png = makePng(input, darkQuery.matches ? 'dark' : 'light').then((blob) => new File([blob], FILE_NAME, { type: 'image/png' }));
				cardPng = png;
				png.then((file) => { if (cardPng === png) cardFile = file; }).catch(() => {});
			}
			darkQuery.addEventListener('change', preparePng);

			// The page's fonts can't reach an SVG drawn as an image, so the card's two are embedded.
			let fontCss: Promise<string> | null = null;
			function loadFontCss(): Promise<string> {
				fontCss ??= Promise.all([700, 800].map(async (weight) => {
					const res = await fetch(`/fonts/card/nunito-${weight}.ttf`);
					if (!res.ok) throw new Error(`font ${res.status}`);
					const bytes = new Uint8Array(await res.arrayBuffer());
					let bin = '';
					for (let i = 0; i < bytes.length; i += 0x8000) bin += String.fromCharCode(...bytes.subarray(i, i + 0x8000));
					return `@font-face{font-family:Nunito;font-weight:${weight};src:url(data:font/ttf;base64,${btoa(bin)}) format("truetype")}`;
				})).then((rules) => rules.join(''), (e) => { fontCss = null; throw e; });
				return fontCss;
			}

			async function makePng(input: CardInput, theme: Theme): Promise<Blob> {
				const { w, h } = SIZES.post;
				const svg = cardSvg(input, { format: 'post', theme, art: ART, idPrefix: 'png-', fontCss: await loadFontCss() });
				const img = new Image(w, h);
				img.src = `data:image/svg+xml;charset=utf-8,${encodeURIComponent(svg)}`;
				await img.decode();
				// Give the embedded fonts a frame to apply (Safari can draw the first frame without them).
				await new Promise((r) => requestAnimationFrame(() => r(null)));
				const canvas = document.createElement('canvas');
				canvas.width = w;
				canvas.height = h;
				canvas.getContext('2d')!.drawImage(img, 0, 0, w, h);
				return new Promise((resolve, reject) => canvas.toBlob((b) => (b ? resolve(b) : reject(new Error('toBlob'))), 'image/png'));
			}

			// ===== SHARE =====
			// The link to share: the result page, whose preview is the card. Only the three inputs ride in it.
			function shareUrl(): string {
				return cardInput ? `${location.origin}/screen-time-calculator/r/?${cardQuery(cardInput)}` : location.href;
			}

			const shareText = () => (cardInput ? `${cardSentence(cardInput)} Work out yours:` : 'My screen time, added up. Work out yours:');
			const aborted = (e: unknown) => e instanceof DOMException && e.name === 'AbortError';

			async function copyLink(): Promise<boolean> {
				try {
					await navigator.clipboard.writeText(shareUrl());
				} catch {
					return false;
				}
				track('share', toolShareParams('copy_link', 'calculator'));
				const label = document.querySelector('#share-copy span')!;
				label.textContent = 'Copied';
				setTimeout(() => { label.textContent = 'Copy link'; }, 2000);
				return true;
			}

			nativeBtn.addEventListener('click', async () => {
				const url = shareUrl();
				const file = cardFile;
				try {
					if (file && navigator.canShare?.({ files: [file] })) {
						// The picture, with the link in the text (some apps drop a separate url next to a file).
						await navigator.share({ files: [file], title: 'My screen time report', text: `${shareText()} ${url}` });
						track('share', toolShareParams('native_image', 'calculator'));
					} else {
						await navigator.share({ title: 'My screen time report', text: shareText(), url });
						track('share', toolShareParams('native_link', 'calculator'));
					}
				} catch (e) {
					if (!aborted(e)) await copyLink();
				}
			});

			downloadBtn.addEventListener('click', async () => {
				if (!cardInput) return;
				if (!cardPng) preparePng();
				let file: File;
				try {
					file = cardFile ?? (await cardPng!);
				} catch {
					return;
				}
				const href = URL.createObjectURL(file);
				const a = Object.assign(document.createElement('a'), { href, download: FILE_NAME });
				document.body.append(a);
				a.click();
				a.remove();
				setTimeout(() => URL.revokeObjectURL(href), 10_000);
				track('share', toolShareParams('download', 'calculator'));
			});

			document.getElementById('share-copy')!.addEventListener('click', () => { copyLink(); });

			document.getElementById('share-twitter')!.addEventListener('click', () => {
				const text = encodeURIComponent(`${shareText()}\n`);
				const url = encodeURIComponent(shareUrl());
				track('share', toolShareParams('x', 'calculator'));
				window.open(`https://twitter.com/intent/tweet?text=${text}&url=${url}`, '_blank', 'noopener');
			});

			// ===== RETAKE =====
			document.getElementById('retake-calc')!.addEventListener('click', () => {
				document.getElementById('results-container')!.style.display = 'none';
				showReport(null);
				selectedApps.length = 0;
				document.querySelectorAll('.app-card').forEach(c => {
					c.classList.remove('selected');
					c.setAttribute('aria-pressed', 'false');
				});
				(document.getElementById('step3-calculate') as HTMLButtonElement).disabled = true;
				showStep(1);
				history.replaceState(null, '', window.location.pathname);
			});

			// ===== RESTORE FROM HASH =====
			function restoreFromHash() {
				const hash = window.location.hash;
				if (!hash || !hash.includes('h=')) return;
				const params = new URLSearchParams(hash.slice(1));
				const restoredApps = (params.get('apps') || '').split(',').filter((app) => appLabels[app]);
				// Links from now on carry the inputs: set the controls and work the result out again.
				const d = parseFloat(params.get('d') ?? '');
				const age = parseInt(params.get('age') ?? '');
				const first = parseInt(params.get('first') ?? '');
				if (restoredApps.length && Number.isFinite(d) && Number.isFinite(age) && Number.isFinite(first)) {
					({ h: dailyHours, age: currentAge, first: firstPhoneAge } = normalize({ h: d, age, first }));
					slider.value = String(dailyHours);
					slider.dispatchEvent(new Event('input'));
					(document.getElementById('current-age') as HTMLInputElement).value = String(currentAge);
					(document.getElementById('first-phone-age') as HTMLInputElement).value = String(firstPhoneAge);
					restoredApps.slice(0, 5).forEach((app) => {
						selectedApps.push(app);
						const card = document.querySelector(`[data-app="${app}"]`);
						card?.classList.add('selected');
						card?.setAttribute('aria-pressed', 'true');
					});
					(document.getElementById('step3-calculate') as HTMLButtonElement).disabled = false;
					calculate(true);
					return;
				}

				// Older links: only the totals.
				const h = parseInt(params.get('h') || '0');
				const y = params.get('y') || '0';
				const apps = (params.get('apps') || '').split(',').filter(Boolean);
				if (!h || apps.length === 0) return;

				// Set app selections
				apps.forEach(app => {
					if (appLabels[app]) {
						selectedApps.push(app);
						const card = document.querySelector(`[data-app="${app}"]`);
						if (card) {
							card.classList.add('selected');
							card.setAttribute('aria-pressed', 'true');
						}
					}
				});

				// Calculate with defaults (we don't have the exact inputs from hash, just the result)
				// Show results directly
				[1, 2, 3].forEach(i => {
					const el = document.getElementById(`step-${i}`);
					if (el) el.style.display = 'none';
				});
				document.getElementById('calc-progress')!.style.width = '100%';
				document.getElementById('results-container')!.style.display = '';

				const lifetimeHours = h;
				const lifetimeDays = Math.round(h / 24);
				const lifetimeYears = y;

				document.getElementById('lifetime-hours')!.textContent = lifetimeHours.toLocaleString();
				document.getElementById('lifetime-days')!.textContent = lifetimeDays.toLocaleString();
				document.getElementById('lifetime-years')!.textContent = lifetimeYears;

				const comp = comparisons.find(c => lifetimeHours >= c.threshold) || comparisons[comparisons.length - 1];
				document.getElementById('comparison-text')!.textContent = comp.text(lifetimeHours);

				// Breakdown
				const totalWeight = selectedApps.reduce((s, a) => s + (appWeights[a] || 10), 0);
				const breakdownBars = document.getElementById('breakdown-bars')!;
				const breakdownPills = document.getElementById('breakdown-pills')!;
				breakdownBars.innerHTML = '';
				breakdownPills.innerHTML = '';
				const barContainer = document.createElement('div');
				barContainer.className = 'stacked-bar';
				selectedApps.forEach(app => {
					const pct = ((appWeights[app] || 10) / totalWeight) * 100;
					const seg = document.createElement('div');
					seg.className = 'bar-segment';
					seg.style.width = `${pct}%`;
					seg.style.background = appColors[app] || '#757575';
					barContainer.appendChild(seg);
				});
				breakdownBars.appendChild(barContainer);
				selectedApps.forEach((app, i) => {
					const pct = ((appWeights[app] || 10) / totalWeight) * 100;
					const hrs = Math.round(lifetimeHours * pct / 100);
					const pill = document.createElement('div');
					pill.className = 'breakdown-pill';
					pill.innerHTML = `<span class="bp-dot" style="background:${appColors[app]}"></span><span class="bp-name">${appLabels[app]}</span><span class="bp-stat">${hrs.toLocaleString()} hrs</span>`;
					breakdownPills.appendChild(pill);
				});

				// Opportunity
				document.getElementById('opp-hours')!.textContent = lifetimeHours.toLocaleString();
				const oppList = document.getElementById('opportunity-list')!;
				oppList.innerHTML = '';
				opportunityCosts.forEach((item) => {
					const count = Math.floor(lifetimeHours / item.hours);
					if (count < 1) return;
					const el = document.createElement('div');
					el.className = 'opp-item';
					if (item.perUnit) {
						el.innerHTML = `<span class="opp-emoji">${item.emoji}</span><span class="opp-text">${item.label.replace(/s$/, '')} <strong>${count}</strong> ${item.unitLabel}</span>`;
					} else {
						el.innerHTML = `<span class="opp-emoji">${item.emoji}</span><span class="opp-text">${item.label} <strong>${count}x</strong></span>`;
					}
					oppList.appendChild(el);
				});

				// Pledge
				document.getElementById('pledge-1y')!.textContent = (365).toLocaleString();
				document.getElementById('pledge-5y')!.textContent = (1825).toLocaleString();
				document.getElementById('pledge-10y')!.textContent = (3650).toLocaleString();

				showReport(null);
			}

			restoreFromHash();
		</script>
	</body>
</html>

