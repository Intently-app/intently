---
/**
 * The home page. Mist styles (src/styles/info-pages.css) plus the hm-* rules below.
 *
 * Shown more than told: a drawn pause screen in the hero, three steps with small drawings, the
 * before/after pairs as one grouped surface, the feature areas as the blog's own illustrations,
 * then where to get it, privacy, the free tools, the latest posts and questions. Platform facts
 * come from src/content.ts, the privacy policies and /features/: change them together.
 */
import '../styles/info-pages.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/ui/Icon.astro';
import Biscuit from '../components/ui/Biscuit.astro';
import Picture from '../components/ui/Picture.astro';
import StoreButton from '../components/ui/StoreButton.astro';
import WebSiteSchema from '../components/SEO/WebSiteSchema.astro';
import ProductSchema from '../components/SEO/ProductSchema.astro';
import FAQSchema from '../components/SEO/FAQSchema.astro';
import { getPublishedPosts } from '../lib/posts';
import { app } from '@intently/registry';

const r = app('respite');

const homeFaqs = [
	{ question: "Is Respite free?", answer: "Yes. Respite is free on iPhone, Android and Chrome, with no ads. The pause, usage tracking, daily limits and streaks all work without paying. An optional upgrade, Respite Plus, adds sync across your devices and extras such as more schedules, longer focus sessions and richer insights." },
	{ question: "Does Respite need an account?", answer: "No. The core features work without signing in. You only need an account (Google or Apple sign-in) if you want to sync across devices with Respite Plus. Without one, your usage history stays on your device." },
	{ question: "Does Respite work on iPhone?", answer: "Yes. Respite is available for iPhone, Android and Chrome. The iPhone app is built on Apple's Screen Time, so the pause appears as Apple's Screen Time shield before the apps you pick, with daily limits and an app lock that refreshes at midnight." },
	{ question: "How is Respite different from app blockers?", answer: "Blockers shut an app down. Respite puts a short, gentle pause in front of the apps you pick, so you open them on purpose instead of by reflex. You can leave or continue after a moment, and Respite also tracks usage, keeps streaks and lets you set daily limits." },
	{ question: "Does Respite collect my data?", answer: "Your usage history stays on your device unless you turn on sync. Respite shows no ads and never sells your data. On iPhone, Apple's Screen Time keeps the apps you pick private, even from Respite. Each version's privacy policy lists exactly what it collects." },
];

const steps = [
	{ title: 'Pick your apps', line: 'Choose the ones that eat your day.' },
	{ title: 'Get a short pause', line: 'A moment before they open.' },
	{ title: 'Choose', line: 'Leave, or carry on, on purpose.' },
];

const pairs = [
	{ before: { icon: 'AlarmClock', text: '“Five more minutes” becomes an hour' }, after: { icon: 'Hand', text: 'You catch it before the spiral' } },
	{ before: { icon: 'Moon', text: 'Evenings lost to the feed' }, after: { icon: 'BookOpen', text: 'Evenings for books, walks and people' } },
	{ before: { icon: 'Bell', text: 'Waking up straight into notifications' }, after: { icon: 'Sun', text: 'Mornings on your own terms' } },
	{ before: { icon: 'Frown', text: 'Guilty, but unable to stop' }, after: { icon: 'Trophy', text: 'Proud of small wins that add up' } },
];

// The blog's own illustrations (public/images/blog/), each linking to the matching part of /features/.
const areas = [
	{ title: 'Limits and schedules', line: 'Daily limits and quiet hours you can keep.', art: 'schedule-app-blocking-iphone-android', href: '/features/#limits' },
	{ title: 'Focus sessions', line: 'Block your apps for 15 to 90 minutes.', art: 'focus-session-app-iphone', href: '/features/#focus' },
	{ title: 'Streaks and acorns', line: 'Kept days add up. Walking away earns acorns.', art: 'introducing-acorns-quests-and-leagues', href: '/features/#game' },
	{ title: 'Insights', line: 'Time per app, by day, week and month.', art: 'how-much-screen-time-is-too-much', href: '/features/#insights' },
	{ title: 'Sync', line: 'One account on your phone and computer.', art: 'sync-respite-android-iphone-chrome', href: '/features/#sync' },
	{ title: 'Bring your own AI', line: 'Ask Claude or ChatGPT about your real usage.', art: 'bring-your-own-ai-to-respite', href: '/ai/', plus: true },
];

const devices = [
	{ id: 'ios', name: 'iPhone', icon: 'Smartphone', needs: 'iOS 17.4 or later', store: 'appstore' as const, href: r.stores.appStore!, chips: ['Built on Screen Time', 'Three ways to pause', 'App lock at your limit'] },
	{ id: 'android', name: 'Android', icon: 'Smartphone', needs: 'Android 8.0 or later', store: 'playstore' as const, href: r.stores.play!, chips: ['Pause before apps', 'Reels and Shorts block', 'Home screen widgets'] },
	{ id: 'chrome', name: 'Chrome', icon: 'Monitor', needs: 'On your computer', store: 'chromestore' as const, href: r.stores.chrome!, chips: ['Pause before sites', 'Focus mode', 'Time per website'] },
];

const tools = [
	{ icon: 'ClipboardList', title: 'Phone addiction quiz', line: '8 questions, a clear next step.', href: '/quiz/' },
	{ icon: 'Calculator', title: 'Screen time calculator', line: 'Your daily scroll, over a lifetime.', href: '/screen-time-calculator/' },
	{ icon: 'Gauge', title: 'App addiction score', line: 'How hard your apps pull, scored.', href: '/app-addiction-score/' },
];

const latestPosts = (await getPublishedPosts())
	.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
	.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Respite: Free Screen Time App for iPhone, Android & Chrome"
			description="Stop losing hours to mindless scrolling. Respite adds a gentle pause before distracting apps open, so you choose what matters. Free, private, no ads."
		/>
		<WebSiteSchema />
		<ProductSchema
			name="Respite for iPhone"
			description="Privacy-first screen time app built on Apple's Screen Time. A pause before the apps you pick, daily limits and an app lock. Free, no ads, account optional."
			platform="ios"
			downloadUrl="https://apps.apple.com/us/app/respite-screen-time-control/id6757760293"
		/>
		<ProductSchema
			name="Respite for Android"
			description="Free privacy-first screen time app. Mindful pause before distracting apps, usage tracking and streaks. Free, no ads, account optional."
			platform="android"
			downloadUrl="https://play.google.com/store/apps/details?id=dev.sadakat.thinkfaster"
		/>
		<ProductSchema
			name="Respite for Chrome"
			description="Free Chrome extension for mindful browsing: website time tracking, focus mode and usage insights."
			platform="chrome"
			downloadUrl="https://chromewebstore.google.com/detail/intently-intentful-browsi/acjndeeecacgplloeefjjhlnlpgnonop"
		/>
		<FAQSchema faqs={homeFaqs} />
	</head>
	<body class="m-page">
		<Header />

		<main class="m">
			<!-- Hero: the pause itself -->
			<section class="hm-hero" aria-labelledby="hm-title">
				<div class="hm-hero-copy">
					<h1 id="hm-title">Pause before the scroll.</h1>
					<p class="m-dek">A gentle pause before the apps you pick, so opening them is a choice. Free on iPhone, Android and Chrome.</p>
					<div class="m-actions hm-hero-actions" data-placement="hero">
						<a href="/download/" class="m-btn">Download free</a>
						<a href="#how" class="m-btn is-soft">See how it works</a>
					</div>
					<ul class="m-pills" aria-label="Good to know">
						<li><Icon name="Check" size={18} />No ads</li>
						<li><Icon name="Check" size={18} />No account needed</li>
						<li><Icon name="Check" size={18} />History stays on your device</li>
					</ul>
				</div>

				<div class="hm-stage" role="img" aria-label="Respite's pause screen asking Open Instagram?, with Biscuit the fox waving, a 7-day streak and a daily limit at 42 of 60 minutes">
					<div class="hm-phone" aria-hidden="true">
						<span class="hm-hourglass"><Icon name="Hourglass" size={30} /></span>
						<p class="hm-phone-big">Open Instagram?</p>
						<p class="hm-phone-small">Opened 6 times today</p>
						<span class="hm-phone-btn">I'll do something else</span>
						<span class="hm-phone-btn is-soft">Continue in 5s</span>
					</div>
					<div class="hm-float hm-float-streak" aria-hidden="true">
						<span class="m-tile is-reward"><Icon name="Flame" size={20} /></span>
						<span><strong>7 days</strong><small>Streak</small></span>
					</div>
					<div class="hm-float hm-float-limit" aria-hidden="true">
						<span class="hm-float-row"><strong>Instagram</strong><small>42 of 60m</small></span>
						<span class="hm-meter"><span style="width:70%"></span></span>
					</div>
					<div class="hm-stage-biscuit" aria-hidden="true">
						<Biscuit mood="wave" size={150} label="Biscuit the fox waving" />
					</div>
				</div>
			</section>

			<!-- How it works: a real sequence, so numbered -->
			<section class="m-section" id="how" aria-labelledby="how-title">
				<h2 id="how-title" class="m-h2 hm-center">How it works</h2>
				<ol class="hm-steps">
					{steps.map((s, i) => (
						<li class="hm-step">
							<div class={`hm-step-art s-${i + 1}`} aria-hidden="true">
								{i === 0 && (
									<div class="hm-apps">
										{['I', 'Y', 'T', 'R', 'S', 'N'].map((l, j) => (
											<span class={`hm-app ${j === 0 || j === 2 ? 'is-on' : ''}`}>
												{l}
												{(j === 0 || j === 2) && <span class="hm-app-check"><Icon name="Check" size={12} /></span>}
											</span>
										))}
									</div>
								)}
								{i === 1 && (
									<div class="hm-breath">
										<span class="hm-breath-ring"></span>
										<span class="hm-breath-dot"><Icon name="Hourglass" size={26} /></span>
									</div>
								)}
								{i === 2 && (
									<div class="hm-choice">
										<span class="hm-phone-btn">I'll do something else</span>
										<span class="hm-phone-btn is-soft">Continue</span>
										<span class="m-badge is-live"><Icon name="Check" size={14} />Streak kept</span>
									</div>
								)}
							</div>
							<span class="m-tile is-number">{i + 1}</span>
							<h3>{s.title}</h3>
							<p>{s.line}</p>
						</li>
					))}
				</ol>
			</section>

			<!-- Before and after, as pairs -->
			<section class="m-section" aria-labelledby="shift-title">
				<div class="hm-center-head">
					<h2 id="shift-title" class="m-h2">One small pause changes the day</h2>
				</div>
				<div class="hm-pairs">
					<div class="hm-pairs-head" aria-hidden="true">
						<span class="m-badge hm-before-badge">Without a pause</span>
						<span></span>
						<span class="m-badge is-live">With Respite</span>
					</div>
					<ul class="m-group hm-pairs-list">
						{pairs.map((p) => (
							<li class="hm-pair">
								<span class="hm-side">
									<span class="m-tile is-warning"><Icon name={p.before.icon} size={20} /></span>
									<span><span class="m-sr">Without a pause: </span>{p.before.text}</span>
								</span>
								<span class="hm-arrow" aria-hidden="true"><Icon name="ArrowRight" size={18} /></span>
								<span class="hm-side">
									<span class="m-tile is-success"><Icon name={p.after.icon} size={20} /></span>
									<span><span class="m-sr">With Respite: </span>{p.after.text}</span>
								</span>
							</li>
						))}
					</ul>
				</div>
			</section>

			<!-- Feature areas, as illustrations -->
			<section class="m-section" aria-labelledby="more-title">
				<div class="m-section-head">
					<h2 id="more-title">More than a pause</h2>
					<a class="hm-link" href="/features/">Every feature <Icon name="ArrowRight" size={16} /></a>
				</div>
				<div class="hm-areas">
					{areas.map((a) => (
						<a class="hm-area" href={a.href}>
							<span class="hm-area-art" aria-hidden="true">
								<Picture src={`/images/blog/${a.art}.jpg`} alt="" width={720} height={405} loading="lazy" />
							</span>
							<span class="hm-area-copy">
								<span class="hm-area-title">{a.title}{a.plus && <span class="m-badge is-plus">Plus</span>}</span>
								<span class="hm-area-line">{a.line}</span>
							</span>
						</a>
					))}
				</div>
			</section>

			<!-- Where to get it -->
			<section class="m-section" id="get" aria-labelledby="get-title">
				<div class="hm-center-head">
					<h2 id="get-title" class="m-h2">Wherever you scroll</h2>
					<p class="m-caption">Free on all three. Each works on its own, no account needed.</p>
				</div>
				<div class="hm-devices" data-placement="platforms">
					{devices.map((d) => (
						<section class="hm-device" aria-labelledby={`dev-${d.id}`}>
							<span class="m-tile"><Icon name={d.icon} size={22} /></span>
							<h3 id={`dev-${d.id}`}>{d.name}</h3>
							<p class="m-caption">{d.needs}</p>
							<ul class="hm-chips">
								{d.chips.map((c) => <li>{c}</li>)}
							</ul>
							<div class="hm-device-store"><StoreButton store={d.store} href={d.href} /></div>
						</section>
					))}
				</div>
				<p class="m-caption hm-center">Respite Plus is optional: sync on every device, longer focus and more. <a href="/features/#plans">Free or Plus</a></p>
			</section>

			<!-- Privacy -->
			<section class="hm-privacy" aria-labelledby="privacy-title">
				<div class="m-biscuit hm-privacy-biscuit">
					<div class="m-biscuit-disc" aria-hidden="true"><Biscuit mood="meditate" size={170} label="Biscuit meditating" /></div>
					<p class="m-bubble">Your history stays with you.</p>
				</div>
				<div class="hm-privacy-main">
					<h2 id="privacy-title" class="m-h2">Private by design</h2>
					<ul class="m-group">
						<li class="m-row">
							<span class="m-tile is-success"><Icon name="UserX" size={22} /></span>
							<div><p class="m-row-title">No account needed</p><p class="m-row-text">Sign in only if you want sync.</p></div>
							<span></span>
						</li>
						<li class="m-row">
							<span class="m-tile is-success"><Icon name="Smartphone" size={22} /></span>
							<div><p class="m-row-title">History on your device</p><p class="m-row-text">Unless you turn on sync.</p></div>
							<span></span>
						</li>
						<li class="m-row">
							<span class="m-tile is-success"><Icon name="ShieldCheck" size={22} /></span>
							<div><p class="m-row-title">No ads, never sold</p><p class="m-row-text">Each version's privacy policy lists what it collects.</p></div>
							<span></span>
						</li>
					</ul>
					<p class="m-caption">Privacy policy for <a href="/privacy/">iPhone</a>, <a href="/privacy/android/">Android</a> and <a href="/privacy/chrome/">Chrome</a></p>
				</div>
			</section>

			<!-- Free tools -->
			<section class="m-section" aria-labelledby="tools-title">
				<div class="hm-center-head">
					<h2 id="tools-title" class="m-h2">Where do you stand?</h2>
					<p class="m-caption">Free, private, nothing stored.</p>
				</div>
				<div class="hm-tools">
					{tools.map((t) => (
						<a class="hm-tool" href={t.href}>
							<span class="m-tile"><Icon name={t.icon} size={22} /></span>
							<span class="hm-tool-copy">
								<span class="hm-tool-title">{t.title}</span>
								<span class="hm-tool-line">{t.line}</span>
							</span>
							<span class="hm-tool-go" aria-hidden="true"><Icon name="ArrowRight" size={18} /></span>
						</a>
					))}
				</div>
			</section>

			<!-- Latest posts -->
			<section class="m-section" aria-labelledby="blog-title">
				<div class="m-section-head">
					<h2 id="blog-title">From the blog</h2>
					<a class="hm-link" href="/blog/">All articles <Icon name="ArrowRight" size={16} /></a>
				</div>
				<div class="hm-posts">
					{latestPosts.map((post) => (
						<a class="hm-post" href={`/blog/${post.id}/`}>
							{post.data.heroImage && (
								<span class="hm-post-art" aria-hidden="true">
									<Picture src={post.data.heroImage} alt="" width={640} height={360} loading="lazy" />
								</span>
							)}
							<span class="hm-post-copy">
								<span class="hm-post-title">{post.data.title}</span>
								<span class="hm-post-line">{post.data.description}</span>
							</span>
						</a>
					))}
				</div>
			</section>

			<!-- Questions -->
			<section class="m-section" aria-labelledby="faq-title">
				<h2 id="faq-title" class="m-h2">Questions</h2>
				<div class="m-group m-faq">
					{homeFaqs.map((faq) => (
						<details>
							<summary>{faq.question}</summary>
							<p>{faq.answer}</p>
						</details>
					))}
				</div>
			</section>

			<section class="m-end hm-end" aria-labelledby="end-title" data-placement="final_cta">
				<Biscuit mood="cheer" size={120} label="Biscuit cheering" />
				<h2 id="end-title">Try it on one app first</h2>
				<p>Free, no ads, about a minute to set up.</p>
				<a href="/download/" class="m-btn">Download Respite</a>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	.hm-center,
	.hm-center-head {
		text-align: center;
		justify-self: center;
	}

	.hm-center-head {
		display: grid;
		gap: 0.5rem;
	}

	.hm-link {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		color: var(--m-accent);
		font-family: var(--font-heading);
		font-weight: 800;
		text-decoration: none;
	}

	.hm-link:hover {
		text-decoration: underline;
		text-underline-offset: 0.18em;
	}

	/* ------------------------------------------------------------ hero */
	.hm-hero {
		display: grid;
		gap: 2.5rem;
		align-items: center;
	}

	@media (min-width: 920px) {
		.hm-hero {
			grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
			gap: 3.5rem;
		}
	}

	.hm-hero h1 {
		margin: 0 0 1.1rem;
		font-size: clamp(2.6rem, 1.7rem + 3.6vw, 4.4rem);
		font-weight: 800;
		line-height: 1.02;
		letter-spacing: -0.025em;
		text-wrap: balance;
	}

	.hm-hero-actions {
		margin-top: 1.75rem;
	}

	.hm-stage {
		position: relative;
		display: grid;
		place-items: center;
		min-height: 470px;
		padding: 2.5rem 1.5rem;
		border-radius: 36px;
		background: var(--m-accent-soft);
	}

	.hm-phone {
		display: grid;
		justify-items: center;
		gap: 0.55rem;
		width: min(270px, 78%);
		padding: 1.75rem 1.2rem 1.2rem;
		border-radius: 34px;
		background: var(--m-paper);
		box-shadow: var(--m-shadow-md);
		text-align: center;
	}

	.hm-phone p {
		margin: 0;
	}

	.hm-hourglass {
		display: grid;
		place-items: center;
		width: 62px;
		height: 62px;
		margin-bottom: 0.25rem;
		border-radius: 50%;
		background: var(--m-accent-soft);
		color: var(--m-accent-ink);
		animation: hm-breathe 4s ease-in-out infinite;
	}

	@keyframes hm-breathe {
		50% {
			transform: scale(1.1);
		}
	}

	.hm-phone-big {
		font-family: var(--font-heading);
		font-size: 1.35rem;
		font-weight: 800;
	}

	.hm-phone-small {
		margin-bottom: 0.5rem !important;
		font-size: 0.9rem;
		color: var(--m-ink-soft);
	}

	.hm-phone-btn {
		display: block;
		width: 100%;
		padding: 0.65rem;
		border-radius: 999px;
		background: var(--m-accent-strong);
		color: var(--m-on-accent);
		font-family: var(--font-heading);
		font-size: 0.92rem;
		font-weight: 800;
		text-align: center;
	}

	.hm-phone-btn.is-soft {
		background: var(--m-fog);
		color: var(--m-ink-soft);
	}

	.hm-float {
		position: absolute;
		display: flex;
		align-items: center;
		gap: 0.65rem;
		padding: 0.65rem 0.9rem;
		border-radius: 18px;
		background: var(--m-paper);
		box-shadow: var(--m-shadow-md);
		font-size: 0.85rem;
	}

	.hm-float strong {
		display: block;
		font-family: var(--font-heading);
		font-size: 1rem;
		font-weight: 800;
		line-height: 1.2;
	}

	.hm-float small {
		color: var(--m-ink-soft);
		font-size: 0.8rem;
		font-weight: 700;
	}

	.hm-float .m-tile {
		width: 38px;
		height: 38px;
		border-radius: 11px;
	}

	.hm-float-streak {
		top: 1.75rem;
		right: 1.25rem;
	}

	.hm-float-limit {
		bottom: 2rem;
		right: 1.25rem;
		flex-direction: column;
		align-items: stretch;
		gap: 0.45rem;
		width: 170px;
	}

	.hm-float-row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem;
	}

	.hm-float-row strong {
		font-size: 0.9rem;
	}

	.hm-meter {
		display: block;
		height: 8px;
		border-radius: 999px;
		background: var(--m-fog);
		overflow: hidden;
	}

	.hm-meter span {
		display: block;
		height: 100%;
		border-radius: 999px;
		background: var(--m-accent);
	}

	.hm-stage-biscuit {
		position: absolute;
		left: 0.25rem;
		bottom: -0.5rem;
	}

	@media (max-width: 600px) {
		.hm-stage {
			min-height: 430px;
			padding: 2rem 1rem 6.5rem;
		}
		.hm-phone {
			width: min(250px, 86%);
		}
		.hm-float-streak {
			top: 1rem;
			right: 0.75rem;
		}
		.hm-float-limit {
			right: 0.75rem;
			bottom: 1.25rem;
			width: 165px;
		}
		.hm-float-row {
			white-space: nowrap;
		}
		.hm-stage-biscuit :global(*) {
			max-width: 120px;
			max-height: 120px;
		}
	}

