---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/info-pages.css';
import Icon from '../components/ui/Icon.astro';
import Biscuit from '../components/ui/Biscuit.astro';
import ToolCard from '../components/ui/ToolCard.astro';
import FAQSchema from '../components/SEO/FAQSchema.astro';
import BreadcrumbSchema from '../components/SEO/BreadcrumbSchema.astro';

const quizFaqs = [
	{
		question: "How do I know if I'm addicted to my phone?",
		answer: "Signs of phone addiction include checking your phone within 5 minutes of waking, feeling anxious without it, failed attempts to reduce usage, phone use interfering with work or relationships, and mindlessly scrolling for hours. Take this free quiz to get a personalized assessment of your phone habits."
	},
	{
		question: "Is this phone addiction test accurate?",
		answer: "This quiz is based on behavioral science research and assesses 8 key areas of phone dependency. While not a clinical diagnosis, it provides a reliable indication of your relationship with your phone and personalized recommendations for improvement."
	},
	{
		question: "What should I do if I score high on the phone addiction quiz?",
		answer: "A high score indicates significant phone dependency. Start by downloading Respite (free, no account needed) to create mindful pauses before opening distracting apps. Set daily time limits, create phone-free zones, and consider speaking with a therapist about digital dependency."
	},
	{
		question: "How much screen time is considered phone addiction?",
		answer: "While there's no universal threshold, research suggests more than 4-6 hours of non-work screen time daily, combined with compulsive checking behavior and failed reduction attempts, indicates problematic phone use. This quiz evaluates multiple factors beyond just screen time hours."
	}
];

const questions = [
	{
		id: 1,
		question: "How often do you check your phone first thing in the morning?",
		options: [
			{ text: "Within 5 minutes of waking up", score: 3 },
			{ text: "Within 30 minutes", score: 2 },
			{ text: "After my morning routine", score: 1 },
			{ text: "I don't check it in the morning", score: 0 }
		]
	},
	{
		id: 2,
		question: "How many hours per day do you spend on your phone?",
		options: [
			{ text: "More than 6 hours", score: 3 },
			{ text: "4-6 hours", score: 2 },
			{ text: "2-4 hours", score: 1 },
			{ text: "Less than 2 hours", score: 0 }
		]
	},
	{
		id: 3,
		question: "Do you feel anxious when you can't access your phone?",
		options: [
			{ text: "Very anxious - I panic", score: 3 },
			{ text: "Somewhat anxious", score: 2 },
			{ text: "A little uncomfortable", score: 1 },
			{ text: "Not anxious at all", score: 0 }
		]
	},
	{
		id: 4,
		question: "How often do you use your phone while spending time with others?",
		options: [
			{ text: "Constantly checking", score: 3 },
			{ text: "Frequently", score: 2 },
			{ text: "Occasionally", score: 1 },
			{ text: "Rarely or never", score: 0 }
		]
	},
	{
		id: 5,
		question: "Have you tried to reduce your phone usage but failed?",
		options: [
			{ text: "Many times - I always fail", score: 3 },
			{ text: "A few times with limited success", score: 2 },
			{ text: "Once or twice", score: 1 },
			{ text: "I haven't tried", score: 0 }
		]
	},
	{
		id: 6,
		question: "Do you reach for your phone when you're bored?",
		options: [
			{ text: "Always - it's automatic", score: 3 },
			{ text: "Most of the time", score: 2 },
			{ text: "Sometimes", score: 1 },
			{ text: "Rarely", score: 0 }
		]
	},
	{
		id: 7,
		question: "Does phone usage interfere with your work or studies?",
		options: [
			{ text: "Severely - I can't focus", score: 3 },
			{ text: "Moderately - it's distracting", score: 2 },
			{ text: "Slightly", score: 1 },
			{ text: "Not at all", score: 0 }
		]
	},
	{
		id: 8,
		question: "How often do you mindlessly scroll social media?",
		options: [
			{ text: "Multiple times daily for hours", score: 3 },
			{ text: "Once or twice daily", score: 2 },
			{ text: "A few times per week", score: 1 },
			{ text: "Rarely", score: 0 }
		]
	}
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Phone Addiction Test: Am I Addicted to My Phone? (Free)"
			description="Free phone addiction quiz: answer 8 science-backed questions and get a personal screen time assessment with clear next steps. Private, nothing stored."
		/>
		<FAQSchema faqs={quizFaqs} />
		<BreadcrumbSchema
			items={[
				{ name: "Home", url: "https://respite.liveintently.app" },
				{ name: "Phone Addiction Quiz", url: "https://respite.liveintently.app/quiz/" }
			]}
		/>
	</head>
	<body class="m-page">
		<Header />

		<main class="m">
			<section class="m-tool-hero" aria-labelledby="quiz-title">
				<div class="m-biscuit-disc" aria-hidden="true"><Biscuit mood="thinking" size={140} label="Biscuit thinking" /></div>
				<h1 id="quiz-title">Phone addiction quiz</h1>
				<p class="m-dek">Eight quick questions about you and your phone, and a clear next step.</p>
				<ul class="m-pills" aria-label="Good to know">
					<li><Icon name="Clock" size={18} />2 minutes</li>
					<li><Icon name="Lock" size={18} />Nothing is stored</li>
				</ul>
			</section>

			<section class="m-tool-card" aria-label="Quiz">
				<div id="quiz-progress" class="m-tool-progress" aria-hidden="true">
					<span id="progress-fill"></span>
				</div>

				<div id="quiz-questions">
					{questions.map((q, index) => (
						<div class="question-slide" data-question={index + 1} style={index === 0 ? '' : 'display: none;'}>
							<p class="m-tool-step">Question {index + 1} of {questions.length}</p>
							<h2 class="m-tool-q" tabindex="-1">{q.question}</h2>
							<div class="m-tool-options">
								{q.options.map((option) => (
									<button type="button" class="option-button m-tool-option" data-score={option.score} data-question={q.id}>
										{option.text}
									</button>
								))}
							</div>
						</div>
					))}
				</div>

				<div id="quiz-results" style="display: none;">
					<div class="m-tool-result">
						<div id="result-biscuit" class="m-tool-biscuit" aria-hidden="true"></div>
						<h2 id="result-title" tabindex="-1"></h2>
						<p id="result-description"></p>
						<div class="m-tool-meter" aria-hidden="true"><span id="result-meter"></span></div>
						<p class="m-tool-step" id="result-score"></p>
						<ul id="recommendations-list" class="m-tool-tips" aria-label="What to try"></ul>
						<div class="m-actions" data-placement="result">
							<a href="/download/" class="m-btn" data-cta="download">Try Respite on one app</a>
							<a href="/blog/how-to-stop-phone-addiction/" class="m-btn is-soft">How to cut back</a>
						</div>
						<button type="button" id="retake-quiz" class="m-tool-retake">Take it again</button>
					</div>
				</div>
			</section>

			<section class="m-section" aria-labelledby="more-title">
				<h2 id="more-title" class="m-h2">More free tools</h2>
				<div class="m-tool-more">
					<ToolCard id="calculator" />
					<ToolCard id="score" />
				</div>
			</section>

			<section class="m-section" aria-labelledby="faq-title">
				<h2 id="faq-title" class="m-h2">Questions</h2>
				<div class="m-group m-faq">
					{quizFaqs.map((faq) => (
						<details>
							<summary>{faq.question}</summary>
							<p>{faq.answer}</p>
						</details>
					))}
				</div>
				<p class="m-caption">Not a diagnosis. Read <a href="/blog/how-to-stop-phone-addiction/">how to stop phone addiction</a> or <a href="/blog/how-to-reduce-screen-time/">how to reduce screen time</a>.</p>
			</section>
		</main>

		<Footer />

		<script>
			import { toolCompleteParams, track } from '../lib/analytics';

			let currentQuestion = 1;
			let totalScore = 0;
			const totalQuestions = 8;

			document.querySelectorAll('.option-button').forEach(button => {
				button.addEventListener('click', () => {
					const score = parseInt((button as HTMLElement).dataset.score ?? '0');
					totalScore += score;

					const progress = (currentQuestion / totalQuestions) * 100;
					document.getElementById('progress-fill')!.style.width = `${progress}%`;

					if (currentQuestion < totalQuestions) {
						document.querySelector(`[data-question="${currentQuestion}"]`)!.setAttribute('style', 'display: none;');
						currentQuestion++;
						const next = document.querySelector<HTMLElement>(`[data-question="${currentQuestion}"]`)!;
						next.setAttribute('style', '');
						next.querySelector<HTMLElement>('.m-tool-q')?.focus();
					} else {
						showResults();
					}
				});
			});

			// Biscuit is made when the results show: a player started while hidden draws at the wrong size.
			function showBiscuit(mood: string) {
				const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
				document.getElementById('result-biscuit')!.innerHTML = `<dotlottie-wc src="/biscuit/${mood}.json" ${still ? '' : 'autoplay loop'} style="width:130px;height:130px"></dotlottie-wc>`;
			}

			function showResults() {
				document.getElementById('quiz-questions')!.style.display = 'none';
				document.getElementById('quiz-results')!.style.display = 'block';

				let level, title, description, recommendations;

				if (totalScore >= 18) {
					level = 'severe';
					title = 'Severe Phone Addiction';
					description = 'Your phone usage is significantly impacting your daily life. You likely experience anxiety without your phone and struggle to focus on other activities. Professional support combined with digital wellbeing tools could help.';
					recommendations = [
						'Download Respite to create mindful interventions',
						'Set strict daily time limits for social media apps',
						'Consider a digital detox (24-48 hours without phone)',
						'Talk to a therapist about phone dependency',
						'Use grayscale mode to reduce phone appeal'
					];
				} else if (totalScore >= 12) {
					level = 'moderate';
					title = 'Moderate Phone Addiction';
					description = 'You show clear signs of phone dependency that occasionally interfere with daily activities. You recognize the issue but find it challenging to change habits. With the right tools and strategies, you can regain control.';
					recommendations = [
						'Use Respite\'s mindful interventions to build awareness',
						'Set app time limits (start with 30 min reduction)',
						'Create phone-free zones (bedroom, dining table)',
						'Replace scrolling with alternative activities',
						'Track your usage to identify trigger times'
					];
				} else if (totalScore >= 6) {
					level = 'mild';
					title = 'Mild Phone Dependency';
					description = 'You have a relatively healthy relationship with your phone but show some habits worth addressing. You occasionally reach for your phone mindlessly. Small adjustments can help you maintain balanced usage.';
					recommendations = [
						'Use Respite to track usage patterns',
						'Set mindful reminders for your most-used apps',
						'Implement "no phone" during specific activities',
						'Practice intentional phone checking',
						'Celebrate your mindful choices'
					];
				} else {
					level = 'healthy';
					title = 'Healthy Phone Usage';
					description = 'Congratulations! You have a balanced relationship with your phone. You use it intentionally and rarely feel controlled by it. Continue your mindful approach to maintain this healthy relationship.';
					recommendations = [
						'Maintain your current habits',
						'Use Respite to track and celebrate progress',
						'Be mindful of gradual usage creep',
						'Share your strategies with others',
						'Stay informed about digital wellbeing'
					];
				}

				document.getElementById('result-title')!.textContent = title;
				document.getElementById('result-description')!.textContent = description;
				document.getElementById('result-score')!.textContent = `${totalScore} out of 24`;
				document.getElementById('result-meter')!.style.left = `${(totalScore / 24) * 100}%`;
				showBiscuit({ severe: 'concerned', moderate: 'thinking', mild: 'happy', healthy: 'cheer' }[level as string] ?? 'idle');
				// Only the level (healthy … severe), never the answers.
				track('tool_complete', toolCompleteParams('quiz', level));


				const recList = document.getElementById('recommendations-list')!;
				recommendations.forEach((rec: string) => {
					const li = document.createElement('li');
					li.textContent = rec;
					recList.appendChild(li);
				});
				document.getElementById('result-title')!.focus();
			}

			document.getElementById('retake-quiz')?.addEventListener('click', function() {
				currentQuestion = 1;
				totalScore = 0;
				document.getElementById('progress-fill')!.style.width = '0%';
				document.getElementById('recommendations-list')!.innerHTML = '';

				document.getElementById('quiz-questions')!.style.display = 'block';
				document.getElementById('quiz-results')!.style.display = 'none';

				document.querySelectorAll('.question-slide').forEach((slide, index) => {
					if (index === 0) {
						slide.setAttribute('style', '');
					} else {
						slide.setAttribute('style', 'display: none;');
					}
				});
				document.querySelector<HTMLElement>('[data-question="1"] .m-tool-q')?.focus();
			});
		</script>
	</body>
</html>
