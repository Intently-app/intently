---
/**
 * /about/: why Respite exists and what it stands for. Mist styles (src/styles/info-pages.css)
 * plus the ab-* rules below. The story is the founder's own; keep its facts as they are.
 */
import '../styles/info-pages.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/ui/Icon.astro';
import Biscuit from '../components/ui/Biscuit.astro';
import BreadcrumbSchema from '../components/SEO/BreadcrumbSchema.astro';
import ProfilePageSchema from '../components/SEO/ProfilePageSchema.astro';
import { SUPPORT_EMAIL } from '../consts';

const beliefs = [
	{ icon: 'Brain', tone: '', title: 'Awareness, not punishment', line: 'A lock on the fridge never fixed hunger. A moment to notice does more.' },
	{ icon: 'Lock', tone: 'is-success', title: 'Your history is yours', line: 'It stays on your device, and nothing syncs unless you sign in.' },
	{ icon: 'Target', tone: 'is-reward', title: 'Grounded in habit research', line: 'Ideas from habit formation and behavioural psychology, kept simple.' },
	{ icon: 'Heart', tone: 'is-warning', title: 'Built for people, not metrics', line: 'The less you need us, the better we have done.' },
];

const nevers = [
	{ icon: 'Ban', label: 'No ads' },
	{ icon: 'ShieldCheck', label: 'Never sells your data' },
	{ icon: 'Infinity', label: 'No infinite scroll' },
	{ icon: 'BellOff', label: 'No anxious notifications' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Our Story: Why We Built Respite" description="Built at 2am by someone who couldn't stop scrolling. Respite rests on one idea: you don't need to be controlled, just given a moment to choose differently." />
		<BreadcrumbSchema
			items={[
				{ name: 'Home', url: 'https://respite.liveintently.app' },
				{ name: 'About', url: 'https://respite.liveintently.app/about/' },
			]}
		/>
		<ProfilePageSchema />
	</head>
	<body class="m-page">
		<Header />

		<main class="m">
			<section class="ab-hero" aria-labelledby="ab-title">
				<div class="m-biscuit-disc ab-disc" aria-hidden="true"><Biscuit mood="peek_phone" size={170} label="Biscuit peeking at a phone" /></div>
				<h1 id="ab-title">We built this because we needed it too</h1>
				<p class="m-dek">Respite started at 2am, mid-scroll. There had to be a kinder way.</p>
			</section>

			<!-- The story, beside the moment it started -->
			<section class="ab-story" aria-labelledby="story-title">
				<div class="ab-night" role="img" aria-label="A phone at 1:47am on a Tuesday, asking: Is this what you want to be doing right now?">
					<span class="ab-night-day" aria-hidden="true">Tuesday</span>
					<span class="ab-night-time" aria-hidden="true">1:47</span>
					<div class="ab-night-card" aria-hidden="true">
						<span class="ab-night-icon"><Icon name="Hourglass" size={22} /></span>
						<p>Is this what you want to be doing right now?</p>
						<span class="ab-night-btns"><span>Put it down</span><span>Keep going</span></span>
					</div>
					<div class="ab-night-fox" aria-hidden="true"><Biscuit mood="sleepy" size={110} label="Biscuit sleepy" /></div>
				</div>

				<div class="ab-story-copy">
					<h2 id="story-title" class="m-h2">How it started</h2>
					<p>It was 1:47am on a Tuesday. I'd been scrolling for two hours and didn't remember opening Instagram.</p>
					<blockquote>When I finally put the phone down, I felt hollow. Not relaxed. Just empty.</blockquote>
					<p>Other screen time apps locked me out like a parent grounding a child, or shamed me with scary stats. None of it worked.</p>
					<p>So I asked: what if an app didn't try to control me, and just asked me a question? That question became Respite.</p>
					<p class="ab-sign">Some days you'll still choose to scroll, and that's fine. The point is that it's your choice.</p>
				</div>
			</section>

			<section class="m-section" aria-labelledby="beliefs-title">
				<h2 id="beliefs-title" class="m-h2 ab-center">What we believe</h2>
				<div class="ab-beliefs">
					{beliefs.map((b) => (
						<div class="ab-belief">
							<span class={`m-tile ${b.tone}`}><Icon name={b.icon} size={22} /></span>
							<h3>{b.title}</h3>
							<p>{b.line}</p>
						</div>
					))}
				</div>
			</section>

			<section class="m-section" aria-labelledby="never-title">
				<div class="ab-center-head">
					<h2 id="never-title" class="m-h2">What we'll never do</h2>
					<p class="m-caption">Privacy policy for <a href="/privacy/">iPhone</a>, <a href="/privacy/android/">Android</a> and <a href="/privacy/chrome/">Chrome</a></p>
				</div>
				<ul class="ab-nevers">
					{nevers.map((n) => (
						<li>
							<span class="m-tile is-success"><Icon name={n.icon} size={22} /></span>
							{n.label}
						</li>
					))}
				</ul>
			</section>

			<section class="ab-studio" aria-labelledby="studio-title">
				<img src="/logo.svg" alt="" width="64" height="64" class="ab-logo" />
				<div class="ab-studio-copy">
					<h2 id="studio-title">Made by Intently</h2>
					<p>Respite is made by the Intently studio. Questions, ideas and bug reports are always welcome.</p>
				</div>
				<div class="ab-studio-links">
					<a class="m-btn is-soft" href="/contact/"><Icon name="MessageCircle" size={18} />Contact us</a>
					<a class="m-btn is-soft" href={`mailto:${SUPPORT_EMAIL}`}><Icon name="Mail" size={18} />Email</a>
					<a class="m-btn is-soft" href="https://liveintently.app">More apps</a>
				</div>
			</section>

			<section class="m-end" aria-labelledby="end-title" data-placement="final_cta">
				<Biscuit mood="cheer" size={110} label="Biscuit cheering" />
				<h2 id="end-title">You're already taking the first step</h2>
				<p>Free, no ads, about a minute to set up.</p>
				<div class="m-actions ab-end-actions">
					<a href="/download/" class="m-btn">Download Respite</a>
					<a href="/quiz/" class="m-btn is-soft">Take the quiz</a>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	.ab-center,
	.ab-center-head {
		justify-self: center;
		text-align: center;
	}

	.ab-center-head {
		display: grid;
		gap: 0.5rem;
	}

	/* ------------------------------------------------------------ hero */
	.ab-hero {
		display: grid;
		justify-items: center;
		gap: 1rem;
		text-align: center;
	}

	.ab-disc {
		width: 190px;
	}

	.ab-hero h1 {
		max-width: 16ch;
		margin: 0.75rem 0 0;
		font-size: clamp(2.3rem, 1.6rem + 2.8vw, 3.6rem);
		font-weight: 800;
		line-height: 1.05;
		letter-spacing: -0.02em;
		text-wrap: balance;
	}

	/* ------------------------------------------------------------ story */
	.ab-story {
		display: grid;
		gap: 2.5rem;
		align-items: center;
	}

	@media (min-width: 900px) {
		.ab-story {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			gap: 3.5rem;
		}
	}

	/* The night screen stays dark in both themes: it is 1:47am. */
	.ab-night {
		position: relative;
		display: grid;
		justify-items: center;
		align-content: start;
		gap: 0.25rem;
		min-height: 480px;
		padding: 3rem 1.5rem 2rem;
		border-radius: 36px;
		background: #142632;
		color: #e8f2f7;
		overflow: hidden;
	}

	.ab-night-day {
		font-family: var(--font-heading);
		font-size: 1rem;
		font-weight: 700;
		opacity: 0.75;
	}

	.ab-night-time {
		font-family: var(--font-heading);
		font-size: clamp(4.5rem, 3rem + 5vw, 6.5rem);
		font-weight: 800;
		line-height: 1;
		letter-spacing: -0.03em;
		font-variant-numeric: tabular-nums;
	}

	.ab-night-card {
		display: grid;
		justify-items: center;
		gap: 0.75rem;
		width: min(300px, 100%);
		margin-top: 2rem;
		padding: 1.4rem 1.2rem 1.2rem;
		border-radius: 26px;
		background: #ffffff;
		color: #13222d;
		box-shadow: 0 20px 40px -16px rgba(0, 0, 0, 0.6);
		text-align: center;
	}

	.ab-night-icon {
		display: grid;
		place-items: center;
		width: 48px;
		height: 48px;
		border-radius: 50%;
		background: #e2eef4;
		color: #24465a;
	}

	.ab-night-card p {
		margin: 0;
		font-family: var(--font-heading);
		font-size: 1.15rem;
		font-weight: 800;
		line-height: 1.3;
	}

	.ab-night-btns {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.5rem;
		width: 100%;
	}

	.ab-night-btns span {
		padding: 0.55rem;
		border-radius: 999px;
		background: #2f6079;
		color: #ffffff;
		font-family: var(--font-heading);
		font-size: 0.9rem;
		font-weight: 800;
	}

	.ab-night-btns span:last-child {
		background: #e8eff4;
		color: #46596a;
	}

	.ab-night-fox {
		position: absolute;
		left: 0.5rem;
		bottom: -0.25rem;
	}

	.ab-story-copy {
		display: grid;
		gap: 1rem;
		font-size: 1.1rem;
		line-height: 1.65;
	}

	.ab-story-copy h2 {
		margin-bottom: 0.25rem;
	}

	.ab-story-copy p {
		margin: 0;
		color: var(--m-ink-soft);
	}

	.ab-story-copy blockquote {
		margin: 0.25rem 0;
		padding: 1.25rem 1.5rem;
		border: 0;
		border-radius: 20px;
		background: var(--m-paper);
		box-shadow: var(--m-shadow-sm);
		font-family: var(--font-heading);
		font-size: 1.3rem;
		font-style: normal;
		font-weight: 800;
		line-height: 1.4;
	}

	.ab-story-copy .ab-sign {
		color: var(--m-ink);
		font-weight: 700;
	}

	/* ------------------------------------------------------------ beliefs */
	.ab-beliefs {
		display: grid;
		gap: 1.25rem;
	}

	@media (min-width: 680px) {
		.ab-beliefs {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	.ab-belief {
		display: grid;
		align-content: start;
		gap: 0.6rem;
		padding: 1.75rem;
		border-radius: 28px;
		background: var(--m-paper);
		box-shadow: var(--m-shadow-sm);
	}

	.ab-belief .m-tile {
		width: 52px;
		height: 52px;
		border-radius: 15px;
		margin-bottom: 0.4rem;
	}

	.ab-belief h3 {
		margin: 0;
		font-size: 1.3rem;
		font-weight: 800;
	}

	.ab-belief p {
		margin: 0;
		line-height: 1.55;
		color: var(--m-ink-soft);
	}

	/* ------------------------------------------------------------ never */
	.ab-nevers {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	@media (min-width: 960px) {
		.ab-nevers {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}

	.ab-nevers li {
		display: grid;
		justify-items: center;
		gap: 0.75rem;
		padding: 1.5rem 1rem;
		border-radius: 24px;
		background: var(--m-paper);
		box-shadow: var(--m-shadow-sm);
		font-family: var(--font-heading);
		font-size: 1.08rem;
		font-weight: 800;
		line-height: 1.3;
		text-align: center;
	}

	/* ------------------------------------------------------------ studio */
	.ab-studio {
		display: grid;
		justify-items: center;
		gap: 1.25rem;
		padding: 2rem 1.5rem;
		border-radius: 28px;
		background: var(--m-paper);
		box-shadow: var(--m-shadow-sm);
		text-align: center;
	}

	@media (min-width: 900px) {
		.ab-studio {
			grid-template-columns: auto 1fr auto;
			justify-items: start;
			align-items: center;
			gap: 1.5rem;
			padding: 1.75rem 2rem;
			text-align: left;
		}
	}

	.ab-logo {
		display: block;
		width: 64px;
		height: 64px;
		border-radius: 18px;
	}

	.ab-studio-copy h2 {
		margin: 0 0 0.25rem;
		font-size: 1.45rem;
		font-weight: 800;
	}

	.ab-studio-copy p {
		margin: 0;
		color: var(--m-ink-soft);
		line-height: 1.5;
	}

	.ab-studio-links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem;
	}

	.ab-studio-links .m-btn {
		gap: 0.45rem;
	}

	.ab-end-actions {
		justify-content: center;
	}
</style>
