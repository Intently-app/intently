---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/info-pages.css';
import BreadcrumbSchema from '../components/SEO/BreadcrumbSchema.astro';
import FAQSchema from '../components/SEO/FAQSchema.astro';
import JumpNav from '../components/ui/JumpNav.astro';

const MCP_URL = 'https://respite-api.liveintently.app/mcp';
const PAGE_URL = 'https://respite.liveintently.app/ai/';

const title = 'AI Screen Time App: Connect Claude or ChatGPT to Respite';
const description =
	'Respite is, to our knowledge, the first mobile screen time app with a built-in MCP server. Connect Claude, ChatGPT or Cursor and ask about your real usage.';

// 40-60 words, quotable on its own.
const answer =
	'Respite is, to our knowledge, the first mobile screen time app with a built-in MCP server (November 2026). With Respite Plus you connect your own AI, such as Claude, ChatGPT or Cursor, and ask about your real usage, limits and progress. It reads by default; if you opt in it can also make your limits stricter, but never loosen one without your approval. Respite runs no AI of its own, and you can disconnect any time.';

const prompts = [
	{
		prompt: 'How did my screen time this week compare with last week, and which apps changed most?',
		tool: 'get_insights',
	},
	{
		prompt: 'Which apps do I use most across my phone and browser, and how often do I open them?',
		tool: 'get_usage',
	},
	{
		prompt: 'Did I stay within my limits this week? Which limit do I break most often, and on which days?',
		tool: 'get_insights',
	},
	{
		prompt: 'When Respite paused me at a limit, how often did I walk away, and for which apps?',
		tool: 'get_insights, list_events',
	},
	{
		prompt: 'Compare my Android and iPhone usage for the last two weeks.',
		tool: 'get_usage',
	},
	{
		prompt: 'List my limits and schedules. Which ones look too loose compared with what I actually do?',
		tool: 'list_limits, get_usage',
	},
	{
		prompt: 'Show the last 20 times I was interrupted at a limit and what I chose.',
		tool: 'list_events',
	},
	{
		prompt: 'What is my streak, how many acorns do I have, and what are today\'s quests?',
		tool: 'get_progress',
	},
];

const tools = [
	{ name: 'get_account', what: 'Your plan, devices and when this AI was connected. Works on the free plan.', plus: false },
	{ name: 'get_usage', what: 'Minutes per app or per day over a range of up to 92 days, merged across your devices.', plus: true },
	{ name: 'get_insights', what: 'This period against the one before: top apps, busiest day, limits kept, walk-aways, your first-week baseline.', plus: true },
	{ name: 'list_limits', what: 'Your per-app daily limits and blocking schedules.', plus: true },
	{ name: 'list_events', what: 'Raw sessions, or the moments Respite interrupted you at a limit and what you chose.', plus: true },
	{ name: 'get_progress', what: 'Acorns, XP and level, streak, streak freezes, quests and your league tier (never other people).', plus: true },
	{ name: 'list_changes', what: 'A read-only list of the changes AIs made to your limits and schedules, and requests waiting for your approval.', plus: true },
];

// Opt-in: the person ticks "Also let it make my limits stricter" on the approval page.
const writeTools = [
	{ name: 'set_limit', what: 'Add or lower a per-app daily limit. Applies at once. Raising a limit becomes a request you approve.' },
	{ name: 'add_schedule', what: 'Add a blocking schedule. Applies at once.' },
	{ name: 'remove_limit', what: 'Always becomes a request you approve; nothing is removed on its own.' },
	{ name: 'remove_schedule', what: 'Always becomes a request you approve; nothing is removed on its own.' },
	{ name: 'undo_change', what: 'Lets an AI undo a change it made itself.' },
];

const live = [
	['Connect Claude, ChatGPT, Cursor or another remote MCP client with OAuth sign-in', 'Live'],
	['Read your usage, insights, limits, schedules, sessions, interventions and game progress', 'Live (Respite Plus)'],
	['Resources respite://today and respite://week with ready-made summaries', 'Live (Respite Plus)'],
	['Connections are read-only unless you tick \"Also let it make my limits stricter\" on the approval page; connections made before this update stay read-only until you reconnect', 'Live'],
	['AI makes your limits stricter: lower a limit or add a schedule, applied at once and synced to your devices (opt-in)', 'Live (Respite Plus)'],
	['Loosening (raising or removing a limit, removing a schedule) never applies on its own: it becomes a request, which expires after 7 days', 'Live'],
	['A log of every AI change (which AI, what, before and after, the reason it gave), kept 90 days, with undo for the AI\'s own changes; at most 30 changes per connection per hour', 'Live'],
	['A Connected AI screen in the Respite app to approve requests and remove connections; until it arrives you change limits yourself in the app', 'Coming in app updates'],
	['An AI changing your pause messages or custom rules', 'Planned'],
];

const compare = [
	['How the AI is provided', 'Your own Claude, ChatGPT or Cursor account, over MCP', 'A coach built into the app, run by the app maker', 'Your own assistant, over MCP'],
	['Platforms', 'Android, iPhone, Chrome', 'Mostly iPhone only (FOMO, Zensi, Argue, No Scroll AI)', 'macOS full; Windows and Linux via hosts file; Chrome add-on'],
	['What the AI sees', 'Your synced Respite usage and limits, only when you ask', 'What you tell the coach, plus the app\'s usage data', 'Which sites are blocked; task-aware blocking sends a page excerpt'],
	['What it does today', 'Reads and explains your data; with opt-in, makes limits stricter', 'Talks you out of opening a blocked app', 'Blocks sites and starts focus sessions'],
	['Typical price', 'Respite Plus: $4.99 a month; you pay your AI separately', 'Around $9 to $10 a month for the apps that list a price', '$2.99 a month, $29.99 a year'],
];

const faqs = [
	{
		question: 'What is the best AI screen time app?',
		answer:
			'It depends on where you want the AI to live. Apps such as FOMO and Zensi build a coach into the app, mostly on iPhone. Respite takes the other route: it runs no AI, and you connect your own Claude, ChatGPT or Cursor to your real usage through MCP, on Android, iPhone and Chrome. See our comparison for the trade-offs.',
	},
	{
		question: 'Can ChatGPT or Claude see my screen time?',
		answer:
			'Only if you connect them. Out of the box, neither can read your phone. With Respite Plus you add Respite as a custom connector, sign in and allow access, after which the assistant can fetch your synced usage, insights and limits when you ask. It sees nothing before you connect and nothing after you disconnect.',
	},
	{
		question: 'What is a screen time MCP server?',
		answer:
			'MCP, the Model Context Protocol, is an open standard that lets an AI assistant call tools in another app. A screen time MCP server exposes your usage and limits as tools. Respite hosts one at https://respite-api.liveintently.app/mcp, with OAuth sign-in, so your own AI can answer questions about your data.',
	},
	{
		question: 'Is Respite really the first screen time app with an MCP server?',
		answer:
			'To our knowledge, Respite is the first mobile screen time app with a built-in MCP server, as of November 2026. We do not claim to be the only screen time product with MCP: LockIn MCP is a desktop website blocker driven by your AI, and community-made MCP servers read Mac Screen Time or RescueTime data.',
	},
	{
		question: 'Does Respite run an AI on my data?',
		answer:
			'No. Respite runs no AI model on your data and does not train models on it. When you connect Claude, ChatGPT or Cursor, the answers to your questions are sent to that assistant, and its provider handles them under its own policy. Respite only returns what you ask for, for the permissions you allowed.',
	},
	{
		question: 'Can my AI change my limits?',
		answer:
			'Only to make them stricter, and only if you opt in. On Respite\'s approval page you can tick "Also let it make my limits stricter" (unticked by default); then your AI can lower a limit or add a schedule, and that applies at once. Raising or removing a limit, or removing a schedule, never applies on its own: it becomes a request you approve in the Respite app, which is arriving in app updates, and requests expire after 7 days. Every change is logged for 90 days, and an AI can undo its own changes. Connections made before this update stay read-only until you reconnect.',
	},
	{
		question: 'Do I need Respite Plus to connect an AI?',
		answer:
			'Yes, to read your data. The account tool works on a free account so the connection can tell you what is missing, but usage, insights, limits, events and progress need Respite Plus. At the time of writing Plus is $4.99 a month, $29.99 a year with a one-week free trial, or $59.99 lifetime; the stores set prices by country.',
	},
	{
		question: 'How do I disconnect an AI from Respite?',
		answer:
			'Remove or disconnect the Respite connector in your AI app\'s connector settings, which ends its access. Deleting your Respite account also ends every connection. A Connected AI screen inside the Respite app is arriving in app updates.',
	},
];

const softwareApplication = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	'@id': 'https://respite.liveintently.app/#software',
	name: 'Respite: Screen Time Control',
	alternateName: 'Respite',
	description:
		'Respite: Screen Time Control is a free screen time app for Android, iPhone and Chrome by Intently. It puts a short pause before the apps and sites you pick, with limits, streaks and a free game layer. Respite Plus adds sync and lets you connect your own AI, such as Claude, ChatGPT or Cursor, through an MCP server.',
	url: 'https://respite.liveintently.app/',
	applicationCategory: 'HealthApplication',
	operatingSystem: 'Android, iOS, Chrome',
	author: { '@type': 'Organization', '@id': 'https://liveintently.app/#organization', name: 'Intently', url: 'https://liveintently.app' },
	offers: [
		{ '@type': 'Offer', name: 'Respite (free)', price: '0', priceCurrency: 'USD' },
		{ '@type': 'Offer', name: 'Respite Plus, monthly', price: '4.99', priceCurrency: 'USD', description: 'Sync across devices and bring your own AI. Store prices vary by country.' },
		{ '@type': 'Offer', name: 'Respite Plus, yearly', price: '29.99', priceCurrency: 'USD', description: 'One-week free trial. Store prices vary by country.' },
		{ '@type': 'Offer', name: 'Respite Plus, lifetime', price: '59.99', priceCurrency: 'USD', description: 'One-time purchase. Store prices vary by country.' },
	],
	featureList: [
		'Short pause before the apps and sites you pick',
		'Daily limits, schedules and streaks',
		'Remote MCP server with OAuth for Claude, ChatGPT and Cursor (Respite Plus; read tools plus opt-in tools that make limits stricter)',
	],
};

const webPage = {
	'@context': 'https://schema.org',
	'@type': 'WebPage',
	'@id': PAGE_URL,
	url: PAGE_URL,
	name: title,
	description,
	inLanguage: 'en-US',
	dateModified: '2026-11-03',
	isPartOf: { '@id': 'https://respite.liveintently.app/#website' },
	about: { '@id': 'https://respite.liveintently.app/#software' },
	mainEntity: { '@id': 'https://respite.liveintently.app/#software' },
};

// Setup per assistant, from the connect guides on the blog. Steps may contain simple HTML.
const setups = [
	{
		id: 'claude',
		name: 'Claude',
		steps: [
			'In Claude.ai or Claude Desktop, open <strong>Settings</strong>, then <strong>Connectors</strong>.',
			'Choose <strong>Add custom connector</strong>, name it Respite and paste the address.',
			'Sign in with Google or Apple and choose <strong>Allow</strong>. Tick "Also let it make my limits stricter" only if you want that.',
		],
		command: '',
		note: 'Remote servers like Respite go in Connectors, not in claude_desktop_config.json.',
		guide: '/blog/connect-claude-to-screen-time/',
	},
	{
		id: 'claude-code',
		name: 'Claude Code',
		steps: [
			'Run the command below. Add <code>--scope user</code> to have Respite in every project.',
			'Start Claude Code, type <code>/mcp</code>, select <strong>respite</strong> and choose to authenticate.',
			'Your browser opens the Respite sign-in page. Sign in and allow.',
		],
		command: `claude mcp add --transport http respite ${MCP_URL}`,
		note: 'To remove it later: claude mcp remove respite.',
		guide: '/blog/connect-claude-to-screen-time/',
	},
	{
		id: 'chatgpt',
		name: 'ChatGPT',
		steps: [
			'Open <strong>Settings</strong> and find <strong>connectors</strong> (some versions say <strong>apps</strong>). Turn on developer mode there if your plan requires it.',
			'Create a new connector with the name Respite and the address, and choose <strong>OAuth</strong>.',
			'Sign in with Google or Apple and choose <strong>Allow</strong>, then switch Respite on in a new chat.',
		],
		command: '',
		note: 'Custom connectors depend on your ChatGPT plan; on Business, Enterprise or Edu an admin may need to allow them.',
		guide: '/blog/connect-chatgpt-to-phone-usage/',
	},
	{
		id: 'cursor',
		name: 'Cursor and others',
		steps: [
			'Add a <strong>remote (HTTP) MCP server</strong> with the address.',
			'The assistant registers itself with Respite and opens your browser.',
			'Sign in with Google or Apple and allow.',
		],
		command: '',
		note: 'Works with any assistant that supports remote MCP servers with OAuth.',
		guide: '/blog/connect-claude-chatgpt-cursor-to-respite-mcp/',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<BreadcrumbSchema
			items={[
				{ name: 'Home', url: 'https://respite.liveintently.app/' },
				{ name: 'AI and screen time', url: PAGE_URL },
			]}
		/>
		<script type="application/ld+json" set:html={JSON.stringify(softwareApplication)} />
		<script type="application/ld+json" set:html={JSON.stringify(webPage)} />
		<FAQSchema faqs={faqs} />
	</head>
	<body class="ip-page">
		<Header />

		<main class="ip">
			<header class="ip-head">
				<h1>AI Screen Time App: Connect Claude or ChatGPT to Your Real Phone Data</h1>
				<p class="ip-dek">{answer}</p>
				<ul class="ip-facts" aria-label="At a glance">
					<li>Reads by default</li>
					<li>Stricter limits only if you opt in</li>
					<li>Respite runs no AI</li>
					<li>Disconnect any time</li>
				</ul>
				<p class="ai-meta"><span class="ip-badge ip-badge-plus">Respite Plus</span> Updated November 2026.</p>
			</header>

			<JumpNav links={[{ href: '#setup', label: 'Set it up' }, { href: '#ask', label: 'What to ask' }, { href: '#can', label: 'What it can do' }, { href: '#status', label: "What's live" }, { href: '#privacy', label: 'Privacy' }, { href: '#compare', label: 'Compared' }, { href: '#faq', label: 'Questions' }]} />

			<section class="ip-section" id="setup" aria-labelledby="setup-title">
				<h2 id="setup-title">Set it up in about two minutes</h2>
				<p class="ip-lead">Every assistant uses the same address. Add it as a custom connector, sign in with the Google or Apple account you use in Respite, and allow access.</p>

				<div class="ai-address">
					<label for="mcp-url">Respite's MCP server</label>
					<div class="ai-copyline">
						<input id="mcp-url" type="text" value={MCP_URL} readonly />
						<button type="button" class="ip-copy" data-copy={MCP_URL}>Copy address</button>
					</div>
				</div>

				<div class="ai-tabs" data-tabs>
					<div class="ai-tablist" role="tablist" aria-label="Your AI app">
						{setups.map((s, i) => (
							<button type="button" role="tab" id={`tab-${s.id}`} aria-controls={`panel-${s.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{s.name}</button>
						))}
					</div>
					{setups.map((s, i) => (
						<div class="ai-panel" role="tabpanel" id={`panel-${s.id}`} aria-labelledby={`tab-${s.id}`} hidden={i !== 0}>
							<ol class="ai-steps">
								{s.steps.map((step) => <li><span set:html={step} /></li>)}
							</ol>
							{s.command && (
								<div class="ai-copyline ai-command">
									<code>{s.command}</code>
									<button type="button" class="ip-copy" data-copy={s.command}>Copy command</button>
								</div>
							)}
							<p class="ip-note">{s.note} <a href={s.guide}>Full {s.name} guide</a></p>
						</div>
					))}
				</div>
			</section>

			<section class="ip-section" id="ask" aria-labelledby="ask-title">
				<h2 id="ask-title">What can I ask?</h2>
				<p class="ip-lead">Copy one to start. Your AI picks the right tool; you just ask in plain language.</p>
				<ul class="ai-prompts">
					{prompts.map((p) => (
						<li>
							<p class="ai-prompt">{p.prompt}</p>
							<span class="ai-tool">{p.tool}</span>
							<button type="button" class="ip-copy" data-copy={p.prompt} aria-label={`Copy prompt: ${p.prompt}`}>Copy</button>
						</li>
					))}
				</ul>
				<p class="ip-note">With the opt-in, try "Lower my Instagram limit to 20 minutes on weekdays" or "Add a schedule that blocks TikTok and YouTube 10pm to 7am". More in <a href="/blog/chatgpt-claude-screen-time-prompts/">30 prompts for your screen time</a>.</p>
			</section>

			<section class="ip-section" id="can" aria-labelledby="can-title">
				<h2 id="can-title">What your AI can and can't do</h2>
				<p class="ip-lead">Reading is part of every connection. Changing anything is a separate choice, and loosening a limit is never automatic.</p>
				<div class="ai-perms">
					<div class="ai-perm">
						<h3>Always, once connected</h3>
						<ul>
							<li>Read your usage, insights, limits and schedules</li>
							<li>Read your sessions and the moments you were paused</li>
							<li>Read your streak, acorns, quests and league tier</li>
						</ul>
					</div>
					<div class="ai-perm">
						<h3>Only if you tick the box</h3>
						<ul>
							<li>Lower a daily limit, applied at once</li>
							<li>Add a blocking schedule, applied at once</li>
							<li>Undo a change it made itself</li>
						</ul>
					</div>
					<div class="ai-perm">
						<h3>Only with your approval</h3>
						<ul>
							<li>Raise or remove a limit</li>
							<li>Remove a schedule</li>
							<li>Requests expire after 7 days</li>
						</ul>
					</div>
					<div class="ai-perm ai-perm-never">
						<h3>Never</h3>
						<ul>
							<li>Change pause messages or custom rules</li>
							<li>Write usage history, earn or spend acorns</li>
							<li>Block apps outside your limits and schedules</li>
						</ul>
					</div>
				</div>
				<p class="ip-note">Every AI change is logged for 90 days with which AI, what changed and the reason it gave, and each connection can make at most 30 changes an hour. <a href="/blog/let-ai-change-your-limits/">How AI changes to limits work</a>.</p>

				<details class="ai-ref">
					<summary>Tool reference for the technically curious</summary>
					<h3>Read tools</h3>
					<div class="ip-table-wrap" role="region" aria-label="Read tools" tabindex="0">
						<table class="ip-table">
							<thead><tr><th>Tool</th><th>What it returns</th><th>Plan</th></tr></thead>
							<tbody>
								{tools.map((t) => (
									<tr><td><code>{t.name}</code></td><td>{t.what}</td><td>{t.plus ? 'Plus' : 'Free'}</td></tr>
								))}
							</tbody>
						</table>
					</div>
					<h3>Opt-in tools that make limits stricter</h3>
					<div class="ip-table-wrap" role="region" aria-label="Opt-in tools" tabindex="0">
						<table class="ip-table">
							<thead><tr><th>Tool</th><th>What it does</th></tr></thead>
							<tbody>
								{writeTools.map((t) => (
									<tr><td><code>{t.name}</code></td><td>{t.what}</td></tr>
								))}
							</tbody>
						</table>
					</div>
					<p class="ip-note">Resources <code>respite://today</code> and <code>respite://week</code> give ready-made summaries. New to the term? <a href="/blog/what-is-an-mcp-server/">What an MCP server is, in plain English</a>.</p>
				</details>
			</section>

			<section class="ip-section" id="status" aria-labelledby="status-title">
				<h2 id="status-title">What is live and what is coming?</h2>
				<p class="ip-lead">We describe a tool as available only when it is.</p>
				<ul class="ai-status">
					{live.map(([what, state]) => (
						<li>
							<span class={`ip-badge ${state.startsWith('Live') ? 'ip-badge-live' : 'ip-badge-soon'}`}>{state}</span>
							<span>{what}</span>
						</li>
					))}
				</ul>
				<p class="ip-note">The <a href="/whats-new/">What's new</a> page says when each one ships. Background: <a href="/blog/bring-your-own-ai-to-respite/">bring your own AI to Respite</a>.</p>
			</section>

			<section class="ip-section" id="privacy" aria-labelledby="privacy-title">
				<h2 id="privacy-title">Is it private?</h2>
				<ul class="ai-plain">
					<li><strong>Your AI provider handles the data.</strong> What a tool returns goes into your chat, so the assistant's provider (Anthropic, OpenAI, Cursor or another) processes it under its own policy and your account settings there.</li>
					<li><strong>Respite runs no AI</strong> on your data and does not train models on it. Respite only answers the calls your connected AI makes.</li>
					<li><strong>You choose the permissions</strong> on the consent screen, and tools that need a permission you did not grant return an error instead of data.</li>
					<li><strong>You can disconnect</strong> in your AI app's connector settings. Deleting your Respite account ends every connection.</li>
					<li><strong>Only synced data.</strong> The AI sees what your devices sync to your account, not what stays on a device.</li>
				</ul>
				<p class="ip-note">
					Read <a href="/blog/is-it-safe-to-give-ai-your-screen-time-data/">is it safe to give an AI your screen time data?</a>
					Policies: <a href="/privacy/">iPhone</a>, <a href="/privacy/android/">Android</a>, <a href="/privacy/chrome/">Chrome</a>.
				</p>
			</section>

			<section class="ip-section" id="compare" aria-labelledby="compare-title">
				<h2 id="compare-title">Respite vs in-app AI coaches</h2>
				<p class="ip-lead">Two different ideas of "AI screen time". Facts checked November 2026; sources in our <a href="/blog/ai-screen-time-coach-apps-compared/">coach comparison</a>.</p>
				<div class="ip-table-wrap" role="region" aria-label="Respite compared with AI coach apps and LockIn MCP" tabindex="0">
					<table class="ip-table ai-compare">
						<thead>
							<tr><th scope="col"><span class="ip-visually-hidden">Question</span></th><th scope="col" class="ip-col-hi">Respite (bring your own AI)</th><th scope="col">In-app AI coach apps</th><th scope="col">LockIn MCP</th></tr>
						</thead>
						<tbody>
							{compare.map((row) => (
								<tr><th scope="row">{row[0]}</th><td class="ip-col-hi">{row[1]}</td><td>{row[2]}</td><td>{row[3]}</td></tr>
							))}
						</tbody>
					</table>
				</div>
				<p class="ip-note">
					Coach apps are not worse: if you want an AI to talk you out of an app at the moment you tap it, that is exactly what they do and Respite does not (yet).
					LockIn MCP is a desktop website blocker; see <a href="/blog/respite-vs-lockin-mcp/">Respite vs LockIn MCP</a>. For the full picture, read
					<a href="/blog/best-ai-app-blockers-screen-time-apps-2026/">best AI app blockers and screen time apps in 2026</a>.
				</p>
			</section>

			<section class="ip-end" aria-labelledby="end-title">
				<h2 id="end-title">Try it with your own data</h2>
				<p>Respite is free to start on Android, iPhone and Chrome. Plus adds sync and bring your own AI.</p>
				<div class="ip-actions">
					<a href="/download/" class="ip-button">Download Respite</a>
					<a href="/blog/respite-plus-whats-included/" class="ip-button ip-button-quiet">What Plus includes</a>
				</div>
			</section>

			<section class="ip-section ip-faq" id="faq" aria-labelledby="faq-title">
				<h2 id="faq-title">Frequently asked questions</h2>
				{faqs.map((faq) => (
					<details>
						<summary>{faq.question}</summary>
						<p>{faq.answer}</p>
					</details>
				))}
			</section>
		</main>

		<Footer />
		<p class="ip-visually-hidden" id="copy-status" role="status" aria-live="polite"></p>

		<script>
			// Copy buttons: address, commands and prompts.
			const status = document.getElementById('copy-status');
			document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => {
				const label = b.textContent;
				b.addEventListener('click', async () => {
					try {
						await navigator.clipboard.writeText(b.dataset.copy ?? '');
						b.dataset.copied = '';
						b.textContent = 'Copied';
						if (status) status.textContent = 'Copied to the clipboard';
						setTimeout(() => {
							delete b.dataset.copied;
							b.textContent = label;
						}, 1600);
					} catch {
						const input = document.getElementById('mcp-url') as HTMLInputElement | null;
						if (input && b.dataset.copy === input.value) input.select();
					}
				});
			});
			document.getElementById('mcp-url')?.addEventListener('focus', (e) => (e.target as HTMLInputElement).select());

			// Tabs (WAI-ARIA pattern): click or arrow keys; the choice is remembered in the URL hash.
			const tablist = document.querySelector<HTMLElement>('[role="tablist"]');
			const tabs = [...(tablist?.querySelectorAll<HTMLButtonElement>('[role="tab"]') ?? [])];
			function select(tab: HTMLButtonElement, focus = false) {
				tabs.forEach((t) => {
					const on = t === tab;
					t.setAttribute('aria-selected', String(on));
					t.tabIndex = on ? 0 : -1;
					document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
				});
				if (focus) tab.focus();
			}
			tabs.forEach((t, i) => {
				t.addEventListener('click', () => select(t));
				t.addEventListener('keydown', (e) => {
					const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
					if (step) {
						e.preventDefault();
						select(tabs[(i + step + tabs.length) % tabs.length], true);
					}
					if (e.key === 'Home') select(tabs[0], true);
					if (e.key === 'End') select(tabs[tabs.length - 1], true);
				});
			});
		</script>
	</body>
</html>

