---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/info-pages.css';
import BreadcrumbSchema from '../components/SEO/BreadcrumbSchema.astro';
import FAQSchema from '../components/SEO/FAQSchema.astro';
import RespiteAppSchema from '../components/SEO/RespiteAppSchema.astro';
import Biscuit from '../components/ui/Biscuit.astro';
import Icon from '../components/ui/Icon.astro';
import AppShot from '../components/ui/AppShot.astro';
import AppIcon from '../components/ui/AppIcon.astro';

const MCP_URL = 'https://respite-api.liveintently.app/mcp';
const PAGE_URL = 'https://respite.liveintently.app/ai/';
const title = 'AI Screen Time App: Connect Claude or ChatGPT to Respite';
const description =
	'Respite is, to our knowledge, the first mobile screen time app with a built-in MCP server. Connect Claude, ChatGPT or Cursor and ask about your real usage.';

// What the AI can do, each with a real app screen (public/images/app/). `chat` draws a short conversation instead.
const abilities: { id: string; title: string; line: string; shot?: string }[] = [
	{ id: 'ask', title: 'Ask about your week', line: 'Your real usage, limits and streak, in plain words.' },
	{ id: 'stricter', title: 'Make limits stricter', line: 'Lower a limit or add a schedule. It applies at once, with undo.', shot: 'ai-changes' },
	{ id: 'looser', title: 'Looser needs your yes', line: 'Raising or removing a limit is a request you approve in the app.', shot: 'ai' },
	{ id: 'focus', title: 'Focus when you ask', line: 'It can start a focus session. Ending early asks you.', shot: 'focus' },
	{ id: 'note', title: 'A note at the pause', line: 'A short line from your AI, on the pause screen.', shot: 'ai-note-ios' },
	{ id: 'messages', title: 'You stay in charge', line: 'See every message and change it made, and remove any.', shot: 'ai-messages' },
];

const asks = [
	'How did my screen time this week compare with last week?',
	'Which limit do I break most often, and on which days?',
	'Lower Instagram to 45 minutes and add a bedtime schedule.',
	'Leave me a note when I open YouTube after 10 pm.',
];

const compare = [
	['How the AI is provided', 'Your own Claude, ChatGPT or Cursor', 'A coach built into the app', 'Your own assistant'],
	['Platforms', 'Android, iPhone, Chrome', 'Mostly iPhone (FOMO, Zensi, Argue, No Scroll AI)', 'Mac; Windows and Linux via hosts file'],
	['What it does', 'Explains your data, makes limits stricter, leaves pause notes, starts focus', 'Talks you out of opening an app', 'Blocks sites, starts focus sessions'],
	['Typical price', 'Respite Plus $4.99 a month, plus your AI', 'About $9 to $10 a month', '$2.99 a month'],
];

const faqs = [
	{
		question: 'Can ChatGPT or Claude see my screen time?',
		answer:
			'Only if you connect them. With Respite Plus you add Respite as a connector in Claude, ChatGPT or Cursor, sign in and choose what it may do. It then reads your synced usage, insights and limits when you ask, and sees nothing after you disconnect.',
	},
	{
		question: 'Does Respite run an AI on my data?',
		answer:
			'No. Respite runs no AI model on your data and trains none on it. When you connect your own assistant, the answers go to that assistant, and its provider handles them under its own policy.',
	},
	{
		question: 'Can my AI change my limits?',
		answer:
			'Only to make them stricter, and only if you allow it when you connect. Then it can lower a limit, add a schedule, leave a pause message or start a focus session, and that applies at once. Raising or removing a limit, ending a focus session early or unblocking an app is only a request: you approve or decline it in the Respite app, under You › Connected AI. Every change is logged, and you can undo it.',
	},
	{
		question: 'Is there a screen time app with an MCP server?',
		answer:
			'Yes. Respite has a built-in MCP server, so Claude, ChatGPT, Cursor and other MCP clients can connect to your Respite account with Respite Plus. To our knowledge it is the first mobile screen time app with a built-in MCP server (November 2026). LockIn MCP does something similar for desktop website blocking.',
	},
	{
		question: 'Do I need Respite Plus to connect an AI?',
		answer:
			'Yes. At the time of writing Plus is $4.99 a month, $29.99 a year with a one-week free trial, or $59.99 once; the stores set prices by country. Your AI app is paid for separately, if it costs anything.',
	},
	{
		question: 'How do I disconnect an AI from Respite?',
		answer:
			"In the Respite app, open You › Connected AI and choose Disconnect, or remove the connector in your AI app. Deleting your Respite account ends every connection.",
	},
];

// The Respite entity (SoftwareApplication, with the free and Plus offers) comes from RespiteAppSchema.astro,
// shared with /, /features/ and /compare/ so every page describes the app the same way.
const webPage = {
	'@context': 'https://schema.org',
	'@type': 'WebPage',
	'@id': PAGE_URL,
	url: PAGE_URL,
	name: title,
	description,
	inLanguage: 'en-US',
	dateModified: '2026-11-12',
	isPartOf: { '@id': 'https://respite.liveintently.app/#website' },
	about: { '@id': 'https://respite.liveintently.app/#software' },
	mainEntity: { '@id': 'https://respite.liveintently.app/#software' },
};

---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<BreadcrumbSchema
			items={[
				{ name: 'Home', url: 'https://respite.liveintently.app/' },
				{ name: 'AI and screen time', url: PAGE_URL },
			]}
		/>
		<RespiteAppSchema />
		<script type="application/ld+json" set:html={JSON.stringify(webPage)} />
		<FAQSchema faqs={faqs} />
	</head>
	<body class="m-page">
		<Header />

		<main class="m">
			<section class="ai-hero" aria-labelledby="ai-title">
				<div class="ai-hero-copy">
					<span class="m-badge is-plus">Respite Plus</span>
					<h1 id="ai-title">Your AI, on your real screen time</h1>
					<p class="m-dek">Connect Claude or ChatGPT to Respite. Ask about your week, and let it make your limits stricter.</p>
					<div class="m-actions">
						<a href="#connect" class="m-btn">Connect your AI</a>
						<a href="#can" class="m-btn is-soft">What it can do</a>
					</div>
					<ul class="m-pills" aria-label="Good to know">
						<li><Icon name="Check" size={18} />Respite runs no AI</li>
						<li><Icon name="Check" size={18} />Looser always asks you</li>
					</ul>
				</div>
				<div class="ai-stage" role="img" aria-label="Respite's Connected AI screen with a request from Claude waiting for your yes, and Biscuit the fox reading a chart">
					<div class="ai-phone" aria-hidden="true"><AppShot slug="hero-ai" alt="" loading="eager" fetchpriority="high" /></div>
					<div class="ai-stage-icons" aria-hidden="true">
						<AppIcon app="claude" size={56} />
						<AppIcon app="openai" size={56} />
					</div>
					<div class="ai-stage-biscuit" aria-hidden="true"><Biscuit mood="read_chart" size={150} label="Biscuit reading a chart" /></div>
				</div>
			</section>

			<section class="m-section" id="can" aria-labelledby="can-title">
				<h2 id="can-title" class="m-h2 ai-center">What your AI can do</h2>
				<div class="ai-masonry">
					{abilities.map((a) => (
						<section class="ai-card" aria-labelledby={`${a.id}-title`}>
							{a.shot ? (
								<AppShot slug={a.shot} class="ai-card-shot" />
							) : (
								<div class="ai-chat" aria-hidden="true">
									<p class="ai-bubble is-you">How did this week go?</p>
									<div class="ai-reply">
										<AppIcon app="claude" size={32} />
										<p class="ai-bubble">3h 12m a day, 18% less than last week. Instagram dropped the most. Weekends are still your busiest days.</p>
									</div>
								</div>
							)}
							<div class="ai-card-copy">
								<h3 id={`${a.id}-title`}>{a.title}</h3>
								<p>{a.line}</p>
							</div>
						</section>
					))}
				</div>
			</section>

			<section class="m-section" id="connect" aria-labelledby="connect-title">
				<h2 id="connect-title" class="m-h2 ai-center">Connect in 3 steps</h2>
				<ol class="ai-steps">
					<li class="ai-step">
						<div class="ai-step-art" aria-hidden="true">
							<AppIcon app="claude" size={64} />
							<AppIcon app="openai" size={64} />
						</div>
						<span class="m-tile is-number">1</span>
						<h3>Open connectors</h3>
						<p>In Claude or ChatGPT, open Settings, then Connectors.</p>
					</li>
					<li class="ai-step">
						<div class="ai-step-art">
							<div class="ai-address">
								<code id="mcp-url">{MCP_URL.replace('https://', '')}</code>
								<button type="button" class="m-btn ai-copy" data-copy={MCP_URL} data-done="Copied">Copy</button>
							</div>
						</div>
						<span class="m-tile is-number">2</span>
						<h3>Add Respite</h3>
						<p>Add a custom connector called Respite with this address.</p>
					</li>
					<li class="ai-step">
						<div class="ai-step-art" aria-hidden="true">
							<ul class="ai-allow">
								<li><Icon name="Check" size={16} />See usage and limits</li>
								<li><Icon name="Check" size={16} />Make limits stricter</li>
								<li class="is-off">Optional, off until you tick it</li>
							</ul>
						</div>
						<span class="m-tile is-number">3</span>
						<h3>Sign in and choose</h3>
						<p>Sign in with Google or Apple, and pick what it may do.</p>
					</li>
				</ol>
				<p class="m-caption ai-center">Step by step: <a href="/blog/connect-claude-to-screen-time/">Claude</a>, <a href="/blog/connect-chatgpt-to-phone-usage/">ChatGPT</a>, <a href="/blog/connect-claude-chatgpt-cursor-to-respite-mcp/">Cursor and others</a>. <span class="m-sr" role="status" id="copy-status"></span></p>
			</section>

			<section class="m-section" id="ask" aria-labelledby="ask-title">
				<h2 id="ask-title" class="m-h2 ai-center">Things to ask</h2>
				<ul class="ai-asks">
					{asks.map((q) => <li class="ai-bubble is-you">{q}</li>)}
				</ul>
				<p class="m-caption ai-center">More in <a href="/blog/chatgpt-claude-screen-time-prompts/">30 prompts for your screen time</a>.</p>
			</section>

			<section class="m-section" id="privacy" aria-labelledby="privacy-title">
				<h2 id="privacy-title" class="m-h2">Is it private?</h2>
				<ul class="m-group">
					{[
						{ icon: 'Bot', title: 'Respite runs no AI', text: 'No model runs on your data, and none is trained on it.' },
						{ icon: 'Building2', title: 'Your AI provider handles the answers', text: 'What your AI reads goes into your chat, under its own policy.' },
						{ icon: 'KeyRound', title: 'You choose the permissions', text: 'Reading is the default. Stricter limits are off until you tick them.' },
						{ icon: 'Unplug', title: 'Disconnect any time', text: 'In the Respite app under You › Connected AI, or in your AI app.' },
						{ icon: 'RefreshCw', title: 'Only synced data', text: 'Your AI sees what your devices sync, not what stays on a device.' },
					].map((r) => (
						<li class="m-row">
							<span class="m-tile is-success" aria-hidden="true"><Icon name={r.icon} size={22} /></span>
							<div>
								<p class="m-row-title">{r.title}</p>
								<p class="m-row-text">{r.text}</p>
							</div>
						</li>
					))}
				</ul>
				<p class="m-caption">Read <a href="/blog/is-it-safe-to-give-ai-your-screen-time-data/">is it safe to give an AI your screen time data?</a></p>
			</section>

			<section class="m-section" id="compare" aria-labelledby="compare-title">
				<div class="m-section-head">
					<h2 id="compare-title">Respite vs in-app AI coaches</h2>
					<p class="m-caption">Checked November 2026. <a href="/blog/ai-screen-time-coach-apps-compared/">Sources</a></p>
				</div>
				<div class="ai-compare-wrap" role="region" aria-label="Respite compared with AI coach apps and LockIn MCP" tabindex="0">
					<table class="ai-compare">
						<thead>
							<tr><th scope="col"><span class="m-sr">Question</span></th><th scope="col" class="is-us">Respite</th><th scope="col">In-app AI coaches</th><th scope="col">LockIn MCP</th></tr>
						</thead>
						<tbody>
							{compare.map((row) => (
								<tr><th scope="row">{row[0]}</th><td class="is-us">{row[1]}</td><td>{row[2]}</td><td>{row[3]}</td></tr>
							))}
						</tbody>
					</table>
				</div>
			</section>

			<section class="m-section" id="faq" aria-labelledby="faq-title">
				<h2 id="faq-title" class="m-h2">Questions</h2>
				<div class="m-group m-faq">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.question}</summary>
							<p>{faq.answer}</p>
						</details>
					))}
				</div>
			</section>

			<section class="m-end" aria-labelledby="end-title" data-placement="final_cta">
				<Biscuit mood="cheer" size={120} label="Biscuit cheering" />
				<h2 id="end-title">Try it with your own data</h2>
				<p>Respite is free to start. Plus adds sync and your own AI.</p>
				<div class="m-actions">
					<a href="/download/" class="m-btn" data-cta="download">Download Respite</a>
					<a href="/features/#plans" class="m-btn is-soft" data-cta="plans">Free or Plus</a>
				</div>
			</section>
		</main>

		<Footer />

		<script>
			// One Copy button for the connector address.
			const status = document.getElementById('copy-status');
			document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => {
				const original = b.textContent;
				b.addEventListener('click', async () => {
					try {
						await navigator.clipboard.writeText(b.dataset.copy ?? '');
					} catch {
						const range = document.createRange();
						range.selectNodeContents(document.getElementById('mcp-url')!);
						getSelection()?.removeAllRanges();
						getSelection()?.addRange(range);
						return;
					}
					b.textContent = b.dataset.done ?? 'Copied';
					if (status) status.textContent = 'Address copied';
					setTimeout(() => (b.textContent = original), 1600);
				});
			});
		</script>
	</body>
</html>

<style>
	.ai-center {
		text-align: center;
	}

	/* ------------------------------------------------------------ hero */
	.ai-hero {
		display: grid;
		gap: 2.5rem;
		align-items: center;
	}

	@media (min-width: 920px) {
		.ai-hero {
			grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
			gap: 3.5rem;
		}
	}

	.ai-hero h1 {
		margin: 1rem 0 1.1rem;
		font-size: clamp(2.5rem, 1.7rem + 3.4vw, 4.2rem);
		font-weight: 800;
		line-height: 1.03;
		letter-spacing: -0.025em;
		text-wrap: balance;
	}

	.ai-hero .m-actions {
		margin: 1.75rem 0 1.25rem;
	}

	.ai-stage {
		position: relative;
		display: grid;
		place-items: center;
		min-height: 540px;
		padding: 2.5rem 1.5rem;
		border-radius: 36px;
		background: var(--m-accent-soft);
		overflow: hidden;
	}

	.ai-phone {
		width: 230px;
		padding: 6px;
		border-radius: 40px;
		background: #0e161c;
		box-shadow: var(--m-shadow-md);
	}

	.ai-phone :global(.m-shot) {
		border-radius: 34px;
	}

	.ai-stage-icons {
		position: absolute;
		top: 2rem;
		right: 2rem;
		display: grid;
		gap: 0.75rem;
	}

	.ai-stage-icons :global(.m-appicon) {
		box-shadow: var(--m-shadow-md);
	}

	.ai-stage-biscuit {
		position: absolute;
		left: 0.5rem;
		bottom: -0.5rem;
	}

	@media (max-width: 600px) {
		.ai-stage {
			min-height: 460px;
		}
		.ai-phone {
			width: 190px;
		}
		.ai-stage-icons {
			top: 1.25rem;
			right: 1rem;
		}
		.ai-stage-icons :global(.m-appicon) {
			--size: 44px !important;
		}
		.ai-stage-biscuit :global(*) {
			max-width: 110px;
			max-height: 110px;
		}
	}

	/* ------------------------------------------------------------ what it can do */
	.ai-masonry {
		columns: 1;
		column-gap: 1.25rem;
	}

	@media (min-width: 680px) {
		.ai-masonry {
			columns: 2;
		}
	}

	@media (min-width: 1040px) {
		.ai-masonry {
			columns: 3;
		}
	}

	.ai-card {
		display: flex;
		flex-direction: column;
		margin: 0 0 1.25rem;
		break-inside: avoid;
		border-radius: 28px;
		background: var(--m-paper);
		box-shadow: var(--m-shadow-sm);
		overflow: hidden;
	}

	.ai-card :global(.ai-card-shot),
	.ai-chat {
		margin: 0.6rem 0.6rem 0;
	}

	.ai-card-copy {
		display: grid;
		gap: 0.4rem;
		padding: 1.1rem 1.5rem 1.4rem;
	}

	.ai-card-copy h3 {
		margin: 0;
		font-size: 1.35rem;
		font-weight: 800;
	}

	.ai-card-copy p {
		margin: 0;
		color: var(--m-ink-soft);
		line-height: 1.5;
	}

	.ai-chat {
		display: grid;
		gap: 0.75rem;
		padding: 1.5rem 1.25rem;
		border-radius: 22px;
		background: var(--m-ground);
	}

	.ai-reply {
		display: flex;
		align-items: flex-end;
		gap: 0.6rem;
	}

	.ai-bubble {
		margin: 0;
		padding: 0.8rem 1.05rem;
		border-radius: 20px 20px 20px 6px;
		background: var(--m-paper);
		box-shadow: var(--m-shadow-sm);
		font-size: 0.98rem;
		line-height: 1.45;
	}

	.ai-bubble.is-you {
		justify-self: end;
		border-radius: 20px 20px 6px 20px;
		background: var(--m-accent);
		color: var(--m-on-accent, #fff);
		font-weight: 600;
	}

	/* ------------------------------------------------------------ connect */
	.ai-steps {
		display: grid;
		gap: 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	@media (min-width: 860px) {
		.ai-steps {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	.ai-step {
		display: grid;
		justify-items: center;
		align-content: start;
		gap: 0.6rem;
		padding: 0.6rem 0.6rem 1.75rem;
		border-radius: 28px;
		background: var(--m-paper);
		box-shadow: var(--m-shadow-sm);
		text-align: center;
	}

	.ai-step h3 {
		margin: 0;
		font-size: 1.3rem;
		font-weight: 800;
	}

	.ai-step p {
		margin: 0;
		padding: 0 1rem;
		color: var(--m-ink-soft);
		line-height: 1.5;
	}

	.ai-step .m-tile.is-number {
		width: 36px;
		height: 36px;
		margin-top: 0.75rem;
		border-radius: 50%;
	}

	.ai-step-art {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1rem;
		justify-self: stretch;
		min-height: 170px;
		padding: 1rem;
		border-radius: 22px;
		background: var(--m-ground);
	}

	.ai-step-art :global(.m-appicon) {
		box-shadow: var(--m-shadow-sm);
	}

	.ai-address {
		display: grid;
		gap: 0.75rem;
		justify-items: center;
		width: 100%;
	}

	.ai-address code {
		max-width: 100%;
		padding: 0.7rem 1rem;
		border-radius: 14px;
		background: var(--m-paper);
		box-shadow: var(--m-shadow-sm);
		font-size: 0.85rem;
		white-space: nowrap;
		user-select: all;
	}

	.ai-allow {
		display: grid;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
		text-align: left;
	}

	.ai-allow li {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.55rem 0.9rem;
		border-radius: 14px;
		background: var(--m-paper);
		box-shadow: var(--m-shadow-sm);
		font-weight: 600;
		font-size: 0.95rem;
	}

	.ai-allow li.is-off {
		background: none;
		box-shadow: none;
		color: var(--m-ink-soft);
		font-weight: 500;
		font-size: 0.85rem;
	}

	/* ------------------------------------------------------------ things to ask */
	.ai-asks {
		display: grid;
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	@media (min-width: 760px) {
		.ai-asks {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	.ai-asks .ai-bubble {
		justify-self: stretch;
		padding: 1rem 1.25rem;
		background: var(--m-paper);
		color: var(--m-ink);
		box-shadow: var(--m-shadow-sm);
	}

	/* ------------------------------------------------------------ compare */
	.ai-compare-wrap {
		overflow-x: auto;
		border-radius: 24px;
		background: var(--m-paper);
		box-shadow: var(--m-shadow-sm);
	}

	.ai-compare {
		width: 100%;
		min-width: 640px;
		border-collapse: collapse;
		font-size: 0.95rem;
	}

	.ai-compare th,
	.ai-compare td {
		padding: 0.9rem 1.1rem;
		text-align: left;
		vertical-align: top;
		line-height: 1.45;
	}

	.ai-compare tbody tr + tr > * {
		border-top: 1px solid var(--m-line, rgba(19, 34, 45, 0.08));
	}

	.ai-compare thead th {
		font-family: var(--font-heading);
		font-weight: 800;
	}

	.ai-compare tbody th {
		color: var(--m-ink-soft);
		font-weight: 600;
	}

	.ai-compare .is-us {
		background: var(--m-accent-soft);
		font-weight: 600;
	}
</style>
