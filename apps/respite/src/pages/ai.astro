---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/ui/Button.astro';
import BreadcrumbSchema from '../components/SEO/BreadcrumbSchema.astro';
import FAQSchema from '../components/SEO/FAQSchema.astro';

const MCP_URL = 'https://respite-api.liveintently.app/mcp';
const PAGE_URL = 'https://respite.liveintently.app/ai/';

const title = 'AI Screen Time App: Connect Claude or ChatGPT to Respite';
const description =
	'Respite is, to our knowledge, the first mobile screen time app with a built-in MCP server. Connect Claude, ChatGPT or Cursor and ask about your real usage.';

// 40-60 words, quotable on its own.
const answer =
	'Respite is, to our knowledge, the first mobile screen time app with a built-in MCP server (November 2026). With Respite Plus you connect your own AI, such as Claude, ChatGPT or Cursor, and ask about your real usage, limits and progress. It is read-only today, Respite runs no AI of its own, and you can disconnect any time.';

const prompts = [
	{
		prompt: 'How did my screen time this week compare with last week, and which apps changed most?',
		tool: 'get_insights',
	},
	{
		prompt: 'Which apps do I use most across my phone and browser, and how often do I open them?',
		tool: 'get_usage',
	},
	{
		prompt: 'Did I stay within my limits this week? Which limit do I break most often, and on which days?',
		tool: 'get_insights',
	},
	{
		prompt: 'When Respite paused me at a limit, how often did I walk away, and for which apps?',
		tool: 'get_insights, list_events',
	},
	{
		prompt: 'Compare my Android and iPhone usage for the last two weeks.',
		tool: 'get_usage',
	},
	{
		prompt: 'List my limits and schedules. Which ones look too loose compared with what I actually do?',
		tool: 'list_limits, get_usage',
	},
	{
		prompt: 'Show the last 20 times I was interrupted at a limit and what I chose.',
		tool: 'list_events',
	},
	{
		prompt: 'What is my streak, how many acorns do I have, and what are today\'s quests?',
		tool: 'get_progress',
	},
];

const tools = [
	{ name: 'get_account', what: 'Your plan, devices and when this AI was connected. Works on the free plan.', plus: false },
	{ name: 'get_usage', what: 'Minutes per app or per day over a range of up to 92 days, merged across your devices.', plus: true },
	{ name: 'get_insights', what: 'This period against the one before: top apps, busiest day, limits kept, walk-aways, your first-week baseline.', plus: true },
	{ name: 'list_limits', what: 'Your per-app daily limits and blocking schedules.', plus: true },
	{ name: 'list_events', what: 'Raw sessions, or the moments Respite interrupted you at a limit and what you chose.', plus: true },
	{ name: 'get_progress', what: 'Acorns, XP and level, streak, streak freezes, quests and your league tier (never other people).', plus: true },
];

const steps = [
	{
		n: '1',
		title: 'Add Respite to your AI',
		body: `In Claude, ChatGPT or Cursor, add a custom connector with the address ${MCP_URL}.`,
	},
	{
		n: '2',
		title: 'Sign in and allow',
		body: 'Your AI opens a Respite page. You sign in with Google or Apple, the same as in the app, and approve the permissions it asks for.',
	},
	{
		n: '3',
		title: 'Ask in plain language',
		body: 'Your AI decides which of Respite\'s read-only tools to call and answers from your own synced data.',
	},
	{
		n: '4',
		title: 'Disconnect whenever you like',
		body: 'Remove the connector in your AI app and its access ends. Deleting your Respite account ends every connection.',
	},
];

const live = [
	['Connect Claude, ChatGPT, Cursor or another remote MCP client with OAuth sign-in', 'Live'],
	['Read your usage, insights, limits, schedules, sessions, interventions and game progress', 'Live (Respite Plus)'],
	['Resources respite://today and respite://week with ready-made summaries', 'Live (Respite Plus)'],
	['Everything is read-only: your AI cannot change a limit or a schedule', 'Live'],
	['AI changes your limits and schedules: tightening applies at once, loosening needs your approval on the phone', 'Coming'],
	['A change log with undo for anything an AI changed', 'Coming'],
	['A Connected AI screen in the app to see and remove connections (iPhone first)', 'Coming'],
];

const compare = [
	['How the AI is provided', 'Your own Claude, ChatGPT or Cursor account, over MCP', 'A coach built into the app, run by the app maker', 'Your own assistant, over MCP'],
	['Platforms', 'Android, iPhone, Chrome', 'Mostly iPhone only (FOMO, Zensi, Argue, No Scroll AI)', 'macOS full; Windows and Linux via hosts file; Chrome add-on'],
	['What the AI sees', 'Your synced Respite usage and limits, only when you ask', 'What you tell the coach, plus the app\'s usage data', 'Which sites are blocked; task-aware blocking sends a page excerpt'],
	['What it does today', 'Reads and explains your data', 'Talks you out of opening a blocked app', 'Blocks sites and starts focus sessions'],
	['Typical price', 'Respite Plus: $4.99 a month; you pay your AI separately', 'Around $9 to $10 a month for the apps that list a price', '$2.99 a month, $29.99 a year'],
];

const faqs = [
	{
		question: 'What is the best AI screen time app?',
		answer:
			'It depends on where you want the AI to live. Apps such as FOMO and Zensi build a coach into the app, mostly on iPhone. Respite takes the other route: it runs no AI, and you connect your own Claude, ChatGPT or Cursor to your real usage through MCP, on Android, iPhone and Chrome. See our comparison for the trade-offs.',
	},
	{
		question: 'Can ChatGPT or Claude see my screen time?',
		answer:
			'Only if you connect them. Out of the box, neither can read your phone. With Respite Plus you add Respite as a custom connector, sign in and allow read access, after which the assistant can fetch your synced usage, insights and limits when you ask. It sees nothing before you connect and nothing after you disconnect.',
	},
	{
		question: 'What is a screen time MCP server?',
		answer:
			'MCP, the Model Context Protocol, is an open standard that lets an AI assistant call tools in another app. A screen time MCP server exposes your usage and limits as tools. Respite hosts one at https://respite-api.liveintently.app/mcp, with OAuth sign-in, so your own AI can answer questions about your data.',
	},
	{
		question: 'Is Respite really the first screen time app with an MCP server?',
		answer:
			'To our knowledge, Respite is the first mobile screen time app with a built-in MCP server, as of November 2026. We do not claim to be the only screen time product with MCP: LockIn MCP is a desktop website blocker driven by your AI, and community-made MCP servers read Mac Screen Time or RescueTime data.',
	},
	{
		question: 'Does Respite run an AI on my data?',
		answer:
			'No. Respite runs no AI model on your data and does not train models on it. When you connect Claude, ChatGPT or Cursor, the answers to your questions are sent to that assistant, and its provider handles them under its own policy. Respite only returns what you ask for, for the permissions you allowed.',
	},
	{
		question: 'Can my AI change my limits?',
		answer:
			'Not yet. Today every Respite tool is read-only. We are building tools that let an AI change limits and schedules: tightening would apply immediately, loosening would need your approval on your phone, with a change log and undo. Until those ship, we will not describe them as available.',
	},
	{
		question: 'Do I need Respite Plus to connect an AI?',
		answer:
			'Yes, to read your data. The account tool works on a free account so the connection can tell you what is missing, but usage, insights, limits, events and progress need Respite Plus. At the time of writing Plus is $4.99 a month, $29.99 a year with a one-week free trial, or $59.99 lifetime; the stores set prices by country.',
	},
	{
		question: 'How do I disconnect an AI from Respite?',
		answer:
			'Remove or disconnect the Respite connector in your AI app\'s connector settings, which ends its access. Deleting your Respite account also ends every connection. A Connected AI screen inside the Respite app, iPhone first, is planned but is not available yet.',
	},
];

const softwareApplication = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	'@id': 'https://respite.liveintently.app/#software',
	name: 'Respite: Screen Time Control',
	alternateName: 'Respite',
	description:
		'Respite: Screen Time Control is a free screen time app for Android, iPhone and Chrome by Intently. It puts a short pause before the apps and sites you pick, with limits, streaks and a free game layer. Respite Plus adds sync and lets you connect your own AI, such as Claude, ChatGPT or Cursor, through an MCP server.',
	url: 'https://respite.liveintently.app/',
	applicationCategory: 'HealthApplication',
	operatingSystem: 'Android, iOS, Chrome',
	author: { '@type': 'Organization', '@id': 'https://liveintently.app/#organization', name: 'Intently', url: 'https://liveintently.app' },
	offers: [
		{ '@type': 'Offer', name: 'Respite (free)', price: '0', priceCurrency: 'USD' },
		{ '@type': 'Offer', name: 'Respite Plus, monthly', price: '4.99', priceCurrency: 'USD', description: 'Sync across devices and bring your own AI. Store prices vary by country.' },
		{ '@type': 'Offer', name: 'Respite Plus, yearly', price: '29.99', priceCurrency: 'USD', description: 'One-week free trial. Store prices vary by country.' },
		{ '@type': 'Offer', name: 'Respite Plus, lifetime', price: '59.99', priceCurrency: 'USD', description: 'One-time purchase. Store prices vary by country.' },
	],
	featureList: [
		'Short pause before the apps and sites you pick',
		'Daily limits, schedules and streaks',
		'Remote MCP server with OAuth for Claude, ChatGPT and Cursor (Respite Plus, read-only)',
	],
};

const webPage = {
	'@context': 'https://schema.org',
	'@type': 'WebPage',
	'@id': PAGE_URL,
	url: PAGE_URL,
	name: title,
	description,
	inLanguage: 'en-US',
	dateModified: '2026-11-03',
	isPartOf: { '@id': 'https://respite.liveintently.app/#website' },
	about: { '@id': 'https://respite.liveintently.app/#software' },
	mainEntity: { '@id': 'https://respite.liveintently.app/#software' },
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<BreadcrumbSchema
			items={[
				{ name: 'Home', url: 'https://respite.liveintently.app/' },
				{ name: 'AI and screen time', url: PAGE_URL },
			]}
		/>
		<script type="application/ld+json" set:html={JSON.stringify(softwareApplication)} />
		<script type="application/ld+json" set:html={JSON.stringify(webPage)} />
		<FAQSchema faqs={faqs} />
	</head>
	<body>
		<Header />

		<main>
			<section class="hero">
				<div class="container">
					<p class="eyebrow">Bring your own AI</p>
					<h1>AI Screen Time App: Connect Claude or ChatGPT to Your Real Phone Data</h1>
					<p class="answer">{answer}</p>
					<div class="hero-actions">
						<Button href="/blog/connect-claude-to-screen-time/" variant="secondary" size="lg">Connect Claude</Button>
						<Button href="/blog/connect-chatgpt-to-phone-usage/" variant="secondary" size="lg">Connect ChatGPT</Button>
					</div>
					<p class="hero-note">Respite Plus. Updated November 2026.</p>
				</div>
			</section>

			<section class="section">
				<div class="container narrow">
					<h2 class="section-title">What can I ask my AI about my screen time?</h2>
					<p class="section-description">These prompts work with the tools that are live today. Your AI picks the tool; you just ask.</p>
					<div class="table-wrapper">
						<table class="data-table">
							<thead>
								<tr><th>Ask</th><th>Tool used</th></tr>
							</thead>
							<tbody>
								{prompts.map((p) => (
									<tr><td>{p.prompt}</td><td><code>{p.tool}</code></td></tr>
								))}
							</tbody>
						</table>
					</div>
					<p class="small">More in <a href="/blog/chatgpt-claude-screen-time-prompts/">30 prompts to ask Claude or ChatGPT about your screen time</a>.</p>
				</div>
			</section>

			<section class="section section-alt">
				<div class="container">
					<h2 class="section-title">How does it work?</h2>
					<p class="section-description">Respite hosts an MCP server. Your AI app is the client. You stay in control of who connects.</p>
					<ol class="steps">
						{steps.map((s) => (
							<li class="step">
								<span class="step-n">{s.n}</span>
								<h3>{s.title}</h3>
								<p>{s.body}</p>
							</li>
						))}
					</ol>
					<div class="flow" aria-label="Data flow">
						<span>You</span><span class="arrow">&rarr;</span>
						<span>Your AI app<small>Claude, ChatGPT, Cursor</small></span><span class="arrow">&rarr;</span>
						<span>OAuth sign-in<small>Google or Apple</small></span><span class="arrow">&rarr;</span>
						<span>Respite MCP server<small>read-only tools</small></span><span class="arrow">&rarr;</span>
						<span>Your synced data</span>
					</div>
					<h3 class="sub">The tools your AI can call today</h3>
					<div class="table-wrapper">
						<table class="data-table">
							<thead><tr><th>Tool</th><th>What it returns</th><th>Plan</th></tr></thead>
							<tbody>
								{tools.map((t) => (
									<tr><td><code>{t.name}</code></td><td>{t.what}</td><td>{t.plus ? 'Plus' : 'Free'}</td></tr>
								))}
							</tbody>
						</table>
					</div>
					<p class="small">
						Permissions are separate. Today the consent screen asks for read access to your usage, insights and history. Permissions to change limits, messages or rules arrive with the tools that need them.
						New to the term? Read <a href="/blog/what-is-an-mcp-server/">what an MCP server is, in plain English</a>.
					</p>
				</div>
			</section>

			<section class="section">
				<div class="container narrow">
					<h2 class="section-title">What is live and what is coming?</h2>
					<p class="section-description">We describe a tool as available only when it is.</p>
					<ul class="status-list">
						{live.map(([what, state]) => (
							<li>
								<span class={`badge ${state.startsWith('Live') ? 'badge-live' : 'badge-soon'}`}>{state}</span>
								<span>{what}</span>
							</li>
						))}
					</ul>
					<p class="small">Planned changes are described in <a href="/blog/bring-your-own-ai-to-respite/">bring your own AI to Respite</a>. The <a href="/whats-new/">What's new</a> page says when each one ships.</p>
				</div>
			</section>

			<section class="section section-alt">
				<div class="container narrow">
					<h2 class="section-title">Is it private?</h2>
					<ul class="plain">
						<li><strong>Your AI provider handles the data.</strong> What a tool returns goes into your chat, so the assistant's provider (Anthropic, OpenAI, Cursor or another) processes it under its own policy and your account settings there.</li>
						<li><strong>Respite runs no AI</strong> on your data and does not train models on it. Respite only answers the calls your connected AI makes.</li>
						<li><strong>You choose the permissions</strong> on the consent screen, and tools that need a permission you did not grant return an error instead of data.</li>
						<li><strong>You can disconnect</strong> in your AI app's connector settings. Deleting your Respite account ends every connection.</li>
						<li><strong>Only synced data.</strong> The AI sees what your devices sync to your account, not what stays on a device.</li>
					</ul>
					<p class="small">
						Read the full explanation in <a href="/blog/is-it-safe-to-give-ai-your-screen-time-data/">is it safe to give an AI your screen time data?</a>
						Policies: <a href="/privacy/">iPhone</a>, <a href="/privacy/android/">Android</a>, <a href="/privacy/chrome/">Chrome</a>.
					</p>
				</div>
			</section>

			<section class="section">
				<div class="container">
					<h2 class="section-title">How do I set it up?</h2>
					<p class="section-description">The address is the same everywhere: <code>{MCP_URL}</code></p>
					<div class="card-grid">
						<a href="/blog/connect-claude-to-screen-time/" class="card">
							<h3>Claude</h3>
							<p>Claude.ai and Claude Desktop: Settings, Connectors, Add custom connector. Claude Code: one command.</p>
							<span class="card-link">Claude setup &rarr;</span>
						</a>
						<a href="/blog/connect-chatgpt-to-phone-usage/" class="card">
							<h3>ChatGPT</h3>
							<p>Add Respite as a custom MCP connector in ChatGPT's connector settings, where your plan allows it.</p>
							<span class="card-link">ChatGPT setup &rarr;</span>
						</a>
						<a href="/blog/connect-claude-chatgpt-cursor-to-respite-mcp/" class="card">
							<h3>Cursor and others</h3>
							<p>Any assistant that supports remote MCP servers with OAuth. Includes permissions and troubleshooting.</p>
							<span class="card-link">All clients &rarr;</span>
						</a>
					</div>
				</div>
			</section>

			<section class="section section-alt">
				<div class="container">
					<h2 class="section-title">Respite vs in-app AI coaches</h2>
					<p class="section-description">Two different ideas of "AI screen time". Facts checked November 2026; see the sources in our <a href="/blog/ai-screen-time-coach-apps-compared/">coach comparison</a>.</p>
					<div class="table-wrapper">
						<table class="data-table compare-table">
							<thead>
								<tr><th></th><th class="highlight">Respite (bring your own AI)</th><th>In-app AI coach apps</th><th>LockIn MCP</th></tr>
							</thead>
							<tbody>
								{compare.map((row) => (
									<tr><th scope="row">{row[0]}</th><td class="highlight">{row[1]}</td><td>{row[2]}</td><td>{row[3]}</td></tr>
								))}
							</tbody>
						</table>
					</div>
					<p class="small">
						Coach apps are not worse: if you want an AI to talk you out of an app at the moment you tap it, that is exactly what they do and Respite does not (yet).
						LockIn MCP is a desktop website blocker; see <a href="/blog/respite-vs-lockin-mcp/">Respite vs LockIn MCP</a>. For the full picture of apps with AI features,
						read <a href="/blog/best-ai-app-blockers-screen-time-apps-2026/">best AI app blockers and screen time apps in 2026</a>.
					</p>
				</div>
			</section>

			<section class="cta-section">
				<div class="container">
					<h2>Try it with your own data</h2>
					<p>Respite is free to start on Android, iPhone and Chrome. Plus adds sync and bring your own AI.</p>
					<div class="cta-buttons">
						<Button href="/download/" variant="primary" size="lg">Download Respite</Button>
						<Button href="/blog/respite-plus-whats-included/" variant="secondary" size="lg">What Plus includes</Button>
					</div>
				</div>
			</section>

			<section class="section">
				<div class="container faq-container">
					<h2 class="section-title">Frequently asked questions</h2>
					{faqs.map((faq) => (
						<details class="faq-item">
							<summary>{faq.question}</summary>
							<p>{faq.answer}</p>
						</details>
					))}
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	main { width: 100%; }
	.container { max-width: 1100px; margin: 0 auto; padding: 0 1rem; }
	.container.narrow { max-width: 820px; }

	.hero {
		width: 100%;
		padding: var(--ds-space-3xl) 0 var(--ds-space-2xl);
		background: linear-gradient(135deg, var(--ds-primary) 0%, var(--ds-brand) 100%);
		text-align: center;
		color: var(--ds-on-brand);
	}
	.hero::before { content: ''; display: block; height: 6rem; }
	.eyebrow { text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.8125rem; font-weight: 700; margin: 0 0 var(--ds-space-sm); color: white; opacity: 0.9; }
	.hero h1 { font-size: 2.25rem; font-weight: 800; margin: 0 auto var(--ds-space-md); letter-spacing: -0.02em; line-height: 1.2; color: white; max-width: 820px; }
	.answer { font-size: 1.125rem; line-height: 1.6; margin: 0 auto var(--ds-space-lg); max-width: 720px; color: white; }
	.hero-actions { display: flex; gap: var(--ds-space-md); justify-content: center; flex-wrap: wrap; }
	.hero-note { margin: var(--ds-space-md) 0 0; font-size: 0.875rem; color: white; opacity: 0.85; }

	.section { width: 100%; padding: var(--ds-space-3xl) 0; background: var(--ds-bg-primary); }
	.section-alt { background: var(--ds-bg-secondary); }
	.section-title { font-size: 1.75rem; font-weight: 800; text-align: center; margin: 0 0 var(--ds-space-sm); color: var(--ds-text-primary); }
	.section-description { text-align: center; color: var(--ds-text-secondary); max-width: 640px; margin: 0 auto var(--ds-space-xl); line-height: 1.6; }
	.small { color: var(--ds-text-secondary); font-size: 0.9375rem; line-height: 1.6; margin: var(--ds-space-lg) 0 0; }
	.small a, .section-description a, .plain a { color: var(--ds-primary); }
	.sub { font-size: 1.25rem; margin: var(--ds-space-2xl) 0 var(--ds-space-md); color: var(--ds-text-primary); }
	code { font-size: 0.875em; background: var(--ds-gray-100); padding: 0.1rem 0.35rem; border-radius: 6px; word-break: break-word; }

	.table-wrapper { overflow-x: auto; border-radius: var(--ds-radius-lg); border: 1px solid var(--ds-gray-200); background: var(--ds-bg-primary); }
	.data-table { width: 100%; border-collapse: collapse; font-size: 0.9375rem; }
	.data-table th, .data-table td { padding: var(--ds-space-md); text-align: left; border-bottom: 1px solid var(--ds-gray-200); vertical-align: top; color: var(--ds-text-secondary); }
	.data-table thead th { background: var(--ds-bg-secondary); color: var(--ds-text-primary); font-size: 0.8125rem; text-transform: uppercase; letter-spacing: 0.5px; }
	.data-table tbody tr:last-child td, .data-table tbody tr:last-child th { border-bottom: none; }
	.compare-table { min-width: 720px; }
	.compare-table tbody th { color: var(--ds-text-primary); font-weight: 700; }
	.data-table .highlight { background: rgba(var(--ds-brand-rgb), 0.06); color: var(--ds-primary); font-weight: 600; }

	.steps { list-style: none; margin: 0 0 var(--ds-space-xl); padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--ds-space-lg); }
	.step { background: var(--ds-bg-primary); border: 1px solid var(--ds-gray-200); border-radius: var(--ds-radius-lg); padding: var(--ds-space-lg); }
	.step-n { display: inline-flex; width: 2rem; height: 2rem; align-items: center; justify-content: center; border-radius: 50%; background: var(--ds-primary); color: white; font-weight: 800; margin-bottom: var(--ds-space-sm); }
	.step h3 { margin: 0 0 var(--ds-space-xs); font-size: 1.0625rem; color: var(--ds-text-primary); }
	.step p { margin: 0; color: var(--ds-text-secondary); line-height: 1.55; font-size: 0.9375rem; word-break: break-word; }

	.flow { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: var(--ds-space-sm); margin: 0 0 var(--ds-space-md); }
	.flow > span:not(.arrow) { background: var(--ds-primary-light); color: var(--ds-primary-dark); border-radius: var(--ds-radius-md); padding: 0.5rem 0.9rem; font-weight: 700; font-size: 0.9375rem; display: inline-flex; flex-direction: column; text-align: center; }
	.flow small { font-weight: 500; font-size: 0.75rem; opacity: 0.85; }
	.arrow { color: var(--ds-primary); font-weight: 800; }

	.status-list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--ds-space-sm); }
	.status-list li { display: flex; gap: var(--ds-space-md); align-items: flex-start; padding: var(--ds-space-md); background: var(--ds-bg-primary); border: 1px solid var(--ds-gray-200); border-radius: var(--ds-radius-md); color: var(--ds-text-secondary); line-height: 1.5; }
