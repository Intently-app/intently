---
/**
 * /download/: get the right Respite onto the right device, fast.
 *
 * The three platforms are always listed; a small script puts the one for this device first and
 * labels it. On a computer the phone cards show a QR code (public/qr/, static SVGs whose links
 * carry the same campaign tags as the site's store links, utm_content download__qr). Each card
 * says what it needs, how setup goes and which permissions it asks for, from the privacy policies.
 */
import '../styles/info-pages.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Biscuit from '../components/ui/Biscuit.astro';
import StoreButton from '../components/ui/StoreButton.astro';
import PlanCompare from '../components/ui/PlanCompare.astro';
import ProductSchema from '../components/SEO/ProductSchema.astro';
import BreadcrumbSchema from '../components/SEO/BreadcrumbSchema.astro';
import FAQSchema from '../components/SEO/FAQSchema.astro';

const PLAY = 'https://play.google.com/store/apps/details?id=dev.sadakat.thinkfaster';
const APP_STORE = 'https://apps.apple.com/us/app/respite-screen-time-control/id6757760293';
const CWS = 'https://chromewebstore.google.com/detail/intently-intentful-browsi/acjndeeecacgplloeefjjhlnlpgnonop';

const platforms = [
	{
		id: 'ios',
		name: 'iPhone and iPad',
		store: 'appstore' as const,
		href: APP_STORE,
		qr: '/qr/app-store.svg',
		needs: 'iOS 17.4 or later',
		setup: ['Install Respite from the App Store.', 'Allow Screen Time access when Respite asks.', "Pick the apps in Apple's own picker and set a daily limit if you want one."],
		asks: ["Screen Time access, so Apple can show the pause. Apple doesn't tell Respite which apps you picked or what you do in them."],
		features: ['A pause when you open an app you picked', 'Three ways to pause: every time, Smart timing, or a time budget', "Daily limits and an app lock once today's time is used", 'Schedules, focus sessions, acorns, quests and leagues'],
		privacy: '/privacy/',
		terms: '/terms/',
	},
	{
		id: 'android',
		name: 'Android',
		store: 'playstore' as const,
		href: PLAY,
		qr: '/qr/google-play.svg',
		needs: 'Android 8.0 or later',
		setup: ['Install Respite from Google Play.', 'Allow Usage access and Display over other apps when Respite asks.', 'Pick the apps you want a pause before.'],
		asks: ['Usage access, to see which app is in front and for how long.', 'Display over other apps, to show the pause.', 'Accessibility, only if you turn on Reels and Shorts blocking.'],
		features: ['A pause before the apps you choose', 'Usage analytics and daily limits', 'Optional Reels and Shorts blocking', 'Streaks, home screen widgets, acorns, quests and leagues'],
		privacy: '/privacy/android/',
		terms: '/terms/android/',
	},
	{
		id: 'chrome',
		name: 'Chrome',
		store: 'chromestore' as const,
		href: CWS,
		qr: '',
		needs: 'Chrome or another Chromium browser on a computer',
		setup: ['Add Respite from the Chrome Web Store.', 'Allow access to websites when Chrome asks.', 'Add the sites you want a pause before.'],
		asks: ['Access to websites, to show the pause on the sites you choose. It never reads page content, forms or passwords.'],
		features: ['The same pause for websites', 'Website time tracking and usage insights', 'Daily limits that can lock a site for the day', 'Focus mode and quick settings'],
		privacy: '/privacy/chrome/',
		terms: '',
	},
];

const faqs = [
	{ question: 'Is Respite free to download?', answer: 'Yes. Respite is free on iPhone, Android and Chrome, with no ads and no credit card needed. An optional upgrade, Respite Plus, adds sync across your devices and extras such as more schedules, longer focus sessions and richer insights. The core pause, tracking, limits and streaks work without it.' },
	{ question: 'Does Respite need an account?', answer: 'No. You can install Respite and use its core features without signing in. An account (Google or Apple sign-in) is only needed if you want sync across devices with Respite Plus. Without one, your usage history stays on your device.' },
	{ question: 'Does Respite work on iPhone?', answer: "Yes. Download Respite from the App Store for iPhone. It is built on Apple's Screen Time, so the pause appears as Apple's Screen Time shield before the apps you pick, with daily limits and an app lock that refreshes at midnight. By default, app names stay on your iPhone." },
	{ question: 'Which devices can I install Respite on?', answer: 'Respite runs on iPhone, Android phones and Google Chrome. The Chrome extension also works in other Chromium browsers. Each version is its own app with its own settings and history; optional Respite Plus sync can bring your progress together across devices.' },
	{ question: 'Does Respite collect my data?', answer: "Your usage history stays on your device unless you turn on sync. Respite shows no ads and never sells your data. Each version's privacy policy lists exactly what it collects, including any anonymous analytics or crash reports. On iPhone, Apple's Screen Time keeps the apps you pick private." },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Download Respite Free for iPhone, Android and Chrome" description="Get Respite free on iPhone, Android and Chrome. No ads, no account needed. See what each version needs, how setup goes and what Plus adds." />
		<ProductSchema
			name="Respite Android"
			description="Free privacy-first digital wellbeing app that creates a mindful pause before distracting apps open. Usage tracking, a pause before the apps you pick, streaks and daily limits. Free, no ads, account optional."
			platform="android"
			downloadUrl={PLAY}
		/>
		<ProductSchema
			name="Respite for iPhone"
			description="Respite for iPhone is a privacy-first screen time app built on Apple's Screen Time API. A gentle pause before distracting apps, daily limits, an app lock that refreshes at midnight, and no ads. By default app names stay on your iPhone; if you match an app for cross-device sync, its name is saved to your account."
			platform="ios"
			downloadUrl={APP_STORE}
		/>
		<ProductSchema
			name="Respite for Chrome"
			description="Free Chrome extension for mindful browsing. Track website usage, focus mode and usage insights. Free, no ads, account optional."
			platform="chrome"
			downloadUrl={CWS}
		/>
		<BreadcrumbSchema
			items={[
				{ name: 'Home', url: 'https://respite.liveintently.app' },
				{ name: 'Download', url: 'https://respite.liveintently.app/download/' },
			]}
		/>
		<FAQSchema faqs={faqs} />
	</head>
	<body class="ip-page">
		<Header />

		<main class="ip">
			<header class="ip-head dl-head">
				<Biscuit mood="hop_in" size={96} loop={false} label="Biscuit hopping in" class="dl-biscuit" />
				<h1>Get Respite</h1>
				<p class="ip-dek">A short, gentle pause before the apps and sites you pick, so you open them on purpose. Setup takes about a minute.</p>
				<ul class="ip-facts" aria-label="At a glance">
					<li>Free</li>
					<li>No ads</li>
					<li>No account needed</li>
					<li>History stays on your device</li>
				</ul>
			</header>

			<section class="ip-section" aria-labelledby="pick-title">
				<h2 id="pick-title" class="ip-visually-hidden">Choose your device</h2>
				<p class="dl-device" id="dl-device" hidden></p>
				<div class="dl-grid" id="dl-grid" data-placement="download_cards">
					{platforms.map((p) => (
						<article class="dl-card" data-platform={p.id} aria-labelledby={`dl-${p.id}`}>
							<div class="dl-card-head">
								<h3 id={`dl-${p.id}`}>{p.name}</h3>
								<span class="dl-for-you" hidden>For this device</span>
							</div>
							<p class="dl-needs">{p.needs}</p>
							<div class="dl-get">
								<StoreButton store={p.store} href={p.href} />
								{p.qr && (
									<figure class="dl-qr" hidden>
										<img src={p.qr} alt={`QR code that opens Respite on ${p.id === 'ios' ? 'the App Store' : 'Google Play'}`} width="112" height="112" loading="lazy" />
										<figcaption>Scan with your phone's camera</figcaption>
									</figure>
								)}
							</div>

							<details class="dl-more">
								<summary>Setup, permissions and features</summary>
								<div class="dl-more-body">
									<h4>Setup</h4>
									<ol class="dl-steps">{p.setup.map((s) => <li>{s}</li>)}</ol>
									<h4>What it asks for</h4>
									<ul>{p.asks.map((s) => <li>{s}</li>)}</ul>
									<h4>What it does</h4>
									<ul>{p.features.map((s) => <li>{s}</li>)}</ul>
								</div>
							</details>
							<p class="dl-legal">
								<a href={p.privacy}>Privacy policy</a>
								{p.terms && <a href={p.terms}>Terms</a>}
							</p>
						</article>
					))}
				</div>
				<p class="ip-note">Using more than one? Each device works on its own. To bring them together, sign in with the same Google or Apple account on each: <a href="/blog/sync-respite-android-iphone-chrome/">how to sync Respite</a>.</p>
			</section>

			<section class="ip-section" id="plans" aria-labelledby="plans-title">
				<h2 id="plans-title">Free or Plus?</h2>
				<p class="ip-lead">Respite is free, and the free version is complete: the pause, limits, tracking and the game. Plus is for people who use several devices or want more.</p>
				<PlanCompare />
			</section>

			<section class="ip-section ip-faq" aria-labelledby="faq-title">
				<h2 id="faq-title">Questions before you install</h2>
				{faqs.map((faq) => (
					<details>
						<summary>{faq.question}</summary>
						<p>{faq.answer}</p>
					</details>
				))}
			</section>

			<section class="ip-end" aria-labelledby="end-title">
				<h2 id="end-title">Not sure it's for you?</h2>
				<p>See <a href="/features/">everything Respite does on each device</a>, take the <a href="/quiz/">2-minute phone habit quiz</a>, or read <a href="/about/">who makes Respite</a>.</p>
			</section>
		</main>

		<Footer />

		<script>
			// Put this device's version first. iPadOS reports itself as a Mac, so touch support decides.
			const ua = navigator.userAgent;
			const isIOS = /iPhone|iPad|iPod/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
			const isAndroid = /Android/.test(ua);
			const brands = (navigator as Navigator & { userAgentData?: { brands: { brand: string }[] } }).userAgentData?.brands ?? [];
			const isChromium = brands.some((b) => /Chromium|Google Chrome/.test(b.brand)) || /Chrome\/|Edg\/|OPR\//.test(ua);
			const grid = document.getElementById('dl-grid');
			const note = document.getElementById('dl-device');
			const card = (id: string) => grid?.querySelector<HTMLElement>(`[data-platform="${id}"]`);

			let mine: string | null = null;
			let message = '';
			if (isIOS) {
				mine = 'ios';
				message = 'You are on an iPhone or iPad, so the App Store version is first.';
			} else if (isAndroid) {
				mine = 'android';
				message = 'You are on Android, so the Google Play version is first.';
			} else {
				// A computer: the extension if this browser can run it, and QR codes for the phone apps.
				mine = isChromium ? 'chrome' : null;
				message = isChromium
					? 'You are on a computer: add the extension to this browser, and scan a code to put Respite on your phone.'
					: 'You are on a computer. The extension needs Chrome or another Chromium browser; scan a code to put Respite on your phone.';
				grid?.querySelectorAll<HTMLElement>('.dl-qr').forEach((q) => (q.hidden = false));
			}
			if (mine && grid) {
				const c = card(mine)!;
				grid.prepend(c);
				c.classList.add('is-mine');
				c.querySelector<HTMLElement>('.dl-for-you')!.hidden = false;
			}
			if (note) {
				note.textContent = message;
				note.hidden = false;
			}
		</script>
	</body>
</html>

<style>
	.dl-head {
		position: relative;
	}

	.dl-head :global(.dl-biscuit) {
		margin-bottom: -0.5rem;
	}

	.dl-device {
		margin: 0 0 1rem;
		color: var(--ds-text-secondary);
	}

	.dl-grid {
		display: grid;
		gap: 1rem;
	}

	@media (min-width: 860px) {
		.dl-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			align-items: start;
		}
	}

	.dl-card {
		display: grid;
		gap: 0.75rem;
		padding: 1.25rem;
		border: 1px solid var(--ip-rule);
		border-radius: var(--ds-radius-lg);
		background: var(--ds-bg-primary);
	}

	.dl-card.is-mine {
		border-color: color-mix(in srgb, var(--ds-brand) 70%, transparent);
		box-shadow: 0 0 0 1px color-mix(in srgb, var(--ds-brand) 50%, transparent);
		background: color-mix(in srgb, var(--ds-bg-info) 45%, var(--ds-bg-primary));
	}

	.dl-card-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
	}

	.dl-card h3 {
		margin: 0;
		font-size: 1.25rem;
	}

	.dl-for-you {
		padding: 0.15rem 0.6rem;
		border-radius: var(--ds-radius-full);
		background: var(--ds-primary);
		color: var(--ds-on-primary);
		font-size: 0.75rem;
		font-weight: 800;
		white-space: nowrap;
	}

	.dl-needs {
		margin: -0.4rem 0 0;
		font-size: 0.875rem;
		color: var(--ds-text-hint);
	}

	.dl-get {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem;
	}

	.dl-qr {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin: 0;
	}

	.dl-qr img {
		display: block;
		width: 112px;
		height: 112px;
		padding: 6px;
		border-radius: var(--ds-radius-sm);
		background: #fff;
	}

	.dl-qr figcaption {
		max-width: 8rem;
		font-size: 0.82rem;
		line-height: 1.4;
		color: var(--ds-text-secondary);
	}

	@media (min-width: 860px) {
		.dl-qr {
			flex-direction: column;
			align-items: flex-start;
		}
	}

	.dl-more summary {
		font-size: 0.95rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: 44px;
		cursor: pointer;
		list-style: none;
		font-weight: 700;
		color: var(--ds-primary);
		border-top: 1px solid var(--ip-rule);
	}

	.dl-more summary::-webkit-details-marker {
		display: none;
	}

	.dl-more summary::after {
		content: '';
		width: 0.5rem;
		height: 0.5rem;
		margin-right: 0.3rem;
		border-right: 2px solid currentColor;
		border-bottom: 2px solid currentColor;
		transform: rotate(45deg) translateY(-25%);
		transition: transform var(--ds-transition-fast);
	}

	.dl-more[open] summary::after {
		transform: rotate(-135deg);
	}

	.dl-more-body h4 {
		margin: 0.75rem 0 0.35rem;
		font-size: 0.9rem;
		font-weight: 800;
	}

	.dl-more-body ul,
	.dl-more-body ol {
		margin: 0;
		padding-left: 1.2rem;
		display: grid;
		gap: 0.3rem;
		font-size: 0.9rem;
		line-height: 1.45;
		color: var(--ds-text-secondary);
	}

	.dl-legal {
		display: flex;
		gap: 1rem;
		margin: 0;
		font-size: 0.85rem;
	}

	.dl-legal a {
		color: var(--ds-text-secondary);
	}
</style>
