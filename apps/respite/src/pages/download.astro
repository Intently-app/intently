---
/**
 * /download/: get the right Respite onto the right device, fast. Mist styles (src/styles/info-pages.css).
 *
 * Centred and symmetric: on a computer, two equal cards first (Add to Chrome, in Chrome or Edge, and
 * one QR code for the phone); then three equal cards (store button), this device's card marked; one
 * three-step setup strip; Free or Plus; questions. The QR code opens /get?c=download, which sends an
 * Android phone to Google Play and an iPhone to the App Store with the QR campaign tags (pages/get.ts).
 * Requirements and permissions come from the privacy policies.
 */
import '../styles/info-pages.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Biscuit from '../components/ui/Biscuit.astro';
import Icon from '../components/ui/Icon.astro';
import StoreButton from '../components/ui/StoreButton.astro';
import AppIcon from '../components/ui/AppIcon.astro';
import QrCode from '../components/ui/QrCode.astro';
import { app } from '@intently/registry';
import PlanCompare from '../components/ui/PlanCompare.astro';
import ProductSchema from '../components/SEO/ProductSchema.astro';
import BreadcrumbSchema from '../components/SEO/BreadcrumbSchema.astro';
import FAQSchema from '../components/SEO/FAQSchema.astro';

const { stores } = app('respite');
const PLAY = stores.play!;
const APP_STORE = stores.appStore!;
const CWS = stores.chrome!;

const platforms = [
	{ id: 'ios', name: 'iPhone', icon: 'Smartphone', needs: 'iOS 17.4 or later', store: 'appstore' as const, href: APP_STORE, privacy: '/privacy/' },
	{ id: 'android', name: 'Android', icon: 'Smartphone', needs: 'Android 8.0 or later', store: 'playstore' as const, href: PLAY, privacy: '/privacy/android/' },
	{ id: 'chrome', name: 'Chrome', icon: 'Monitor', needs: 'Chrome or another Chromium browser', store: 'chromestore' as const, href: CWS, privacy: '/privacy/chrome/' },
];

const steps = [
	{ icon: 'Download', title: 'Install', text: 'From your store, free' },
	{ icon: 'KeyRound', title: 'Allow access', text: 'Screen Time on iPhone, Usage access on Android, websites in Chrome' },
	{ icon: 'Hourglass', title: 'Pick your apps', text: 'They get a gentle pause' },
];

const faqs = [
	{ question: 'Is Respite free to download?', answer: 'Yes. Respite is free on iPhone, Android and Chrome, with no ads and no credit card needed. An optional upgrade, Respite Plus, adds sync across your devices and extras such as more schedules, longer focus sessions and richer insights. The core pause, tracking, limits and streaks work without it.' },
	{ question: 'Does Respite need an account?', answer: 'No. You can install Respite and use its core features without signing in. An account (Google or Apple sign-in) is only needed if you want sync across devices with Respite Plus. Without one, your usage history stays on your device.' },
	{ question: 'Does Respite work on iPhone?', answer: "Yes. Download Respite from the App Store for iPhone. It is built on Apple's Screen Time, so the pause appears as Apple's Screen Time shield before the apps you pick, with daily limits and an app lock that refreshes at midnight. By default, app names stay on your iPhone." },
	{ question: 'Which devices can I install Respite on?', answer: 'Respite runs on iPhone, Android phones and Google Chrome. The Chrome extension also works in other Chromium browsers. Each version is its own app with its own settings and history; optional Respite Plus sync can bring your progress together across devices.' },
	{ question: 'What permissions does Respite ask for?', answer: "On iPhone, Screen Time access: Apple shows the pause and doesn't tell Respite which apps you picked. On Android, Usage access and Display over other apps, plus Accessibility only if you turn on Reels and Shorts blocking. In Chrome, access to websites, to show the pause on the sites you choose; it never reads pages, forms or passwords." },
	{ question: 'Does Respite collect my data?', answer: "Your usage history stays on your device unless you turn on sync. Respite shows no ads and never sells your data. Each version's privacy policy lists exactly what it collects, including any anonymous analytics or crash reports. On iPhone, Apple's Screen Time keeps the apps you pick private." },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Download Respite Free for iPhone, Android and Chrome" description="Get Respite free on iPhone, Android and Chrome. No ads, no account needed. See what each version needs, how setup goes and what Plus adds." />
		<ProductSchema
			name="Respite Android"
			description="Free privacy-first digital wellbeing app that creates a mindful pause before distracting apps open. Usage tracking, a pause before the apps you pick, streaks and daily limits. Free, no ads, account optional."
			platform="android"
			downloadUrl={PLAY}
		/>
		<ProductSchema
			name="Respite for iPhone"
			description="Respite for iPhone is a privacy-first screen time app built on Apple's Screen Time API. A gentle pause before distracting apps, daily limits, an app lock that refreshes at midnight, and no ads. By default app names stay on your iPhone; if you match an app for cross-device sync, its name is saved to your account."
			platform="ios"
			downloadUrl={APP_STORE}
		/>
		<ProductSchema
			name="Respite for Chrome"
			description="Free Chrome extension for mindful browsing. Track website usage, focus mode and usage insights. Free, no ads, account optional."
			platform="chrome"
			downloadUrl={CWS}
		/>
		<BreadcrumbSchema
			items={[
				{ name: 'Home', url: 'https://respite.liveintently.app' },
				{ name: 'Download', url: 'https://respite.liveintently.app/download/' },
			]}
		/>
		<FAQSchema faqs={faqs} />
	</head>
	<body class="m-page">
		<Header />

		<main class="m">
			<section class="dl-hero" aria-labelledby="dl-title">
				<div class="dl-biscuit" aria-hidden="true"><Biscuit mood="hop_in" size={130} loop={false} label="Biscuit hopping in" /></div>
				<h1 id="dl-title">Get Respite</h1>
				<p class="m-dek">Free on iPhone, Android and Chrome.</p>
				<ul class="m-pills dl-pills" aria-label="At a glance">
					{['No ads', 'No account needed', 'History stays on your device'].map((t) => (
						<li><span aria-hidden="true"><Icon name="Check" size={18} /></span>{t}</li>
					))}
				</ul>
			</section>

			<section class="dl-desk" aria-label="On a computer" data-placement="download_hero" hidden>
				<div class="dl-desk-card" data-desk="chrome" hidden>
					<span class="dl-desk-art"><AppIcon app="googlechrome" size={88} /></span>
					<p class="dl-desk-title">Add it to this browser</p>
					<a class="m-btn" href={CWS}>Add to Chrome — free</a>
				</div>
				<div class="dl-desk-card" data-desk="phone">
					<span class="dl-desk-art"><QrCode text="https://respite.liveintently.app/get?c=download" size={132} label="QR code to get Respite on your phone" /></span>
					<p class="dl-desk-title">Scan to get it on your phone</p>
					<span class="m-badge is-accent dl-desk-badge">Android or iPhone</span>
				</div>
			</section>

			<section aria-labelledby="pick-title" class="dl-pick">
				<h2 id="pick-title" class="m-sr">Choose your device</h2>
				<div class="dl-cards" data-placement="download_cards">
					{platforms.map((p) => (
						<article class="dl-card" data-platform={p.id} aria-labelledby={`dl-${p.id}`}>
							<span class="dl-mine m-badge is-accent" hidden>For this device</span>
							<span class="dl-icon" aria-hidden="true"><Icon name={p.icon} size={30} /></span>
							<h3 id={`dl-${p.id}`}>{p.name}</h3>
							<p class="dl-needs">{p.needs}</p>
							<div class="dl-store"><StoreButton store={p.store} href={p.href} /></div>
							<a class="dl-policy" href={p.privacy}>Privacy policy</a>
						</article>
					))}
				</div>
			</section>

			<section class="m-section" aria-labelledby="setup-title">
				<h2 id="setup-title" class="m-h2 dl-center">Set up in about a minute</h2>
				<ol class="dl-steps">
					{steps.map((s, i) => (
						<li>
							<span class="dl-step-icon" aria-hidden="true"><Icon name={s.icon} size={26} /><span class="dl-step-n">{i + 1}</span></span>
							<p class="dl-step-title">{s.title}</p>
							<p class="m-caption">{s.text}</p>
						</li>
					))}
				</ol>
				<p class="m-caption dl-center">Using more than one device? Sign in with the same account on each. <a href="/blog/sync-respite-android-iphone-chrome/">How to sync</a></p>
			</section>

			<section class="m-section" id="plans" aria-labelledby="plans-title">
				<h2 id="plans-title" class="m-h2 dl-center">Free, or Plus</h2>
				<PlanCompare />
			</section>

			<section class="m-section" aria-labelledby="faq-title">
				<h2 id="faq-title" class="m-h2 dl-center">Questions</h2>
				<div class="m-group m-faq dl-faq">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.question}</summary>
							<p>{faq.answer}</p>
						</details>
					))}
				</div>
			</section>
		</main>

		<Footer />

		<script>
			// Mark this device's card. On a computer, show the QR code for the phone, and Add to Chrome in
			// Chrome or Edge. The device rule is shared with the install buttons (lib/install-target.ts).
			import { myDevice } from '../lib/smart-install';
			const mine = myDevice();
			const card = mine && document.querySelector<HTMLElement>(`.dl-card[data-platform="${mine}"]`);
			if (card) {
				card.classList.add('is-mine');
				card.querySelector<HTMLElement>('.dl-mine')!.hidden = false;
			}
			const desk = document.querySelector<HTMLElement>('.dl-desk');
			if (desk && mine !== 'ios' && mine !== 'android') {
				desk.hidden = false;
				desk.querySelector<HTMLElement>('[data-desk="chrome"]')!.hidden = mine !== 'chrome';
			}
		</script>
	</body>
</html>

<style>
	.dl-center {
		text-align: center;
		justify-self: center;
	}

	/* Hero: centred */
	.dl-hero {
		display: grid;
		justify-items: center;
		gap: 0.75rem;
		text-align: center;
	}

	.dl-biscuit {
		display: grid;
		place-items: center;
		width: 160px;
		height: 160px;
		border-radius: 50%;
		background: var(--m-accent-soft);
	}

	.dl-hero h1 {
		margin: 0.5rem 0 0;
		font-size: clamp(2.4rem, 1.7rem + 3vw, 3.8rem);
		font-weight: 800;
		line-height: 1.05;
		letter-spacing: -0.02em;
	}

	.dl-pills {
		justify-content: center;
		margin-top: 0.75rem;
	}

	/* Three equal cards */
	.dl-pick {
		margin-top: -1.5rem;
	}

	.dl-cards {
		display: grid;
		gap: 1.25rem;
	}

	@media (min-width: 860px) {
		.dl-cards {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	.dl-card {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.6rem;
		padding: 2rem 1.5rem 1.5rem;
		border-radius: 28px;
		background: var(--m-paper);
		box-shadow: var(--m-shadow-sm);
		text-align: center;
	}

	.dl-card.is-mine {
		box-shadow: var(--m-shadow-md), 0 0 0 3px var(--m-accent);
	}

	/* On a phone the cards stack, so this device's comes first. Side by side they keep a fixed order. */
	@media (max-width: 859px) {
		.dl-card.is-mine {
			order: -1;
		}
	}

	.dl-mine {
		position: absolute;
		top: 1rem;
		right: 1rem;
	}

	.dl-icon {
		display: grid;
		place-items: center;
		width: 64px;
		height: 64px;
		border-radius: 20px;
		background: var(--m-accent-soft);
		color: var(--m-accent-ink);
	}

	.dl-card h3 {
		margin: 0.4rem 0 0;
		font-size: 1.6rem;
		font-weight: 800;
	}

	.dl-needs {
		margin: 0;
		min-height: 1.5em;
		font-size: 0.95rem;
		color: var(--m-ink-soft);
	}

	.dl-store {
		margin-top: 0.5rem;
	}

	/* On a computer: Add to Chrome and the QR code to the phone, two equal cards */
	.dl-desk {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(0, 19.5rem));
		justify-content: center;
		gap: 1.25rem;
		margin-top: -2.5rem;
	}

	/* Same rows in both cards: the picture, the line, the action. */
	.dl-desk-card {
		display: grid;
		grid-template-rows: 132px auto 52px;
		justify-items: center;
		align-items: center;
		gap: 0.75rem;
		padding: 1.75rem 1.5rem 1.75rem;
		border-radius: 28px;
		background: var(--m-paper);
		box-shadow: var(--m-shadow-sm);
		text-align: center;
	}

	.dl-desk-art {
		display: grid;
		place-items: center;
		width: 132px;
		height: 132px;
	}

	.dl-desk-art :global(.m-appicon) {
		border-radius: 26px;
		box-shadow: var(--m-shadow-sm);
	}

	.dl-desk-title {
		margin: 0.25rem 0 0;
		font-family: var(--font-heading);
		font-size: 1.1rem;
		font-weight: 800;
	}

	.dl-desk-card .m-btn {
		white-space: nowrap;
	}

	.dl-desk-badge {
		padding: 0.45rem 1rem;
		font-size: 0.9rem;
	}

	.dl-policy {
		margin-top: auto;
		padding-top: 0.75rem;
		font-size: 0.9rem;
		font-weight: 700;
		color: var(--m-ink-soft);
	}

	/* Setup strip */
	.dl-steps {
		display: grid;
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	@media (min-width: 760px) {
		.dl-steps {
			grid-template-columns: repeat(3, 1fr);
			gap: 1.25rem;
		}
	}

	.dl-steps li {
		display: grid;
		justify-items: center;
		align-content: start;
		gap: 0.4rem;
		padding: 1.75rem 1.25rem;
		border-radius: 24px;
		background: var(--m-paper);
		box-shadow: var(--m-shadow-sm);
		text-align: center;
	}

	.dl-step-icon {
		position: relative;
		display: grid;
		place-items: center;
		width: 64px;
		height: 64px;
		margin-bottom: 0.4rem;
		border-radius: 50%;
		background: var(--m-accent-soft);
		color: var(--m-accent-ink);
	}

	.dl-step-n {
		position: absolute;
		top: -4px;
		right: -4px;
		display: grid;
		place-items: center;
		width: 26px;
		height: 26px;
		border-radius: 50%;
		background: var(--m-accent-strong);
		color: var(--m-on-accent);
		font-family: var(--font-heading);
		font-size: 0.85rem;
		font-weight: 800;
	}

	.dl-step-title {
		margin: 0;
		font-family: var(--font-heading);
		font-size: 1.2rem;
		font-weight: 800;
	}

	.dl-steps .m-caption {
		max-width: 16rem;
	}

	.dl-faq {
		width: 100%;
		max-width: 50rem;
		justify-self: center;
	}

	#plans :global(.pc) {
		max-width: 56rem;
		width: 100%;
		justify-self: center;
	}

	#plans :global(.pc-note) {
		text-align: center;
	}
</style>
