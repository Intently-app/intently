{
	"name": "@intently/respite-site",
	"description": "Respite website: respite.liveintently.app",
	"type": "module",
	"private": true,
	"scripts": {
		"astro": "astro",
		"build": "astro build && node scripts/check-links.mjs",
		"cf-typegen": "wrangler types",
		"check": "astro build && tsc --noEmit && wrangler deploy --dry-run",
		"deploy": "wrangler deploy",
		"dev": "astro dev",
		"preview": "astro build && wrangler dev",
		"optimize-images": "node scripts/optimize-images.mjs",
		"render-app-screens": "node scripts/render-app-screens.mjs",
		"check-links": "node scripts/check-links.mjs",
		"test": "node --test 'scripts/**/*.test.mjs'"
	},
	"dependencies": {
		"@astrojs/cloudflare": "12.6.12",
		"@astrojs/mdx": "4.3.12",
		"@astrojs/rss": "4.0.14",
		"@astrojs/sitemap": "3.7.4",
		"@fontsource-variable/nunito": "^5.3.0",
		"@intently/legal": "*",
		"@intently/registry": "*",
		"@lottiefiles/dotlottie-wc": "^0.8.14",
		"astro": "^7.3.8",
		"lucide-static": "^0.563.0",
		"markdown-it": "^14.1.1",
		"sanitize-html": "^2.17.1",
		"three": "0.180.0",
		"typescript": "5.9.3"
	},
	"devDependencies": {
		"@types/three": "^0.180.0",
		"jsqr": "^1.4.0",
		"qrcode": "^1.5.4",
		"wrangler": "^4.149.0",
		"yaml": "^2.9.1"
	}
}
