{
	"name": "@intently/hub-site",
	"description": "Intently studio hub: liveintently.app",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "astro dev",
		"prebuild": "node scripts/render-og.ts",
		"build": "astro build",
		"check": "astro check && npm run build && tsc --noEmit && npm test && node ../../tools/check-three.mjs && tsc --noEmit -p ../../packages/world && wrangler deploy --dry-run",
		"deploy": "wrangler deploy",
		"cf-typegen": "wrangler types",
		"test": "node --test 'src/**/*.test.ts' '../../packages/world/src/**/*.test.ts'",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@astrojs/cloudflare": "12.6.12",
		"@astrojs/sitemap": "3.7.4",
		"@fontsource-variable/fraunces": "^5.3.0",
		"@fontsource-variable/inter": "^5.2.5",
		"@fontsource/amiri-quran": "^5.3.0",
		"@intently/legal": "*",
		"@intently/registry": "*",
		"@intently/ui": "*",
		"@intently/world": "*",
		"astro": "^7.3.8",
		"gsap": "^3.15.0",
		"lenis": "^1.3.26",
		"lottie-web": "^5.13.0",
		"typescript": "5.9.3"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@axe-core/playwright": "^4.13.0",
		"@playwright/test": "^1.63.0",
		"sharp": "0.34.5",
		"wrangler": "^4.149.0"
	}
}
